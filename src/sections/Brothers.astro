---
// Sección para mostrar hermanos registrados
import "../styles/tables.css";
---

<section class="brothers-section max-w-7xl mx-auto px-4 py-6">
  <div class="section-header mb-6">
    <h2 class="text-2xl font-bold text-neutral-800">Hermanos Registrados</h2>
    <p class="text-sm text-neutral-600 mt-1">
      Lista de hermanos registrados en las comunidades
    </p>
  </div>

  <div id="brothers-container" class="brothers-table">
    <!-- Los hermanos se cargarán aquí dinámicamente -->
    <table class="render-brothers-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Parroquia</th>
          <th>Comunidad</th>
          <th>Teléfono</th>
          <th>Servicio</th>
          <th>Estado Civil</th>
        </tr>
      </thead>
      <tbody>
        <!-- Aqui se renderizara toda la informacion -->
      </tbody>
    </table>
  </div>

  <div id="brothers-loading" class="loading-state text-center py-8">
    <div class="loading-spinner"></div>
    <p class="text-neutral-600 mt-3">Cargando hermanos...</p>
  </div>

  <div id="brothers-empty" class="empty-state text-center py-12 hidden">
    <div class="text-6xl mb-4">👥</div>
    <h3 class="text-xl font-semibold text-neutral-700 mb-2">
      No hay hermanos registrados
    </h3>
    <p class="text-neutral-600">
      Usa el botón "Agregar Hermano" para comenzar a registrar hermanos
    </p>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const container = document.getElementById("brothers-container");
    const loading = document.getElementById("brothers-loading");
    const empty = document.getElementById("brothers-empty");

    async function loadBrothers() {
      try {
        loading?.classList.remove("hidden");
        empty?.classList.add("hidden");

        const response = await fetch("/api/all-brothers");
        const result = await response.json();

        loading?.classList.add("hidden");

        if (result.success && result.data && result.data.length > 0) {
          renderBrothers(result.data);
        } else {
          empty?.classList.remove("hidden");
        }
      } catch (error) {
        console.error("Error cargando hermanos:", error);
        loading?.classList.add("hidden");
        empty?.classList.remove("hidden");
      }
    }

    function renderBrothers(brothers: any[]) {
      const tbody = container?.querySelector("tbody");
      if (!tbody) return;

      const tableRows = brothers
        .map(
          (brother) => `
        <tr class="table-row">
          <td class="table-cell">
            <div class="cell-main">${brother.names}</div>
          </td>
          <td class="table-cell">
            <div class="cell-value">${brother.parish?.aka || "N/A"}</div>
          </td>
          <td class="table-cell">
            <div class="cell-value">${brother.community?.number || "N/A"}</div>
          </td>
          <td class="table-cell">
            <div class="cell-value">${brother.phone || '<span class="empty-cell">Sin teléfono</span>'}</div>
          </td>
          <td class="table-cell">
            ${
              brother.roles_in_own_community?.length > 0 ||
              brother.catechist_of_communities?.length > 0
                ? `
            <div class="roles-container">
              ${
                brother.roles_in_own_community?.length > 0
                  ? brother.roles_in_own_community
                      .map(
                        (role: string) =>
                          `<span class="role-tag">${formatRole(role)}</span>`,
                      )
                      .join("")
                  : ""
              }
              ${
                brother.catechist_of_communities?.length > 0
                  ? `<span class="role-tag catequista">Catequista (${brother.catechist_of_communities.length})</span>`
                  : ""
              }
            </div>
            `
                : '<span class="empty-cell">-</span>'
            }
          </td>
          <td class="table-cell">
            <div class="cell-value">${formatCivilStatus(brother.civil_status)}</div>
          </td>
        </tr>
      `,
        )
        .join("");

      tbody.innerHTML = tableRows;
    }

    function formatCivilStatus(status: string): string {
      switch (status) {
        case "matrimonio":
          return "Matrimonio";
        case "soltero":
          return "Soltero";
        case "soltera":
          return "Soltera";
        default:
          return status;
      }
    }

    function formatRole(role: string): string {
      const roles: Record<string, string> = {
        responsable: "Responsable",
        corresponsable: "Corresponsable",
        didascala: "Didascala",
        ostiario: "Ostiario",
      };
      return roles[role] || role;
    }

    // Cargar hermanos al inicio
    loadBrothers();

    // Hacer disponible globalmente para recargar
    (window as any).refreshBrothers = loadBrothers;
  });
</script>
