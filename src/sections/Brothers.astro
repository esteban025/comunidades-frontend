---
// Sección para mostrar hermanos registrados
import "../styles/tables.css";

// Fetch en el servidor
let brothers: any[] = [];
let hasError = false;

try {
  const response = await fetch("http://localhost:4321/api/all-brothers");
  const result = await response.json();

  if (result.success && result.data) {
    brothers = result.data;
  }
} catch (error) {
  console.error("Error cargando hermanos:", error);
  hasError = true;
}

function formatCivilStatus(status: string): string {
  const statuses: Record<string, string> = {
    matrimonio: "Matrimonio",
    soltero: "Soltero",
    soltera: "Soltera",
  };
  return statuses[status] || status;
}

function formatRole(role: string): string {
  const roles: Record<string, string> = {
    responsable: "Responsable",
    corresponsable: "Corresponsable",
    didascala: "Didascala",
    ostiario: "Ostiario",
  };
  return roles[role] || role;
}
---

<section class="brothers-section max-w-7xl mx-auto px-4 py-6">
  <div class="section-header mb-6">
    <h2 class="text-2xl font-bold text-neutral-800">Hermanos Registrados</h2>
    <p class="text-sm text-neutral-600 mt-1">
      Lista de hermanos registrados en las comunidades
    </p>
  </div>

  {
    brothers.length > 0 ? (
      <div class="brothers-table">
        <table class="render-brothers-table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Parroquia</th>
              <th>Comunidad</th>
              <th>Teléfono</th>
              <th>Servicio</th>
              <th>Estado Civil</th>
            </tr>
          </thead>
          <tbody>
            {brothers.map((brother) => (
              <tr class="table-row">
                <td class="table-cell">
                  <div class="cell-main">{brother.names}</div>
                </td>
                <td class="table-cell">
                  <div class="cell-value">{brother.parish?.aka || "N/A"}</div>
                </td>
                <td class="table-cell">
                  <div class="cell-value">
                    {brother.community?.number || "N/A"}
                  </div>
                </td>
                <td class="table-cell">
                  {brother.phone ? (
                    <div class="cell-value">{brother.phone}</div>
                  ) : (
                    <span class="empty-cell">Sin teléfono</span>
                  )}
                </td>
                <td class="table-cell">
                  {brother.roles_in_own_community?.length > 0 ||
                  brother.catechist_of_communities?.length > 0 ? (
                    <div class="roles-container">
                      {brother.roles_in_own_community?.map((role: string) => (
                        <span class="role-tag">{formatRole(role)}</span>
                      ))}
                      {brother.catechist_of_communities?.length > 0 && (
                        <span class="role-tag catequista">
                          Catequista ({brother.catechist_of_communities.length})
                        </span>
                      )}
                    </div>
                  ) : (
                    <span class="empty-cell">-</span>
                  )}
                </td>
                <td class="table-cell">
                  <div class="cell-value">
                    {formatCivilStatus(brother.civil_status)}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="empty-state text-center py-12">
        <div class="text-6xl mb-4">👥</div>
        <h3 class="text-xl font-semibold text-neutral-700 mb-2">
          No hay hermanos registrados
        </h3>
        <p class="text-neutral-600">
          Usa el botón "Agregar Hermano" para comenzar a registrar hermanos
        </p>
      </div>
    )
  }
</section>

<script>
  // Función para recargar la página cuando se agregue un hermano
  (window as any).refreshBrothers = () => {
    // Dar tiempo para que se muestre la notificación antes de recargar
    setTimeout(() => {
      window.location.reload();
    }, 2000);
  };
</script>
