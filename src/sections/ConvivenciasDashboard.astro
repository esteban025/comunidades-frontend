---
import SectionContainer from "@/components/SectionContainer.astro";
import PairsIcon from "@/assets/PairsIcon.astro";
import CheckIcon from "@/assets/CheckIcon.astro";
import SearchBrothers from "@/components/SearchBrothers.astro";
import {
  getConvivenciasForDashboard,
  getInvitedBrothersByConvivencia,
} from "@/services/convivencias";
import PlusIcon from "@/assets/PlusIcon.astro";
import { groupMarriagesForAttendance } from "@/utils/marriageGrouping";
import TrashIcon from "@/assets/TrashIcon.astro";

const { convivencias } = await getConvivenciasForDashboard();
const currentConv =
  convivencias.find(
    (c: any) => c.status === "planificada" || c.status === "en_curso",
  ) ?? null;
const invitedBrothers = currentConv
  ? await getInvitedBrothersByConvivencia(currentConv.id)
  : [];

// Agrupar matrimonios para mostrarlos en una sola fila en la tabla de invitados
const groupedInvited = groupMarriagesForAttendance(invitedBrothers as any[]);
---

<SectionContainer
  id="convivencias-dashboard"
  title="Gestión de convivencias"
  description="Visualiza, planifica y edita las convivencias de tu comunidad."
  data-convivencia-id={currentConv ? currentConv.id : ""}
>
  <div slot="icon-title" class="flex items-center justify-center">
    <PairsIcon class="w-7 aspect-square text-gray-500" />
  </div>
  <div slot="nav-links" class="sss"></div>

  <div slot="body" class="flex flex-col gap-6">
    <!-- Tabla de convivencias -->
    <section>
      <!-- observar este componente para crear filtro similar -->
      <SearchBrothers />
    </section>
    <section id="invited-brothers" class="">
      {
        invitedBrothers.length === 0 && (
          <p class="text-sm w-full p-4 min-h-20 text-gray-500 bg-gray-50 border-dashed border-2 border-border-dark rounded-xl">
            {currentConv
              ? "Aún no hay hermanos invitados registrados para esta convivencia."
              : "No hay ninguna convivencia activa en este momento."}
          </p>
        )
      }
      {
        groupedInvited.length > 0 && (
          <div class="container-table">
            <table>
              <thead>
                <tr>
                  <th class="min">Comunidad</th>
                  <th>Parroquia</th>
                  <th>Nombre del hermano</th>
                  <th class="min">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {groupedInvited.map((brother: any) => (
                  <tr>
                    <td class="text-center">{brother.community_number}</td>
                    <td>
                      <span class="font-medium">{brother.parish_aka}</span>
                    </td>
                    <td>{brother.names}</td>
                    <td>
                      <div class="flex items-center justify-center gap-1">
                        <button
                          type="button"
                          class="atn-btn"
                          data-action="confirm"
                          data-brother-id={brother.brother_id}
                          data-is-marriage={
                            brother.is_marriage ? "true" : "false"
                          }
                          data-husband-id={brother.husband_id || ""}
                          data-wife-id={brother.wife_id || ""}
                          data-husband-name={brother.husband_name || ""}
                          data-wife-name={brother.wife_name || ""}
                          title="confirmar asistencia"
                        >
                          <CheckIcon class="size-4 block" />
                        </button>
                        <button
                          type="button"
                          class="atn-btn"
                          data-action="uninvite"
                          data-brother-id={brother.brother_id}
                          data-is-marriage={
                            brother.is_marriage ? "true" : "false"
                          }
                          data-husband-id={brother.husband_id || ""}
                          data-wife-id={brother.wife_id || ""}
                          title="Dejar de invitar"
                        >
                          <TrashIcon class="size-4 block" />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>
  <div
    class="btns-action flex items-center justify-center gap-2"
    slot="footer-link"
  >
    <button class="btn btn-secondary">Confirmar todos</button>
    <button
      class="btn btn-primary flex item gap-2"
      data-modal="invited-brother-btn"
    >
      <PlusIcon class="size-5 block" />
      <span>Invitar Hermanos</span>
    </button>
  </div>
</SectionContainer>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContainer = document.getElementById(
      "convivencias-dashboard",
    ) as HTMLElement | null;
    const invitedContainer = document.getElementById(
      "invited-brothers",
    ) as HTMLElement | null;

    if (!mainContainer || !invitedContainer) return;

    const convivenciaId = mainContainer.getAttribute("data-convivencia-id");
    if (!convivenciaId) return;

    const buttons = invitedContainer.querySelectorAll(
      "button[data-brother-id]",
    ) as NodeListOf<HTMLButtonElement>;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const action = btn.getAttribute("data-action") || "confirm";

        const brotherId = btn.getAttribute("data-brother-id");
        if (!brotherId) return;

        const isMarriage = btn.getAttribute("data-is-marriage") === "true";
        const husbandId = btn.getAttribute("data-husband-id");
        const wifeId = btn.getAttribute("data-wife-id");
        const husbandName = btn.getAttribute("data-husband-name");
        const wifeName = btn.getAttribute("data-wife-name");

        if (action === "uninvite") {
          const confirmed = confirm(
            "Seguro que deseas eliminar esta invitacion?",
          );
          if (!confirmed) return;

          const idsToRemove: number[] = [];
          if (isMarriage && husbandId && wifeId) {
            idsToRemove.push(Number(husbandId), Number(wifeId));
          } else {
            idsToRemove.push(Number(brotherId));
          }

          const validIds = idsToRemove.filter((id) => !Number.isNaN(id));
          if (validIds.length === 0) return;

          btn.disabled = true;

          fetch(`/api/convivencias/${convivenciaId}/invited`, {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ brother_ids: validIds }),
          })
            .then(async (res) => {
              if (!res.ok) {
                console.error("Error al dejar de invitar", await res.text());
                btn.disabled = false;
                return;
              }

              window.location.reload();
            })
            .catch((err) => {
              console.error("Error de red al dejar de invitar", err);
              btn.disabled = false;
            });

          return;
        }

        if (typeof (window as any).openConfirmAttendanceModal === "function") {
          if (isMarriage && husbandId && wifeId) {
            // Para matrimonios, pasamos ambos IDs y nombres para que el modal
            // confirme a los dos juntos.
            (window as any).openConfirmAttendanceModal(
              convivenciaId,
              husbandId,
              wifeId,
              husbandName,
              wifeName,
            );
          } else {
            (window as any).openConfirmAttendanceModal(
              convivenciaId,
              brotherId,
            );
          }
        } else {
          console.error("openConfirmAttendanceModal no está disponible");
        }
      });
    });

    const inviteBtn = document.querySelector(
      '[data-modal="invited-brother-btn"]',
    ) as HTMLButtonElement | null;

    if (inviteBtn) {
      inviteBtn.addEventListener("click", () => {
        if (typeof (window as any).openMoreInvitedModal === "function") {
          (window as any).openMoreInvitedModal(convivenciaId);
        } else {
          console.error("openMoreInvitedModal no está disponible");
        }
      });
    }
  });
</script>
