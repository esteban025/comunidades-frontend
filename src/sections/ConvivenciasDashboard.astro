---
import SectionContainer from "@/components/SectionContainer.astro";
import PairsIcon from "@/assets/PairsIcon.astro";
import SearchBrothers from "@/components/SearchBrothers.astro";
import {
  getConvivenciasForDashboard,
  getInvitedBrothersByConvivencia,
} from "@/services/convivencias";
import PLusIcon from "@/assets/PLusIcon.astro";

const { convivencias, totals } = await getConvivenciasForDashboard();
const currentConv =
  convivencias.find(
    (c: any) => c.status === "planificada" || c.status === "en_curso",
  ) ?? null;
const invitedBrothers = currentConv
  ? await getInvitedBrothersByConvivencia(currentConv.id)
  : [];
---

<SectionContainer
  id="convivencias-dashboard"
  title="Gestión de convivencias"
  description="Visualiza, planifica y edita las convivencias de tu comunidad."
>
  <div slot="icon-title" class="flex items-center justify-center">
    <PairsIcon class="w-7 aspect-square text-gray-500" />
  </div>
  <div slot="nav-links" class="sss">
    <!-- <button class="btn btn-primary">Finalizar Convivencias</button> -->
    <!-- <button>Editar</button> -->
  </div>

  <div slot="body" class="flex flex-col gap-6">
    <!-- Tabla de convivencias -->
    <section>
      <!-- observar este componente para crear filtro similar -->
      <SearchBrothers />
    </section>
    <section
      id="invited-brothers"
      class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm"
      data-convivencia-id={currentConv ? currentConv.id : ""}
    >
      <header class="flex items-center justify-between mb-4">
        <div class="titles">
          <h2 class="font-semibold">Lista de Hermanos convocados</h2>
          <p class="text-text-muted text-sm">
            Apareceran todos los hermanos que han sido convocados
          </p>
        </div>
        <div class="accions">
          {
            currentConv && (
              <span class="text-sm text-gray-600">
                Convivencia actual: <strong>{currentConv.name}</strong>
              </span>
            )
          }
        </div>
      </header>
      <div class="container-table">
        {
          invitedBrothers.length === 0 && (
            <p class="text-sm text-gray-500">
              {currentConv
                ? "Aún no hay hermanos invitados registrados para esta convivencia."
                : "No hay ninguna convivencia activa en este momento."}
            </p>
          )
        }

        {
          invitedBrothers.length > 0 && (
            <table class="min-w-full text-sm text-left text-gray-700">
              <thead class="border-b text-xs uppercase text-gray-500">
                <tr>
                  <th class="py-2 pr-4">Parroquia</th>
                  <th class="py-2 pr-4">Comunidad</th>
                  <th class="py-2 pr-4">Nombre del hermano</th>
                  <th class="py-2 pr-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {invitedBrothers.map((brother: any) => (
                  <tr class="border-b last:border-0">
                    <td class="py-2 pr-4">
                      <span class="font-medium">{brother.parish_aka}</span>
                    </td>
                    <td class="py-2 pr-4">
                      Comunidad {brother.community_number}
                    </td>
                    <td class="py-2 pr-4">{brother.names}</td>
                    <td class="py-2 pr-0 text-right">
                      <button
                        type="button"
                        class="inline-flex items-center rounded-md border border-gray-300 bg-white px-2.5 py-1 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50"
                        data-brother-id={brother.brother_id}
                      >
                        Confirmar asistencia
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>
    </section>
  </div>
  <div class="btns-action" slot="footer-link">
    <button
      class="btn btn-primary flex item gap-2"
      data-modal="invited-brother-btn"
    >
      <PLusIcon class="size-5 block" />
      <span>Invitar Hermanos</span>
    </button>
  </div>
</SectionContainer>

<script>
  document.addEventListener("astro:page-load", () => {
    const $id = (selector: string) => document.getElementById(selector);

    const container = $id("invited-brothers");

    if (!container) return;

    const convivenciaId = container.getAttribute("data-convivencia-id");
    if (!convivenciaId) return;

    const buttons = container.querySelectorAll(
      "button[data-brother-id]",
    ) as NodeListOf<HTMLButtonElement>;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const brotherId = btn.getAttribute("data-brother-id");
        if (!brotherId) return;

        if (typeof (window as any).openConfirmAttendanceModal === "function") {
          (window as any).openConfirmAttendanceModal(convivenciaId, brotherId);
        } else {
          console.error("openConfirmAttendanceModal no está disponible");
        }
      });
    });

    const inviteBtn = document.querySelector(
      '[data-modal="invited-brother-btn"]',
    ) as HTMLButtonElement | null;

    if (inviteBtn) {
      inviteBtn.addEventListener("click", () => {
        if (typeof (window as any).openMoreInvitedModal === "function") {
          (window as any).openMoreInvitedModal(convivenciaId);
        } else {
          console.error("openMoreInvitedModal no está disponible");
        }
      });
    }
  });
</script>
