---
import type { PaginationPage, Brothers } from "@/types/brothers";
import SectionContainer from "@/components/SectionContainer.astro";
import PaginationBrothers from "@/components/PaginationBrothers.astro";
import FiltersAllBrothers from "@/components/FiltersAllBrothers.astro";
import EyeIcon from "@/assets/EyesIcon.astro";
import PencilIcon from "@/assets/PencilIcon.astro";
import TrashIcon from "@/assets/TrashIcon.astro";
import ArrowIcon from "@/assets/ArrowIcon.astro";
import PairsIcon from "@/assets/PairsIcon.astro";
import {
  countBrotherGroups,
  getBrotherGroupKeysPage,
  getBrothersByGroupKeys,
} from "@/services/brothers";
import EyesIcon from "@/assets/EyesIcon.astro";
import { groupMarriagesById } from "@/utils/marriageGrouping";

const pageParam = Astro.url.searchParams.get("page") ?? "1";
const page = Math.max(1, Number(pageParam) || 1);
const limit = 10;
const offset = (page - 1) * limit;

const totalItems = await countBrotherGroups();
const totalPages = Math.max(1, Math.ceil(totalItems / limit || 1));

const groupKeys = await getBrotherGroupKeysPage({ limit, offset });
const brothers: Brothers[] = (await getBrothersByGroupKeys(groupKeys)) as any;

// Agrupar matrimonios usando helper compartido para que
// todas las tablas de la app tengan el mismo criterio visual.
const groupedBrothers: Brothers[] = groupMarriagesById(brothers as Brothers[]);

const from = totalItems > 0 ? offset + 1 : 0;
const to = Math.min(offset + groupKeys.length, totalItems);

let pagination: PaginationPage = {
  currentPage: page,
  totalPages,
  totalItems,
  itemsPerPage: limit,
  from,
  to,
  hasNextPage: page < totalPages,
  hasPrevPage: page > 1,
};
---

<SectionContainer
  title="Registros de Hermanos"
  description="Explora y gestiona los registros de hermanos en nuestra plataforma."
  id="section-register-brothers"
>
  <div class="block" slot="icon-title">
    <PairsIcon class="w-7 aspect-square block text-gray-500" />
  </div>
  <div slot="body" class="flex flex-col gap-4">
    <!-- Aquí puedes agregar contenido relacionado con los registros de hermanos -->
    <FiltersAllBrothers />
    <div class="container-table">
      {
        groupedBrothers?.length > 0 ? (
          <table class="render-brothers-table brothres-table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Parroquia</th>
                <th class="min">Comunidad</th>
                <th>Teléfono</th>
                <th>Servicio</th>
                <th>Estado Civil</th>
                <th class="min">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {groupedBrothers.map((brother) => {
                const spouse =
                  brother.civil_status === "matrimonio" && brother.spouse_id
                    ? brothers.find((b) => b.id === brother.spouse_id)
                    : null;

                const isMarriage = !!spouse;

                return (
                  <tr
                    data-parish-id={brother.parish?.id || ""}
                    data-community-id={brother.community?.id || ""}
                    data-brother-id={brother.id}
                    data-spouse-id={spouse?.id || ""}
                    data-is-marriage={isMarriage ? "true" : "false"}
                  >
                    <td class="font-medium">{brother.names}</td>
                    <td>{brother.parish?.aka || "N/A"}</td>
                    <td class="min">{brother.community?.number || "N/A"}</td>
                    <td>
                      {brother.phone ? (
                        <div class="phone-display">{brother.phone}</div>
                      ) : (
                        <span class="empty-cell">Sin teléfono</span>
                      )}
                    </td>
                    <td>
                      {brother.roles_in_own_community?.length > 0 ||
                      brother.catechist_of_communities?.length > 0 ? (
                        <div class="roles-container flex flex-wrap gap-1 items-center">
                          {brother.roles_in_own_community?.map(
                            (role: string) => (
                              <span data-rol={role} class="role-tag">
                                {role}
                              </span>
                            ),
                          )}
                          {brother.catechist_of_communities?.length > 0 && (
                            <span
                              data-rol="catequista"
                              class="role-tag catequista"
                            >
                              Catequista (
                              {brother.catechist_of_communities.length})
                            </span>
                          )}
                        </div>
                      ) : (
                        <span class="empty-cell">-</span>
                      )}
                    </td>
                    <td>{brother.civil_status}</td>
                    <td class="min">
                      <div class="content-action-btns">
                        {isMarriage && spouse ? (
                          <>
                            <div class="dropdown-wrapper wrapper-view">
                              <input
                                type="checkbox"
                                id={`dropdown-view-${brother.id}`}
                                class="dropdown-toggle dropdown-view"
                              />
                              <label
                                for={`dropdown-view-${brother.id}`}
                                class="dropdown-bt action-btn"
                              >
                                <span class="icon-dots">
                                  <EyesIcon class="size-4 block" />
                                </span>
                              </label>
                              <div class="dropdown-menu dropdown-menu-view">
                                <button
                                  type="button"
                                  class="brother-menu-item dropdown-item"
                                  data-role="esposo"
                                  data-target-id={brother.id}
                                >
                                  Esposo
                                </button>
                                <button
                                  type="button"
                                  class="brother-menu-item dropdown-item"
                                  data-role="esposa"
                                  data-target-id={spouse.id}
                                >
                                  Esposa
                                </button>
                              </div>
                            </div>

                            <div class="dropdown-wrapper wrapper-edit">
                              <input
                                type="checkbox"
                                id={`dropdown-edit-${brother.id}`}
                                class="dropdown-toggle dropdown-edit"
                              />
                              <label
                                for={`dropdown-edit-${brother.id}`}
                                class="action-btn"
                              >
                                <PencilIcon class="size-4 block" />
                              </label>
                              <div class="dropdown-menu dropdown-menu-edit">
                                <button
                                  type="button"
                                  class="brother-menu-item dropdown-item"
                                  data-role="esposo"
                                  data-target-id={brother.id}
                                >
                                  Esposo
                                </button>
                                <button
                                  type="button"
                                  class="brother-menu-item dropdown-item"
                                  data-role="esposa"
                                  data-target-id={spouse.id}
                                >
                                  Esposa
                                </button>
                              </div>
                            </div>
                          </>
                        ) : (
                          <>
                            <button
                              type="button"
                              class="action-btn brother-view-btn"
                              title="Ver detalles"
                              data-brother-id={brother.id}
                            >
                              <EyeIcon class="size-4 block" />
                            </button>
                            <button
                              type="button"
                              class="action-btn brother-edit-btn"
                              title="Editar"
                              data-brother-id={brother.id}
                            >
                              <PencilIcon class="size-4 block" />
                            </button>
                          </>
                        )}
                        {/* btn - delete */}
                        <button
                          type="button"
                          class="action-btn brother-delete-btn"
                          title="Eliminar"
                          data-brother-id={brother.id}
                        >
                          <TrashIcon class="size-4 block" />
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        ) : (
          <div class="text-center py-12">
            <div class="text-6xl mb-4">👥</div>
            <h3 class="text-xl font-semibold text-neutral-700 mb-2">
              No hay hermanos registrados
            </h3>
            <p class="text-neutral-600">
              Usa el botón "Agregar Hermano" para comenzar a registrar hermanos
            </p>
          </div>
        )
      }
    </div>

    <!-- Controles de paginación -->
    {
      brothers?.length > 0 && (
        <div id="pagination-container">
          <PaginationBrothers
            currentPage={pagination.currentPage || 1}
            totalPages={pagination.totalPages || 1}
            totalItems={pagination.totalItems || 0}
            from={pagination.from || 0}
            to={pagination.to || 0}
            hasNextPage={pagination.hasNextPage || false}
            hasPrevPage={pagination.hasPrevPage || false}
            baseUrl="/"
            anchor="section-register-brothers"
          />
        </div>
      )
    }
  </div>
  <a
    slot="footer-link"
    class="hover:underline flex items-center gap-1 group"
    href="#"
  >
    <span>Ver todos los registros</span>
    <ArrowIcon
      class="inline-block w-4 h-4 group-hover:ml-1 transition-all duration-300"
    />
  </a>
</SectionContainer>

<script>
  import { showNotification } from "@/scripts/notification";

  // Función para recargar la página cuando se agregue un hermano
  (window as any).refreshBrothers = () => {
    setTimeout(() => {
      window.location.reload();
    }, 1000);
  };

  document.addEventListener("astro:page-load", () => {
    // Botones de ver para hermanos sin menú de matrimonio
    const viewButtons = document.querySelectorAll(
      ".brother-view-btn",
    ) as NodeListOf<HTMLButtonElement>;

    viewButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const id = btn.getAttribute("data-brother-id");
        if (!id) return;

        if (typeof (window as any).openViewBrotherModal === "function") {
          (window as any).openViewBrotherModal(id);
        }
      });
    });

    // Botones de editar para hermanos sin menú de matrimonio
    const editButtons = document.querySelectorAll(
      ".brother-edit-btn",
    ) as NodeListOf<HTMLButtonElement>;

    editButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const id = btn.getAttribute("data-brother-id");
        if (!id) return;

        if (typeof (window as any).openEditBrotherModal === "function") {
          (window as any).openEditBrotherModal(id);
        }
      });
    });

    // Items dentro de los dropdowns de matrimonios (ver/editar esposo/esposa)
    const dropdownItems = document.querySelectorAll(
      ".brother-menu-item",
    ) as NodeListOf<HTMLButtonElement>;

    dropdownItems.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.preventDefault();

        const targetId = item.getAttribute("data-target-id");
        if (!targetId) return;

        const wrapper = item.closest(".dropdown-wrapper") as HTMLElement | null;
        if (!wrapper) return;

        const isView = wrapper.classList.contains("wrapper-view");
        const isEdit = wrapper.classList.contains("wrapper-edit");
        const role = item.getAttribute("data-role") || undefined;

        if (isView) {
          if (typeof (window as any).openViewBrotherModal === "function") {
            (window as any).openViewBrotherModal(targetId);
          }
        } else if (isEdit) {
          if (typeof (window as any).openEditBrotherModal === "function") {
            (window as any).openEditBrotherModal(targetId, role);
          }
        }

        // Cerrar el dropdown desmarcando el checkbox asociado
        const toggle = wrapper.querySelector(
          ".dropdown-toggle",
        ) as HTMLInputElement | null;
        if (toggle) {
          toggle.checked = false;
        }
      });
    });

    // Botón eliminar (soltero o matrimonio)
    const deleteButtons = document.querySelectorAll(
      ".brother-delete-btn",
    ) as NodeListOf<HTMLButtonElement>;

    deleteButtons.forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();

        const id = btn.getAttribute("data-brother-id");
        if (!id) return;

        const row = btn.closest("tr") as HTMLTableRowElement | null;
        const isMarriage = row?.dataset.isMarriage === "true";

        const message = isMarriage
          ? "Vas a eliminar este MATRIMONIO. Se eliminarán ambos (esposo y esposa), sus roles y todas sus conexiones. ¿Deseas continuar?"
          : "Vas a eliminar este hermano. Se eliminarán sus roles y todas sus conexiones. ¿Deseas continuar?";

        const confirmed = window.confirm(message);
        if (!confirmed) return;

        try {
          const response = await fetch(`/api/brothers/${id}`, {
            method: "DELETE",
          });
          const result = await response.json();

          if (response.ok && result.success) {
            showNotification(
              result.message || "Eliminado exitosamente",
              "success",
              3000,
            );
            if (typeof (window as any).refreshBrothers === "function") {
              await (window as any).refreshBrothers();
            } else {
              window.location.reload();
            }
          } else {
            showNotification(
              result.error || "Error al eliminar",
              "error",
              5000,
            );
          }
        } catch (error) {
          console.error("Error eliminando hermano:", error);
          showNotification("Error de conexión al eliminar", "error", 5000);
        }
      });
    });
  });
</script>
