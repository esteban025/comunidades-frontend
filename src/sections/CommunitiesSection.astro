---
import SectionContainer from "@/components/SectionContainer.astro";
import ParishCard from "@/components/ParishCard.astro";

import ConfigIcon from "@/assets/ConfigIcon.astro";
import { db } from "@/lib/db";
const query = `
  SELECT 
    p.id as parish_id,
    p.name as parish_name,
    p.aka as parish_aka,
    c.id as community_id,
    c.number_community,
    c.level_paso,
    COUNT(DISTINCT b.id) as total_brothers,
    GROUP_CONCAT(DISTINCT CASE WHEN br.role = 'Responsable' THEN resp.names END SEPARATOR ', ') as responsable_names
  FROM parishes p
  LEFT JOIN communities c ON p.id = c.parish_id
  LEFT JOIN brothers b ON c.id = b.community_id
  LEFT JOIN brother_roles br ON c.id = br.community_id AND br.role = 'Responsable'
  LEFT JOIN brothers resp ON br.brother_id = resp.id
  GROUP BY p.id, p.name, p.aka, c.id, c.number_community, c.level_paso
  ORDER BY p.name, c.number_community
`;
const [rows]: any = await db.query(query);

// Agrupar por parroquia
const parishesMap = new Map();

rows.forEach((row: any) => {
  if (!parishesMap.has(row.parish_id)) {
    parishesMap.set(row.parish_id, {
      id: row.parish_id,
      name: row.parish_name,
      aka: row.parish_aka,
      communities: [],
    });
  }

  if (row.community_id) {
    parishesMap.get(row.parish_id).communities.push({
      id: row.community_id,
      number: row.number_community,
      paso: row.level_paso,
      totalBrothers: row.total_brothers,
      responsable: row.responsable_names || "Sin responsable",
    });
  }
});

const parishes = Array.from(parishesMap.values());
---

<SectionContainer
  title="Gestion de Comunidades"
  description="Administración , fusiona y reorganiza comunidades por parroquia"
  id="section-communities"
>
  <button
    onclick="openManageCommunitiesModal()"
    slot="nav-links"
    class="btn btn-primary flex items-center gap-2"
  >
    <ConfigIcon class="w-6 aspect-square block" />
    <span>Fusion/Reorganizar Comunidades</span>
  </button>
  <div class="dd" slot="body">
    <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
      {
        parishes.map((parish) => (
          <ParishCard>
            <div class="p-6">
              <header class="flex flex-col gap-1">
                <h3 class="text-2xl font-semibold text-text-primary">
                  {parish.aka}
                </h3>
                <span class="text-xs mb-4 text-text-muted">{parish.name}</span>
              </header>

              {parish.communities.length > 0 ? (
                <div class="flex flex-col gap-2">
                  {parish.communities.map((community: any) => (
                    <div class="flex items-center gap-4 p-4 bg-linear-to-r from-gray-50 to-gray-100 rounded-lg border-l-4 border-gray-400">
                      <div class="w-10 aspect-square bg-gray-400 rounded-full flex items-center justify-center text-white font-semibold">
                        {community.number}
                      </div>
                      <div class="flex-1 overflow-hidden">
                        <p class="font-semibold text-gray-800 truncate">
                          {community.responsable}
                        </p>
                        <p class="text-sm text-gray-600">
                          {community.totalBrothers} hermanos
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="flex items-center gap-4 p-4 bg-linear-to-r from-gray-100 to-gray-200 rounded-lg border-l-4 border-gray-300">
                  <p class="text-text-muted">No hay comunidades registradas</p>
                </div>
              )}
            </div>
          </ParishCard>
        ))
      }
    </div>
  </div>
</SectionContainer>
