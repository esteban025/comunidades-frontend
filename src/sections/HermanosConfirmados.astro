---
import SectionContainer from "@/components/SectionContainer.astro";
import PencilIcon from "@/assets/PencilIcon.astro";
import TrashIcon from "@/assets/TrashIcon.astro";
import {
  getConvivenciasForDashboard,
  getConfirmedBrothersByConvivencia,
} from "@/services/convivencias";
import { groupMarriagesForAttendance } from "@/utils/marriageGrouping";

const { convivencias } = await getConvivenciasForDashboard();
const currentConv =
  convivencias.find(
    (c: any) => c.status === "planificada" || c.status === "en_curso",
  ) ?? null;
const confirmedBrothers = currentConv
  ? await getConfirmedBrothersByConvivencia(currentConv.id)
  : [];

// Agrupar matrimonios para mostrarlos en una sola fila
const groupedConfirmed = groupMarriagesForAttendance(
  confirmedBrothers as any[],
);
---

<SectionContainer
  title="Hermanos Confirmados"
  description="Se mostrará todos los hermanos que han dicho que asistirán"
>
  <div class="s" slot="body">
    {
      confirmedBrothers.length === 0 && (
        <p class="text-sm w-full p-4 min-h-20 text-gray-500 bg-gray-50 border-dashed border-2 border-border-dark rounded-xl">
          {currentConv
            ? "Aún no hay hermanos confirmados para esta convivencia."
            : "No hay ninguna convivencia activa en este momento."}
        </p>
      )
    }

    {
      groupedConfirmed.length > 0 && (
        <div class="container-table">
          <table>
            <thead>
              <tr>
                <th class="min">N°Com</th>
                <th>Parroquia</th>
                <th>Nombre del hermano</th>
                <th>Observaciones</th>
                {/* <th>Casa asignada</th> */}
                <th class="min">Accions</th>
              </tr>
            </thead>
            <tbody>
              {groupedConfirmed.map((brother: any) => (
                <tr class="border-b last:border-0">
                  <td class="text-center min">{brother.community_number}</td>
                  <td>
                    <span class="font-medium">{brother.parish_aka}</span>
                  </td>
                  <td>{brother.names}</td>
                  <td>{brother.observations ?? "-"}</td>
                  {/* <td>{brother.casa_name ?? "-"}</td> */}
                  <td class="min">
                    <div class="flex items-center justify-center gap-1">
                      <button
                        type="button"
                        class="action-btn edit-obsv-convi"
                        title="Editar"
                        data-convivencia-id={currentConv?.id ?? ""}
                        data-brother-id={
                          brother.is_marriage
                            ? brother.husband_id
                            : brother.brother_id
                        }
                        data-spouse-id={
                          brother.is_marriage ? brother.wife_id : ""
                        }
                        data-observations={brother.observations ?? ""}
                      >
                        <PencilIcon class="size-4 block" />
                      </button>

                      {/* eliminar */}
                      <button
                        type="button"
                        class="action-btn delete-confirm-convi"
                        title="Eliminar"
                        data-convivencia-id={currentConv?.id ?? ""}
                        data-brother-id={
                          brother.is_marriage
                            ? brother.husband_id
                            : brother.brother_id
                        }
                        data-spouse-id={
                          brother.is_marriage ? brother.wife_id : ""
                        }
                      >
                        <TrashIcon class="size-4 block" />
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
  {
    confirmedBrothers.length > 0 && (
      <div class="" slot="footer-link">
        <a
          class="btn btn-primary flex"
          href={
            currentConv
              ? `/asistentes-confirmados?convivenciaId=${currentConv.id}`
              : "/asistentes-confirmados"
          }
        >
          Ver lista de confirmados
        </a>
      </div>
    )
  }
</SectionContainer>

<script>
  document.addEventListener("astro:page-load", () => {
    const buttons = document.querySelectorAll(".edit-obsv-convi");
    const deleteButtons = document.querySelectorAll(".delete-confirm-convi");

    buttons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const el = btn as HTMLElement;
        const convId = el.dataset.convivenciaId || "";
        const brotherId = el.dataset.brotherId || "";
        const spouseId = el.dataset.spouseId || "";
        const observations = el.dataset.observations || "";

        if (!convId || !brotherId) return;
        if (typeof (window as any).openConfirmAttendanceModal !== "function")
          return;

        (window as any).openConfirmAttendanceModal(
          convId,
          brotherId,
          spouseId || null,
          observations,
          "edit",
        );
      });
    });

    deleteButtons.forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        const el = btn as HTMLElement;

        const convId = el.dataset.convivenciaId || "";
        const brotherId = el.dataset.brotherId || "";
        const spouseId = el.dataset.spouseId || "";
        const isMarriage = Boolean(spouseId);

        if (!convId || !brotherId) return;

        const ok = window.confirm(
          isMarriage
            ? "¿Revertir confirmación del matrimonio? Volverán a Invitados."
            : "¿Revertir confirmación? Este hermano volverá a Invitados.",
        );

        if (!ok) return;

        const ids = isMarriage ? [brotherId, spouseId] : [brotherId];

        try {
          for (const id of ids) {
            const res = await fetch(`/api/convivencias/${convId}/attendees`, {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ brother_id: Number(id) }),
            });

            if (!res.ok) {
              console.error("Error al revertir confirmación", await res.text());
              return;
            }
          }

          setTimeout(() => {
            window.location.reload();
          }, 300);
        } catch (err) {
          console.error("Error de red al revertir confirmación", err);
        }
      });
    });
  });
</script>
