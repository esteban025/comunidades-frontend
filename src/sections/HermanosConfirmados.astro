---
import SectionContainer from "@/components/SectionContainer.astro";
import {
  getConvivenciasForDashboard,
  getConfirmedBrothersByConvivencia,
} from "@/services/convivencias";

const { convivencias } = await getConvivenciasForDashboard();
const currentConv = convivencias[0] ?? null;
const confirmedBrothers = currentConv
  ? await getConfirmedBrothersByConvivencia(currentConv.id)
  : [];
---

<SectionContainer
  title="Hermanos Confirmados"
  description="Se mostrará todos los hermanos que han dicho que asistirán"
>
  <div class="s" slot="body">
    {
      confirmedBrothers.length === 0 && (
        <p class="text-sm text-gray-500">
          {currentConv
            ? "Aún no hay hermanos confirmados para esta convivencia."
            : "No hay ninguna convivencia activa en este momento."}
        </p>
      )
    }

    {
      confirmedBrothers.length > 0 && (
        <div class="container-table">
          <table class="min-w-full text-sm text-left text-gray-700">
            <thead class="border-b text-xs uppercase text-gray-500">
              <tr>
                <th class="py-2 pr-4">Parroquia</th>
                <th class="py-2 pr-4">Comunidad</th>
                <th class="py-2 pr-4">Nombre del hermano</th>
                <th class="py-2 pr-4">Observaciones</th>
                <th class="py-2 pr-4">Necesidades</th>
                <th class="py-2 pr-4">Casa asignada</th>
              </tr>
            </thead>
            <tbody>
              {confirmedBrothers.map((brother: any) => (
                <tr class="border-b last:border-0">
                  <td class="py-2 pr-4">
                    <span class="font-medium">{brother.parish_aka}</span>
                  </td>
                  <td class="py-2 pr-4">
                    Comunidad {brother.community_number}
                  </td>
                  <td class="py-2 pr-4">{brother.names}</td>
                  <td class="py-2 pr-4">{brother.observations ?? "-"}</td>
                  <td class="py-2 pr-4">{brother.special_needs ?? "-"}</td>
                  <td class="py-2 pr-4">{brother.casa_name ?? "-"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
  {
    confirmedBrothers.length > 0 && (
      <div class="" slot="footer-link">
        <a
          class="btn btn-primary flex"
          href={
            currentConv
              ? `/asistentes-confirmados?convivenciaId=${currentConv.id}`
              : "/asistentes-confirmados"
          }
        >
          Ver lista de confirmados
        </a>
      </div>
    )
  }
</SectionContainer>
