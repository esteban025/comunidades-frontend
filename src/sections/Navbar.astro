---
import NavbarPage from "@/components/NavbarPage.astro";
import PlusIcon from "@/assets/PLusIcon.astro";
---

<NavbarPage title="Comunidades" description="Sistema de Registro">
  <div class="flex flex-wrap gap-2 transition-all duration-500" slot="actions">
    <button class="btn btn-primary navbar-btn text-sm" data-modal="brother">
      <div class="flex items-center gap-2">
        <span class="navbar-btn-icon">
          <PlusIcon class="w-4 aspect-square block" />
        </span>
        <span class="navbar-btn-text">Agregar Hermano</span>
      </div>
    </button>

    <button class="btn btn-secondary navbar-btn text-sm" data-modal="parish">
      <div class="flex items-center gap-2">
        <span class="navbar-btn-icon">
          <PlusIcon class="w-4 aspect-square block" />
        </span>
        <span class="navbar-btn-text">Agregar Parroquia</span>
      </div>
    </button>
  </div>
</NavbarPage>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbarButtons = document.querySelectorAll(".navbar-btn");

    navbarButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const modalType = button.getAttribute("data-modal");

        if (modalType === "brother") {
          if (typeof (window as any).openBrotherModal === "function") {
            (window as any).openBrotherModal();
          } else {
            console.log("openBrotherModal no está disponible");
          }
        } else if (modalType === "parish") {
          if (typeof (window as any).openParishModal === "function") {
            (window as any).openParishModal();
          } else {
            console.log("openParishModal no está disponible");
          }
        }
      });
    });
  });
</script>
