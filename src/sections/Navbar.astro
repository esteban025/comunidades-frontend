---
import NavbarPage from "@/components/NavbarPage.astro";
import PlusIcon from "@/assets/PLusIcon.astro";
---

<NavbarPage
  {...Astro.props}
  title="Comunidades"
  description="Sistema de Registro"
>
  <div class="flex flex-wrap gap-2 transition-all duration-500" slot="actions">
    <button
      id="open-modal-parish"
      class="btn btn-primary flex items-center gap-2"
      data-modal="parish"
    >
      <PlusIcon class="size-4 block" />
      <span>Agregar Parroquia</span>
    </button>
  </div>
</NavbarPage>

<script>
  import { $id } from "@/utils/selectElementsDom";
  document.addEventListener("astro:page-load", () => {
    const $openModalBtn = $id("open-modal-parish") as HTMLButtonElement;
    const $modal = $id("modal-parish") as HTMLElement;

    $openModalBtn.addEventListener("click", () => {
      if ($modal) {
        if (typeof (window as any).openParishModal === "function") {
          (window as any).openParishModal();
        } else {
          console.log("openParishModal no está disponible");
        }
      }
    });
  });
</script>
