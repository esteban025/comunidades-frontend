---
// Navbar component
---

<nav class="navbar">
  <div class="navbar-container">
    <div class="navbar-brand">
      <h1 class="navbar-title">Comunidades</h1>
      <span class="navbar-subtitle">Sistema de Registro</span>
    </div>

    <div class="navbar-menu">
      <button class="navbar-btn" data-modal="parish">
        <span class="navbar-btn-icon">➕</span>
        <span class="navbar-btn-text">Parroquia</span>
      </button>

      <button class="navbar-btn" data-modal="community">
        <span class="navbar-btn-icon">➕</span>
        <span class="navbar-btn-text">Comunidad</span>
      </button>

      <button class="navbar-btn" data-modal="brother">
        <span class="navbar-btn-icon">➕</span>
        <span class="navbar-btn-text">Hermano</span>
      </button>

      <button class="navbar-btn" data-modal="role">
        <span class="navbar-btn-icon">➕</span>
        <span class="navbar-btn-text">Rol</span>
      </button>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background-color: #ffffff;
    border-bottom: 2px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 40;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
  }

  .navbar-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .navbar-brand {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .navbar-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0;
    line-height: 1;
  }

  .navbar-subtitle {
    font-size: 0.75rem;
    color: #6b7280;
    font-weight: 500;
  }

  .navbar-menu {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .navbar-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background-color: #f9fafb;
    border: 2px solid #e5e7eb;
    border-radius: 9999px;
    color: #374151;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
  }

  .navbar-btn:hover {
    background-color: #f3f4f6;
    border-color: #d1d5db;
    transform: translateY(-1px);
    box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.05);
  }

  .navbar-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .navbar-btn:focus {
    border-color: #9ca3af;
    box-shadow: 0 0 0 3px rgba(156, 163, 175, 0.2);
  }

  .navbar-btn-text {
    line-height: 1;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .navbar-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .navbar-menu {
      width: 100%;
      justify-content: flex-start;
    }

    .navbar-btn {
      flex: 1;
      min-width: calc(50% - 0.375rem);
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .navbar-btn {
      min-width: 100%;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbarButtons = document.querySelectorAll(".navbar-btn");

    navbarButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const modalType = button.getAttribute("data-modal");

        // Abrir el modal correspondiente
        if (modalType === "parish") {
          if (typeof (window as any).openParishModal === "function") {
            (window as any).openParishModal();
          } else {
            console.log("openParishModal no está disponible");
          }
        } else if (modalType === "community") {
          console.log("Modal de comunidad (próximamente)");
        } else if (modalType === "brother") {
          console.log("Modal de hermano (próximamente)");
        } else if (modalType === "role") {
          console.log("Modal de rol (próximamente)");
        }
      });
    });
  });
</script>
