---
import AllBrothersCard from "@/components/AllBrothersCard.astro";
import AllCatechistsCard from "@/components/AllCatechistsCard.astro";
import AllCommunitiesCard from "@/components/AllCommunitiesCard.astro";
import AllParishesCard from "@/components/AllParishesCard.astro";
---

<section
  class="w-full max-w-6xl mx-auto bg-gray-50 rounded-xl shadow-md overflow-hidden"
>
  <header class="p-6 pb-0">
    <h3 class="text-2xl font-bold mb-1">Resumen</h3>
    <p class="text-sm text-gray-500">
      Vista rápida de las estadísticas principales de la plataforma
    </p>
  </header>
  <div
    class="grid gap-3 justify-center items-center my-8 px-6"
    style="grid-template-columns: repeat(auto-fit,minmax(min(100%,200px), 1fr));"
  >
    <AllBrothersCard />
    <AllParishesCard />
    <AllCommunitiesCard />
    <AllCatechistsCard />
  </div>
  <footer class="p-6 border-t-2 border-gray-200 bg-white/70">
    <div class="flex justify-between items-center text-gray-500 text-sm">
      <span class=""
        >Última actualización: {new Date().toLocaleDateString()}</span
      >
      <a class="hover:underline" href="#">Ver todos los detalles</a>
    </div>
  </footer>
</section>

<script>
  // Aquí puedes agregar cualquier lógica adicional si es necesario
</script>
