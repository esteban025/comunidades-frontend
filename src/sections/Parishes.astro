---
interface Parish {
  name: string;
  aka: string;
  tag: string;
}

interface ParishesResponse {
  success: boolean;
  data: Parish[];
}

let parishes: Parish[] = [];
let error = false;

try {
  const response = await fetch("http://localhost:4321/api/parishes");
  const result: ParishesResponse = await response.json();

  if (result.success && result.data) {
    parishes = result.data;
  }
} catch (e) {
  error = true;
  console.error("Error fetching parishes:", e);
}
---

<section class="w-full max-w-4xl mx-auto">
  <h2 class="text-3xl font-semibold text-center mb-8 text-gray-800">
    Parroquias
  </h2>

  <div id="parishes-container">
    {
      error ? (
        <div class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600">
          Error al cargar las parroquias
        </div>
      ) : parishes.length === 0 ? (
        <div class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600">
          No hay parroquias registradas
        </div>
      ) : (
        <div
          id="parishes-grid"
          class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]"
        >
          {parishes.map((parish) => (
            <article class="parish-card bg-white border-2 border-gray-200 rounded-3xl p-4 hover:border-gray-400 transition-all duration-200 hover:shadow-md">
              <div class="flex flex-col gap-1">
                <h3 class="text-2xl font-semibold text-gray-800">
                  {parish.aka}
                </h3>
                <span class="text-xs mb-4 text-neutral-600">{parish.name}</span>
                <span class="inline-block bg-gray-600 text-white text-sm font-medium px-4 py-1.5 rounded-full w-fit">
                  {parish.tag}
                </span>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  interface Parish {
    name: string;
    aka: string;
    tag: string;
  }

  export async function refreshParishes() {
    try {
      const response = await fetch("/api/parishes");
      const result = await response.json();

      if (result.success && result.data) {
        const container = document.getElementById("parishes-container");
        if (!container) return;

        const parishes: Parish[] = result.data;

        if (parishes.length === 0) {
          container.innerHTML = `
            <div class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600">
              No hay parroquias registradas
            </div>
          `;
        } else {
          const grid = document.createElement("div");
          grid.id = "parishes-grid";
          grid.className =
            "grid gap-4 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]";

          parishes.forEach((parish) => {
            const article = document.createElement("article");
            article.className =
              "parish-card bg-white border-2 border-gray-200 rounded-3xl p-4 hover:border-gray-400 transition-all duration-200 hover:shadow-md";
            article.innerHTML = `
              <div class="flex flex-col gap-2">
                <h3 class="text-xl font-semibold text-gray-800">${parish.aka}</h3>
                <span class="text-xs mb-4 text-neutral-600">${parish.name}</span>
                <span class="inline-block bg-gray-600 text-white text-sm font-medium px-4 py-1.5 rounded-full w-fit">
                  ${parish.tag}
                </span>
              </div>
            `;
            grid.appendChild(article);
          });

          container.innerHTML = "";
          container.appendChild(grid);
        }
      }
    } catch (error) {
      console.error("Error al refrescar parroquias:", error);
    }
  }

  // Hacer la función disponible globalmente
  if (typeof window !== "undefined") {
    (window as any).refreshParishes = refreshParishes;
  }
</script>
