---
import SectionContainer from "@/components/SectionContainer.astro";
import ParishCard from "@/components/ParishCard.astro";
import PencilIcon from "@/assets/PencilIcon.astro";
import ChurchIcon from "@/assets/ChurchIcon.astro";
import type { ParishesResponse, Parish } from "@/types/parishes";

let parishes: Parish[] = [];
let error = false;

try {
  const response = await fetch("http://localhost:4321/api/parishes");
  const result: ParishesResponse = await response.json();

  if (result.success && result.data) {
    parishes = result.data;
  }
} catch (e) {
  error = true;
  console.error("Error fetching parishes:", e);
}
---

<SectionContainer
  title="Parroquias"
  description="Explora las parroquias registradas en nuestra plataforma."
  id="section-parishes"
  transition:name="parishes-section"
>
  <div class="icon-title block" slot="icon-title">
    <ChurchIcon class="w-8 aspect-square block text-gray-500" />
  </div>
  <div id="parishes-container" slot="body">
    {
      error ? (
        <div class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600">
          Error al cargar las parroquias
        </div>
      ) : parishes.length === 0 ? (
        <div class="text-center py-12 bg-white rounded-2xl overflow-hidden border border-gray-300 shadow-lg">
          <div class="text-6xl mb-4">📭</div>
          <h3 class="text-xl font-semibold text-neutral-700 mb-2">
            No hay parroquias registradas aún
          </h3>
          <p class="text-neutral-600">
            Agrega nuevas parroquias para comenzar a gestionar las comunidades.
          </p>
        </div>
      ) : (
        <div
          id="parishes-grid"
          class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]"
        >
          {parishes.map((parish) => (
            <ParishCard href={`/parishes/${parish.tag}`}>
              <div class="relative" slot="btn-edit">
                <button
                  class="parish-action-btn flex items-center justify-center w-8.5 aspect-square rounded-lg border border-gray-200 bg-white cursor-pointer transition-all duration-200 ease-in-out text-gray-500 hover:border-gray-300 hover:shadow-md"
                  title="Opciones"
                  data-parish-id={parish.id}
                  data-parish-name={parish.name}
                  data-parish-aka={parish.aka}
                  data-parish-tag={parish.tag}
                >
                  <PencilIcon class="w-5 h-5" />
                </button>
                <div
                  class="parish-menu hidden absolute top-[-20%] right-[110%] mt-2 bg-white border border-gray-200 rounded-md shadow-lg overflow-hidden z-50 min-w-36"
                  data-menu-for={parish.id}
                >
                  <button class="parish-menu-item edit" data-action="edit">
                    Editar
                  </button>
                  <button class="parish-menu-item delete" data-action="delete">
                    Eliminar
                  </button>
                </div>
              </div>
              <div class="flex flex-col gap-1 p-6">
                <h3 class="text-2xl font-semibold text-text-primary">
                  {parish.aka}
                </h3>
                <span class="text-sm mb-4 text-text-muted">{parish.name}</span>
                <span class="tag-others role-tag text-sm w-max">
                  {parish.tag}
                </span>
              </div>
            </ParishCard>
          ))}
        </div>
      )
    }
  </div>
</SectionContainer>

<style>
  .parish-menu.hidden {
    display: none;
  }

  .parish-menu-item {
    width: 100%;
    padding: 0.625rem 1rem;
    text-align: left;
    background: white;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;

    &:hover {
      background: #f3f4f6;
    }
  }

  .parish-menu-item.edit:hover {
    background: var(--color-gray-50);
  }

  .parish-menu-item.delete:hover {
    background: var(--color-red-50);
  }
</style>

<script>
  import { showNotification } from "@/scripts/notification";

  // Función para recargar la página cuando se agregue/edite una parroquia
  (window as any).refreshParishes = () => {
    setTimeout(() => {
      window.location.reload();
    }, 500);
  };

  document.addEventListener("astro:page-load", () => {
    const actionButtons = document.querySelectorAll(".parish-action-btn");

    // Toggle menu al hacer click en el botón
    actionButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        e.stopPropagation();
        const parishId = (button as HTMLElement).dataset.parishId;
        const menu = document.querySelector(
          `[data-menu-for="${parishId}"]`,
        ) as HTMLElement;

        // Cerrar otros menús abiertos
        document.querySelectorAll(".parish-menu").forEach((otherMenu) => {
          if (otherMenu !== menu) {
            otherMenu.classList.add("hidden");
          }
        });

        // Toggle el menú actual
        menu?.classList.toggle("hidden");
      });
    });

    // Cerrar menú al salir del card (mouseleave)
    document.querySelectorAll(".parish-card").forEach((card) => {
      card.addEventListener("mouseleave", () => {
        const parishId = card
          .querySelector(".parish-action-btn")
          ?.getAttribute("data-parish-id");
        if (parishId) {
          const menu = document.querySelector(
            `[data-menu-for="${parishId}"]`,
          ) as HTMLElement;
          menu?.classList.add("hidden");
        }
      });
    });

    // Cerrar menús al hacer click fuera
    document.addEventListener("click", () => {
      document.querySelectorAll(".parish-menu").forEach((menu) => {
        menu.classList.add("hidden");
      });
    });

    // Manejar acciones del menú
    document.querySelectorAll(".parish-menu-item").forEach((item) => {
      item.addEventListener("click", async (e) => {
        e.stopPropagation();
        const action = (item as HTMLElement).dataset.action;
        const menu = (item as HTMLElement).closest(".parish-menu");
        const parishId = menu?.getAttribute("data-menu-for");
        const button = document.querySelector(
          `[data-parish-id="${parishId}"]`,
        ) as HTMLElement;

        if (!button) return;

        const parishData = {
          id: button.dataset.parishId,
          name: button.dataset.parishName,
          aka: button.dataset.parishAka,
          tag: button.dataset.parishTag,
        };

        menu?.classList.add("hidden");

        if (action === "edit") {
          // Abrir modal de edición
          if (typeof (window as any).openEditParishModal === "function") {
            (window as any).openEditParishModal(parishData);
          }
        } else if (action === "delete") {
          // Confirmar eliminación
          const confirmed = confirm(
            `¿Estás seguro de eliminar la parroquia "${parishData.name}"?\n\nEsta acción no se puede deshacer.`,
          );

          if (confirmed) {
            try {
              const response = await fetch(`/api/parishes/${parishData.id}`, {
                method: "DELETE",
              });

              const result = await response.json();

              if (result.success) {
                showNotification(
                  "¡Parroquia eliminada exitosamente!",
                  "success",
                  3000,
                );
                setTimeout(() => {
                  window.location.reload();
                }, 500);
              } else {
                showNotification(
                  result.error || "Error al eliminar la parroquia",
                  "error",
                  5000,
                );
              }
            } catch (error) {
              console.error("Error eliminando parroquia:", error);
              showNotification(
                "Error de conexión al eliminar la parroquia",
                "error",
                5000,
              );
            }
          }
        }
      });
    });
  });
</script>
