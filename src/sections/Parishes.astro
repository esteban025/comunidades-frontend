---
import SectionContainer from "@/components/SectionContainer.astro";
interface Parish {
  name: string;
  aka: string;
  tag: string;
}

interface ParishesResponse {
  success: boolean;
  data: Parish[];
}

let parishes: Parish[] = [];
let error = false;

try {
  const response = await fetch("http://localhost:4321/api/parishes");
  const result: ParishesResponse = await response.json();

  if (result.success && result.data) {
    parishes = result.data;
  }
} catch (e) {
  error = true;
  console.error("Error fetching parishes:", e);
}
---

<SectionContainer
  title="Parroquias"
  description="Explora las parroquias registradas en nuestra plataforma."
>
  <div id="parishes-container" slot="body">
    {
      error ? (
        <div class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600">
          Error al cargar las parroquias
        </div>
      ) : parishes.length === 0 ? (
        <div class="text-center py-12 bg-white rounded-2xl overflow-hidden border border-gray-300 shadow-lg">
          <div class="text-6xl mb-4">📭</div>
          <h3 class="text-xl font-semibold text-neutral-700 mb-2">
            No hay parroquias registradas aún
          </h3>
          <p class="text-neutral-600">
            Agrega nuevas parroquias para comenzar a gestionar las comunidades.
          </p>
        </div>
      ) : (
        <div
          id="parishes-grid"
          class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]"
        >
          {parishes.map((parish) => (
            <article class="parish-card bg-white border-2 border-gray-200 rounded-3xl p-4 hover:border-gray-400 transition-all duration-200 hover:shadow-md">
              <div class="flex flex-col gap-1">
                <h3 class="text-2xl font-semibold text-gray-800">
                  {parish.aka}
                </h3>
                <span class="text-xs mb-4 text-neutral-600">{parish.name}</span>
                <span class="inline-block bg-gray-600 text-white text-sm font-medium px-4 py-1.5 rounded-full w-fit">
                  {parish.tag}
                </span>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</SectionContainer>

<script>
  // Función para recargar la página cuando se agregue una parroquia
  (window as any).refreshParishes = () => {
    // Dar tiempo para que se muestre la notificación antes de recargar
    setTimeout(() => {
      window.location.reload();
    }, 2000);
  };
</script>
