---
import LogoCaminoIcon from "@/assets/LogoCaminoIcon.astro";
---

<header
  class="py-8 no-print flex items-center justify-center gap-6 gap-y-2 flex-wrap"
  transition:name="header-page"
>
  <div class="icon">
    <LogoCaminoIcon
      class="svg-camino w-full h-auto max-w-24 align-middle mr-2"
    />
  </div>
  <div class="flex flex-col items-center justify-center">
    <h1 class="font-semibold flex items-center gap-4 text-center text-balance">
      <span>Camino Neocatecumental</span>
    </h1>
    <p class="text-center text-balance text-gray-700">
      Registro de parroquias, comunidades y hermanos en esta seccion
    </p>
  </div>
</header>

<style>
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
</style>
