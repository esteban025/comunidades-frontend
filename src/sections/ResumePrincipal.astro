---
import SectionContainer from "@/components/SectionContainer.astro";
import ArrowIcon from "@/assets/ArrowIcon.astro";
import {
  getTotalBrothers,
  getTotalCatechists,
  getTotalCommunities,
  getTotalParishes,
} from "@/lib/stats";

const info = [
  {
    name: "Parroquias",
    count: await getTotalParishes(),
    href: "#section-parishes",
  },
  {
    name: "Hermanos",
    count: await getTotalBrothers(),
    href: "#section-register-brothers",
  },
  {
    name: "Comunidades",
    count: await getTotalCommunities(),
    href: "/communities",
  },
  {
    name: "Catequistas",
    count: await getTotalCatechists(),
    href: "#",
  },
];
---

<SectionContainer
  title="Resumen"
  description="Vista rápida de las estadísticas principales de la plataforma"
>
  <div
    slot="body"
    class="bg-gray-100 rounded-full border border-border-light shadow-sm relative"
  >
    {
      info.map((item, index) => (
        <div class="w-1/4 inline-flex items-center justify-center gap-2 text-center py-3 relative z-10 h-full">
          <a
            href={item.href}
            class="resume-btn flex items-center justify-center gap-2 w-full h-full"
            data-index={index}
          >
            <p class="text-xl font-semibold text-primary">{item.count}</p>
            <p class="text-sm text-neutral-600">{item.name}</p>
          </a>
        </div>
      ))
    }
    <div
      class="absolute bg-bg-primary rounded-full border border-border-light inset-0 w-1/4 h-full shadow-md transition-all duration-300 pointer-events-none resume-indicator"
    >
    </div>
  </div>

  <a
    slot="footer-link"
    class="hover:underline flex items-center gap-1 group"
    href="#"
  >
    <span>Ver todos los detalles</span>
    <ArrowIcon
      class="inline-block w-4 h-4 group-hover:ml-1 transition-all duration-300"
    />
  </a>
</SectionContainer>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const resumeButtons = document.querySelectorAll(".resume-btn");
    const resumeIndicator = document.querySelector(
      ".resume-indicator",
    ) as HTMLElement;

    resumeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const index = parseInt((button as HTMLElement).dataset.index || "0");
        const translateValue = index * 100; // 0%, 100%, 200%, 300%

        if (resumeIndicator) {
          resumeIndicator.style.transform = `translateX(${translateValue}%)`;
        }
      });
    });
  });
</script>
