---
import SearchIcon from "@/assets/SearchIcon.astro";
import PlusIcon from "@/assets/PLusIcon.astro";
---

<div class="flex justify-end">
  <!-- Buscador -->
  <div class="relative flex items-center w-full max-w-lg">
    <SearchIcon
      class="absolute left-4 w-5 aspect-square block text-text-secondary pointer-events-none"
    />
    <div class="content-input w-full">
      <input
        type="text"
        id="search-brothers-input"
        placeholder="Buscar hermano..."
        class="search-input"
        autocomplete="off"
      />
    </div>
    <button
      class="absolute right-4 w-8 aspect-square border-none bg-gray-200 rounded-full items-center justify-center cursor-pointer text-text-secondary transition-all duration-200 hover:bg-gray-300 hover:text-text-purple-500 hidden clear-search-btn"
      id="clear-search-btn"
      title="Limpiar búsqueda"
    >
      <PlusIcon class="w-4 h-4 transform rotate-45" />
    </button>
  </div>
</div>

<style>
  .search-input {
    padding: 0.75rem 3rem 0.75rem 3rem;
    border: 2px solid var(--color-border-light);
    border-radius: 9999px;
    font-size: 0.95rem;
    color: #374151;
    background: white;
    transition: all 0.2s ease;
    outline: none;
  }

  .search-input:focus {
    border-color: var(--color-border-dark);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }

  .search-input::placeholder {
    color: var(--color-text-light);
  }

  .clear-search-btn {
    display: flex;
  }

  .clear-search-btn.hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const searchInput = document.getElementById(
      "search-brothers-input",
    ) as HTMLInputElement | null;
    const clearBtn = document.getElementById(
      "clear-search-btn",
    ) as HTMLButtonElement | null;

    if (!searchInput) return;

    // Tabla de hermanos invitados en ConvivenciasDashboard
    const invitedSection = document.getElementById("invited-brothers");
    const table = invitedSection?.querySelector("table");

    if (!table) return;

    const applyFilter = () => {
      const term = searchInput.value.toLowerCase().trim();
      const rows = table.querySelectorAll("tbody tr");

      rows.forEach((row) => {
        const parishCell =
          row.querySelector("td:nth-child(1)")?.textContent?.toLowerCase() ||
          "";
        const communityCell =
          row.querySelector("td:nth-child(2)")?.textContent?.toLowerCase() ||
          "";
        const nameCell =
          row.querySelector("td:nth-child(3)")?.textContent?.toLowerCase() ||
          "";

        const matches =
          term === "" ||
          parishCell.includes(term) ||
          communityCell.includes(term) ||
          nameCell.includes(term);

        (row as HTMLElement).style.display = matches ? "" : "none";
      });
    };

    // Escuchar cambios mientras se escribe
    searchInput.addEventListener("input", () => {
      if (searchInput.value.trim() !== "") {
        clearBtn?.classList.remove("hidden");
      } else {
        clearBtn?.classList.add("hidden");
      }
      applyFilter();
    });

    // Botón para limpiar búsqueda
    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      clearBtn.classList.add("hidden");
      searchInput.focus();
      applyFilter();
    });
  });
</script>
