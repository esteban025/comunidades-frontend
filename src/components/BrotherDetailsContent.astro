---
// Componente para renderizar detalles del hermano (Server-Side)
interface Props {
  brother: any;
}

const { brother } = Astro.props;

function formatRole(role: string): string {
  const roles: Record<string, string> = {
    responsable: "Responsable",
    corresponsable: "Corresponsable",
    didascala: "Didascala",
    ostiario: "Ostiario",
  };
  return roles[role] || role;
}

function formatCivilStatus(status: string): string {
  const statuses: Record<string, string> = {
    matrimonio: "Matrimonio",
    soltero: "Soltero",
    soltera: "Soltera",
  };
  return statuses[status] || status;
}
---

<div class="detail-section">
  <h3 class="section-title">Información Personal</h3>
  <div class="detail-row">
    <span class="detail-label">Nombre(s):</span>
    <span class="detail-value">{brother.names}</span>
  </div>
  <div class="detail-row">
    <span class="detail-label">Estado Civil:</span>
    <span class="detail-value">{formatCivilStatus(brother.civil_status)}</span>
  </div>
  <div class="detail-row">
    <span class="detail-label">Teléfono:</span>
    <span class="detail-value">{brother.phone || "Sin teléfono"}</span>
  </div>
</div>

<div class="detail-section">
  <h3 class="section-title">Comunidad</h3>
  <div class="detail-row">
    <span class="detail-label">Parroquia:</span>
    <span class="detail-value"
      >{brother.parish?.name || "N/A"} ({brother.parish?.aka || "N/A"})</span
    >
  </div>
  <div class="detail-row">
    <span class="detail-label">Comunidad:</span>
    <span class="detail-value">{brother.community?.number || "N/A"}</span>
  </div>
  <div class="detail-row">
    <span class="detail-label">Nivel/Paso:</span>
    <span class="detail-value"
      >{brother.community?.level_paso || "Sin especificar"}</span
    >
  </div>
</div>

<div class="detail-section">
  <h3 class="section-title">Roles en su Comunidad</h3>
  <div class="roles-list">
    {
      brother.roles_in_own_community?.length > 0 ? (
        brother.roles_in_own_community.map((role: string) => (
          <span class={`role-badge ${role}`}>{formatRole(role)}</span>
        ))
      ) : (
        <span class="text-gray-500 italic">Sin roles</span>
      )
    }
  </div>
</div>

<div class="detail-section">
  <h3 class="section-title">Catequista de Comunidades</h3>
  {
    brother.catechist_of_communities?.length > 0 ? (
      brother.catechist_of_communities.map((comm: any) => (
        <div class="catechist-community">
          <strong>{comm.parish_aka}</strong> - Comunidad {comm.community_number}
        </div>
      ))
    ) : (
      <span class="text-gray-500 italic">No es catequista</span>
    )
  }
</div>
