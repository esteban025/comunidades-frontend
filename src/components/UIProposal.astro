---
// Propuesta de UI moderna con escala de grises y sombras
// Datos estáticos de ejemplo para visualización
---

<section class="ui-proposal-container">
  <!-- Stats Cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">👥</div>
      <div class="stat-content">
        <span class="stat-label">Total Hermanos</span>
        <span class="stat-value">127</span>
      </div>
      <div class="stat-trend positive">+12%</div>
    </div>

    <div class="stat-card">
      <div class="stat-icon">⛪</div>
      <div class="stat-content">
        <span class="stat-label">Parroquias</span>
        <span class="stat-value">8</span>
      </div>
      <div class="stat-trend neutral">—</div>
    </div>

    <div class="stat-card">
      <div class="stat-icon">🏘️</div>
      <div class="stat-content">
        <span class="stat-label">Comunidades</span>
        <span class="stat-value">24</span>
      </div>
      <div class="stat-trend positive">+3</div>
    </div>

    <div class="stat-card">
      <div class="stat-icon">📚</div>
      <div class="stat-content">
        <span class="stat-label">Catequistas</span>
        <span class="stat-value">18</span>
      </div>
      <div class="stat-trend neutral">—</div>
    </div>
  </div>

  <!-- Table Proposal -->
  <div class="table-container">
    <div class="table-header">
      <h2 class="table-title">Hermanos Registrados</h2>
      <div class="table-controls">
        <input
          type="text"
          class="search-input"
          placeholder="Buscar hermano..."
        />
        <select class="filter-select">
          <option>Todas las parroquias</option>
          <option>Parroquia A</option>
          <option>Parroquia B</option>
        </select>
      </div>
    </div>

    <div class="modern-table">
      <table>
        <thead>
          <tr>
            <th class="col-name">
              <div class="th-content">
                <span>Nombre Completo</span>
                <span class="sort-icon">↕</span>
              </div>
            </th>
            <th class="col-parish">
              <div class="th-content">
                <span>Parroquia</span>
                <span class="sort-icon">↕</span>
              </div>
            </th>
            <th class="col-community">
              <div class="th-content">
                <span>Comunidad</span>
                <span class="sort-icon">↕</span>
              </div>
            </th>
            <th class="col-contact">
              <div class="th-content">
                <span>Contacto</span>
              </div>
            </th>
            <th class="col-roles">
              <div class="th-content">
                <span>Servicios</span>
              </div>
            </th>
            <th class="col-status">
              <div class="th-content">
                <span>Estado</span>
              </div>
            </th>
            <th class="col-actions">
              <div class="th-content">
                <span>Acciones</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <!-- Row 1 -->
          <tr class="table-row">
            <td class="col-name">
              <div class="name-cell">
                <div class="avatar">JD</div>
                <div class="name-info">
                  <span class="name-primary">Juan David Pérez</span>
                  <span class="name-secondary">Matrimonio</span>
                </div>
              </div>
            </td>
            <td class="col-parish">
              <span class="parish-badge">San Pedro</span>
            </td>
            <td class="col-community">
              <span class="community-number">#12</span>
            </td>
            <td class="col-contact">
              <div class="contact-info">
                <span class="contact-item">📱 555-0123</span>
                <span class="contact-item secondary">juan@email.com</span>
              </div>
            </td>
            <td class="col-roles">
              <div class="roles-list">
                <span class="role-badge primary">Responsable</span>
                <span class="role-badge secondary">Didascala</span>
              </div>
            </td>
            <td class="col-status">
              <span class="status-badge active">Activo</span>
            </td>
            <td class="col-actions">
              <div class="action-buttons">
                <button class="action-btn" title="Ver detalles">👁️</button>
                <button class="action-btn" title="Editar">✏️</button>
                <button class="action-btn" title="Más opciones">⋯</button>
              </div>
            </td>
          </tr>

          <!-- Row 2 -->
          <tr class="table-row">
            <td class="col-name">
              <div class="name-cell">
                <div class="avatar">MG</div>
                <div class="name-info">
                  <span class="name-primary">María González</span>
                  <span class="name-secondary">Soltera</span>
                </div>
              </div>
            </td>
            <td class="col-parish">
              <span class="parish-badge">Catedral</span>
            </td>
            <td class="col-community">
              <span class="community-number">#8</span>
            </td>
            <td class="col-contact">
              <div class="contact-info">
                <span class="contact-item">📱 555-0456</span>
                <span class="contact-item secondary">maria@email.com</span>
              </div>
            </td>
            <td class="col-roles">
              <div class="roles-list">
                <span class="role-badge catechist">Catequista (3)</span>
              </div>
            </td>
            <td class="col-status">
              <span class="status-badge active">Activo</span>
            </td>
            <td class="col-actions">
              <div class="action-buttons">
                <button class="action-btn" title="Ver detalles">👁️</button>
                <button class="action-btn" title="Editar">✏️</button>
                <button class="action-btn" title="Más opciones">⋯</button>
              </div>
            </td>
          </tr>

          <!-- Row 3 -->
          <tr class="table-row">
            <td class="col-name">
              <div class="name-cell">
                <div class="avatar">CR</div>
                <div class="name-info">
                  <span class="name-primary">Carlos Rodríguez</span>
                  <span class="name-secondary">Matrimonio</span>
                </div>
              </div>
            </td>
            <td class="col-parish">
              <span class="parish-badge">San Pedro</span>
            </td>
            <td class="col-community">
              <span class="community-number">#5</span>
            </td>
            <td class="col-contact">
              <div class="contact-info">
                <span class="contact-item">📱 555-0789</span>
                <span class="contact-item secondary">—</span>
              </div>
            </td>
            <td class="col-roles">
              <div class="roles-list">
                <span class="role-badge secondary">Ostiario</span>
              </div>
            </td>
            <td class="col-status">
              <span class="status-badge active">Activo</span>
            </td>
            <td class="col-actions">
              <div class="action-buttons">
                <button class="action-btn" title="Ver detalles">👁️</button>
                <button class="action-btn" title="Editar">✏️</button>
                <button class="action-btn" title="Más opciones">⋯</button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="table-footer">
      <span class="results-info">Mostrando 1-10 de 127 hermanos</span>
      <div class="pagination">
        <button class="page-btn" disabled>← Anterior</button>
        <button class="page-btn active">1</button>
        <button class="page-btn">2</button>
        <button class="page-btn">3</button>
        <span class="page-dots">...</span>
        <button class="page-btn">13</button>
        <button class="page-btn">Siguiente →</button>
      </div>
    </div>
  </div>

  <!-- Card Grid Alternative -->
  <div class="card-grid-container">
    <div class="section-header-alt">
      <h2 class="section-title">Vista de Tarjetas</h2>
      <p class="section-description">
        Alternativa visual para mostrar información
