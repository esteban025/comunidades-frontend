          </div>
          <button class="card-action">Ver más →</button>
        </div>
      </article>

      <!-- Card 3 -->
      <article class="info-card">
        <div class="card-header">
          <div class="card-avatar">CR</div>
          <div class="card-title-group">
            <h3 class="card-title">Carlos Rodríguez</h3>
