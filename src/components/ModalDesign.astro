---
interface Props {
  id: string;
  idForm?: string;
  title: string;
  isForm?: boolean;
}

const { id, idForm, title, isForm = false } = Astro.props;
---

<div
  id={id}
  class="modal-overlay hidden fixed inset-0 z-50 bg-black/80 items-center justify-center p-4 backdrop-blur-md"
>
  <div class="modal-container w-full max-w-[700px] rounded-2xl overflow-hidden">
    <div class="modal-content bg-white shadow-lg">
      <header
        class="modal-header flex justify-between items-center p-6 border-b-2 border-neutral-300"
      >
        <h2 class="modal-title text-xl font-bold text-neutral-700 m-0">
          {title}
        </h2>
        <button
          class="modal-close bg-transparent border-none cursor-pointer p-2 flex items-center justify-center rounded-full transition-all duration-300 hover:bg-gray-100"
          data-close={id}
        >
          <span class="modal-close-icon text-2xl text-gray-500 leading-none"
            >✕</span
          >
        </button>
      </header>

      {
        isForm ? (
          <div class="modal-body">
            <form id={idForm}>
              <div class="p-6 flex flex-col gap-5">
                <slot name="body" />
              </div>
              <footer class="modal-footer flex gap-3 mt-2 border-t-2 border-neutral-300 p-6">
                <slot name="footer" />
              </footer>
            </form>
          </div>
        ) : (
          <div class="modal-body">
            <div class="ss">
              <slot name="body" />
            </div>
            <footer class="modal-footer flex gap-3 border-t-2 border-neutral-300 p-6">
              <slot name="footer" />
            </footer>
          </div>
        )
      }
    </div>
  </div>
</div>

<style is:global>
  .modal-overlay.hidden {
    display: none;
  }

  .modal-overlay {
    display: flex;
  }

  .modal-container {
    animation: modalSlideIn 0.3s ease-out;
    max-height: 90vh;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .modal-content {
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  @keyframes modalSlideIn {
    from {
      transform: translateY(-20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Secciones del formulario */
  .form-section {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .form-section:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 1.25rem 0;
  }

  /* Radio buttons */
  .radio-group {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .radio-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.625rem 1.25rem;
    border: 2px solid #e5e7eb;
    border-radius: 9999px;
    transition: all 0.2s ease;
    background-color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .radio-label:hover {
    border-color: #9ca3af;
    background-color: #f9fafb;
  }

  .radio-label input[type="radio"] {
    accent-color: #374151;
    cursor: pointer;
  }

  .radio-label:has(input[type="radio"]:checked) {
    border-color: var(--color-gray-300);
    background-color: color-mix(
      in oklab,
      var(--color-gray-100),
      transparent 40%
    );
  }

  .radio-label input[type="radio"]:checked + span {
    font-weight: 600;
    color: #1f2937;
  }

  /* Checkboxes */
  .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    transition: background-color 0.2s ease;
    font-size: 0.875rem;
  }

  .checkbox-label:hover {
    background-color: #f9fafb;
  }

  .checkbox-label input[type="checkbox"] {
    width: 1.125rem;
    height: 1.125rem;
    cursor: pointer;
    accent-color: #374151;
    border-radius: 0.25rem;
  }

  /* Mensajes informativos */
  .info-message {
    padding: 0.875rem 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    margin-top: 0.75rem;
    font-weight: 500;
  }

  .info-message.success {
    background-color: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  .info-message.warning {
    background-color: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
  }

  /* Botón agregar */
  .btn-add {
    padding: 0.5rem 1rem;
    background-color: #f9fafb;
    border: 1px solid #d1d5db;
    border-radius: 9999px;
    font-size: 0.813rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #374151;
  }

  .btn-add:hover {
    background-color: #e5e7eb;
    border-color: #9ca3af;
  }

  /* Items de catequista */
  .catechist-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    margin-bottom: 0.75rem;
  }

  .catechist-item-fields {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .catechist-item-fields select,
  .catechist-item-fields input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 9999px;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .catechist-item-fields select:focus,
  .catechist-item-fields input:focus {
    outline: none;
    border-color: #9ca3af;
  }

  /* Botón remover */
  .btn-remove {
    padding: 0.5rem 0.75rem;
    background-color: #fee2e2;
    border: 1px solid #fecaca;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #991b1b;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1;
    min-width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-remove:hover {
    background-color: #fecaca;
    border-color: #fca5a5;
  }

  /* Utilidades */
  .hidden {
    display: none;
  }

  /* Input con contenido */
  input:not(:placeholder-shown),
  textarea:not(:placeholder-shown),
  select:has(option:checked:not([value=""])) {
    border-color: var(--color-border-dark);
    background-color: color-mix(
      in oklab,
      var(--color-gray-100),
      transparent 40%
    );
  }

  /* Estilos para select */
  .select-input {
    width: 100%;
    padding: 0.75rem 2.5rem 0.75rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    background-color: #ffffff;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .select-input::picker-icon {
    display: none;
  }

  .select-input:hover {
    border-color: #9ca3af;
  }

  .select-input:focus {
    outline: none;
    border-color: #6b7280;
    box-shadow: 0 0 0 3px rgba(107, 114, 128, 0.1);
  }

  .options-select {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: #374151;
    background-color: color-mix(
      in oklab,
      var(--color-gray-100),
      transparent 60%
    );
    border-radius: 1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .options-select:hover {
    background-color: var(--color-gray-100);
  }

  /* Opción deshabilitada (placeholder) */
  .options-select:disabled,
  option[disabled] {
    color: #9ca3af;
    font-style: italic;
    background-color: #f9fafb;
    cursor: not-allowed;
  }

  ::picker(select) {
    appearance: base-select;
    padding: 0.75rem;
    border: 2px solid #e5e7eb;
    border-radius: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    background-color: #ffffff;
  }

  /* select - no eliminar esta instruccion */
  .select-input,
  ::picker(select) {
    appearance: base-select;
  }
</style>
