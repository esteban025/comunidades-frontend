---
interface Props {
  id: string;
  idForm?: string;
  title: string;
  isForm?: boolean;
  isBig?: boolean;
}

const { id, idForm, title, isForm = false, isBig = false } = Astro.props;
const widthContainer = isBig ? "max-w-[1000px]" : "max-w-[700px]";
---

<div
  id={id}
  class="modal-overlay fixed hidden inset-0 z-50 bg-black/80 items-center justify-center p-4 backdrop-blur-md"
>
  <div
    class:list={[
      "modal-container w-full  rounded-2xl overflow-hidden",
      widthContainer,
    ]}
  >
    <div class="modal-content bg-white shadow-lg">
      <header
        class="modal-header sticky top-0 flex justify-between items-center p-6 border-b-2 border-neutral-300 bg-white z-50"
      >
        <h2 class="modal-title text-xl font-bold text-neutral-700 m-0">
          {title}
        </h2>
        <button
          class="modal-close bg-transparent border-none cursor-pointer p-2 flex items-center justify-center rounded-full transition-all duration-300 hover:bg-gray-100"
          data-close={id}
        >
          <span class="modal-close-icon text-2xl text-gray-500 leading-none"
            >✕</span
          >
        </button>
      </header>

      {
        isForm ? (
          <div class="modal-body">
            <form id={idForm}>
              <div class="p-6 flex flex-col gap-5 border-b-2 border-neutral-300 ">
                <slot name="body" />
              </div>
              <footer class="modal-footer flex gap-3 p-6 max-w-[700px] mx-auto">
                <slot name="footer" />
              </footer>
            </form>
          </div>
        ) : (
          <div class="modal-body">
            <div class="border-b-2 border-neutral-300 p-6 flex">
              <slot name="body" />
            </div>
            <footer class="modal-footer flex gap-3 p-6 max-w-[700px] mx-auto">
              <slot name="footer" />
            </footer>
          </div>
        )
      }
    </div>
  </div>
</div>
