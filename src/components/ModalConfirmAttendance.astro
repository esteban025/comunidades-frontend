---
import ModalDesign from "./ModalDesign.astro";
---

<ModalDesign
  title="Confirmar asistencia"
  id="modal-confirm-attendance"
  isForm
  idForm="modal-confirm-attendance-form"
>
  <article slot="body" class="flex flex-col gap-3">
    <p class="text-sm text-neutral-700">
      Puedes escribir alguna observación para este hermano (por ejemplo, tercera
      edad, va con bebé, etc.). Este campo es opcional.
    </p>

    <div class="content-input">
      <textarea
        id="confirm-observations-input"
        class="input no-rounded"
        placeholder="Escribe aquí las observaciones (opcional)"></textarea>
    </div>
  </article>

  <button
    type="button"
    slot="footer"
    class="flex-1 btn btn-secondary"
    data-close="modal-confirm-attendance"
  >
    Cancelar
  </button>

  <button type="submit" slot="footer" class="flex-1 btn btn-primary">
    Confirmar asistencia
  </button>
</ModalDesign>

<script>
  import { setupModalCloseHandlers } from "@/scripts/modalClose";

  document.addEventListener("astro:page-load", () => {
    const $id = (selector: string) => document.getElementById(selector);

    const modal = $id("modal-confirm-attendance");
    const form = $id("modal-confirm-attendance-form") as HTMLFormElement | null;
    const input = $id(
      "confirm-observations-input",
    ) as HTMLTextAreaElement | null;

    if (!modal || !form || !input) return;

    let convivenciaId: string | null = null;
    let primaryBrotherId: string | null = null;
    let spouseId: string | null = null;
    let isMarriage = false;
    let mode: "confirm" | "edit" = "confirm";

    const openConfirmAttendanceModal = (
      convId: string,
      brotherId: string,
      spouseIdParam?: string | null,
      initialObservations?: string | null,
      modeParam?: "confirm" | "edit",
    ) => {
      convivenciaId = convId;
      primaryBrotherId = brotherId;
      spouseId = spouseIdParam || null;
      isMarriage = !!spouseId;

      mode = modeParam || "confirm";

      input.value = initialObservations ? String(initialObservations) : "";

      const submitButton = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (submitButton) {
        submitButton.textContent =
          mode === "edit" ? "Guardar" : "Confirmar asistencia";
      }

      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";

      input.focus();
    };

    const closeConfirmAttendanceModal = () => {
      convivenciaId = null;
      primaryBrotherId = null;
      spouseId = null;
      isMarriage = false;
      mode = "confirm";

      modal.classList.add("hidden");
      document.body.style.overflow = "";

      input.value = "";

      const submitButton = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Confirmar asistencia";
      }
    };

    setupModalCloseHandlers("modal-confirm-attendance", () => {
      closeConfirmAttendanceModal();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      if (!convivenciaId || !primaryBrotherId) return;

      const submitButton = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;

      if (!submitButton) return;

      submitButton.disabled = true;
      submitButton.textContent =
        mode === "edit" ? "Guardando..." : "Confirmando...";

      const observations =
        input.value.trim() !== "" ? input.value.trim() : null;

      try {
        const idsToConfirm: string[] = [];

        if (isMarriage && spouseId) {
          // En esta etapa solo confirmamos que asistirán a la convivencia.
          // Para matrimonios, siempre confirmamos a ambos esposos juntos.
          idsToConfirm.push(primaryBrotherId!, spouseId);
        } else {
          idsToConfirm.push(primaryBrotherId!);
        }

        for (const id of idsToConfirm) {
          const res = await fetch(
            `/api/convivencias/${convivenciaId}/attendees`,
            {
              method: mode === "edit" ? "PUT" : "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                brother_id: Number(id),
                observations,
              }),
            },
          );

          if (!res.ok) {
            console.error("Error al confirmar asistencia", await res.text());
            submitButton.disabled = false;
            submitButton.textContent =
              mode === "edit" ? "Guardar" : "Confirmar asistencia";
            return;
          }
        }

        closeConfirmAttendanceModal();

        setTimeout(() => {
          window.location.reload();
        }, 400);
      } catch (err) {
        console.error("Error de red al confirmar asistencia", err);
        submitButton.disabled = false;
        submitButton.textContent = "Confirmar asistencia";
      }
    });

    (window as any).openConfirmAttendanceModal = openConfirmAttendanceModal;
  });
</script>
