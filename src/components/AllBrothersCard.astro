---
import Card from "./CardResume.astro";
import UserIcon from "@/assets/UserIcon.astro";
import { getTotalBrothers } from "@/lib/stats";

const totalBrothers = await getTotalBrothers();
---

<Card count={totalBrothers} title="Hermanos" dataCardName="all-brothers">
  <UserIcon class="w-12 aspect-square text-neutral-400" />
</Card>
