---
import NavbarPage from "./NavbarPage.astro";
import PlusIcon from "@/assets/PLusIcon.astro";
---

<NavbarPage
  {...Astro.props}
  title="Sistema de convivencias"
  description="Podemos crear o gestionar nuevas convivencias"
>
  <div class="flex flex-wrap gap-2 transition-all duration-500" slot="actions">
    <button
      class="btn btn-primary navbar-btn text-sm"
      data-modal="create-convivencia"
    >
      <div class="flex items-center gap-2">
        <span class="navbar-btn-icon">
          <PlusIcon class="w-4 aspect-square block" />
        </span>
        <span class="navbar-btn-text">Nueva Convivencia</span>
      </div>
    </button>

    <button
      class="btn btn-secondary navbar-btn text-sm"
      data-modal="gestion-convivencia"
    >
      <div class="flex items-center gap-2">
        <span class="navbar-btn-icon">
          <PlusIcon class="w-4 aspect-square block" />
        </span>
        <span class="navbar-btn-text">Gestionar convivencia</span>
      </div>
    </button>
  </div>
</NavbarPage>
<script>
  document.addEventListener("astro:page-load", () => {
    const navbarButtons = document.querySelectorAll(".navbar-btn");

    navbarButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const modalType = button.getAttribute("data-modal");

        if (modalType === "create-convivencia") {
          if (
            typeof (window as any).openCreateConvivenciaModal === "function"
          ) {
            (window as any).openCreateConvivenciaModal();
          } else {
            console.log("openBrotherModal no está disponible");
          }
        } else if (modalType === "parish") {
          if (typeof (window as any).openParishModal === "function") {
            (window as any).openParishModal();
          } else {
            console.log("openParishModal no está disponible");
          }
        }
      });
    });
  });
</script>
