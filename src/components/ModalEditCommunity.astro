---
import ModalDesign from "./ModalDesign.astro";
import { pasosListaPlana } from "@/datos/pasos-list";
---

<ModalDesign
  id="modal-edit-community"
  title="Editar Paso de la Comunidad"
  isForm={true}
  idForm="form-edit-community"
>
  <div class="flex flex-col gap-4 w-full" slot="body">
    <p class="text-sm text-text-muted" id="edit-community-header">Comunidad</p>

    <input type="hidden" id="edit-community-id" />
    <input type="hidden" id="edit-community-number" />

    <div class="content-input">
      <label for="edit-level-paso">Paso de la comunidad</label>
      <select
        name="edit-level-paso"
        id="edit-level-paso"
        class="select-input"
        required
      >
        <option value="" disabled selected>Selecciona un paso</option>
        {
          pasosListaPlana.map((paso) => (
            <option class="options-select" value={paso}>
              {paso}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-edit-community"
    slot="footer"
  >
    Cancelar
  </button>
  <button
    type="submit"
    form="form-edit-community"
    class="btn btn-primary flex-1"
    slot="footer"
  >
    Guardar cambios
  </button>
</ModalDesign>

<script>
  import { showNotification } from "@/scripts/notification";
  import { setupModalCloseHandlers } from "@/scripts/modalClose";

  document.addEventListener("astro:page-load", () => {
    const $ = (selector: string) => document.getElementById(selector);
    const modal = $("modal-edit-community") as HTMLDivElement;
    const form = $("form-edit-community") as HTMLFormElement;
    const header = $("edit-community-header") as HTMLParagraphElement;
    const inputId = $("edit-community-id") as HTMLInputElement;
    const inputNumber = $("edit-community-number") as HTMLInputElement;
    const inputPaso = $("edit-level-paso") as HTMLInputElement;

    if (!modal || !form || !header || !inputId || !inputNumber || !inputPaso)
      return;

    function closeEditCommunityModal() {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
      form.reset();
    }

    async function handleSubmit(event: SubmitEvent) {
      event.preventDefault();

      const id = inputId.value;
      const number = inputNumber.value;
      const paso = inputPaso.value.trim();

      if (!id || !number) {
        showNotification(
          "No se pudo determinar la comunidad a actualizar.",
          "error",
          4000,
        );
        return;
      }

      if (!paso) {
        showNotification("El paso no puede estar vacío.", "error", 4000);
        return;
      }

      try {
        const res = await fetch(`/api/communities/${id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            number_community: Number(number),
            level_paso: paso,
          }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          showNotification(
            data.error || "Error al actualizar la comunidad.",
            "error",
            5000,
          );
          return;
        }

        showNotification("Paso de la comunidad actualizado.", "success", 4000);
        closeEditCommunityModal();
        window.location.reload();
      } catch (error) {
        console.error("Error actualizando comunidad:", error);
        showNotification("Error de red al actualizar la comunidad.", "error");
      }
    }

    async function openEditCommunityModal(
      communityId: string,
      communityNumber: string,
      levelPaso: string,
    ) {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";

      inputId.value = communityId;
      inputNumber.value = communityNumber;
      inputPaso.value = levelPaso || "";
      header.textContent = `Comunidad ${communityNumber}`;
    }

    setupModalCloseHandlers("modal-edit-community", () => {
      closeEditCommunityModal();
    });

    form.addEventListener("submit", handleSubmit);

    (window as any).openEditCommunityModal = openEditCommunityModal;
  });
</script>
