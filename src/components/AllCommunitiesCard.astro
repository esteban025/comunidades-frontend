---
import Card from "./CardResume.astro";
import HomeIcon from "@/assets/HomeIcon.astro";
import { getTotalCommunities } from "@/lib/stats";

const totalCommunities = await getTotalCommunities();
---

<Card
  count={totalCommunities}
  title="Comunidades"
  dataCardName="all-communities"
>
  <HomeIcon class="w-12 aspect-square text-neutral-400" />
</Card>
