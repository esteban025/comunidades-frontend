---
import ModalDesign from "./ModalDesign.astro";
import CheckIcon from "@/assets/CheckIcon.astro";
import type { Parish } from "@/types/parishes";
import { getParishes } from "@/services/parishes";
const parishes: Parish[] = await getParishes();
---

<ModalDesign
  id="modal-create-convi"
  title="Crear nueva convivencia"
  idForm="modal-convi-form"
  isForm
>
  <article slot="body" class="flex flex-col gap-6">
    <fieldset class="container-fieldset">
      <legend class="title-container">Información básica</legend>
      <div class="container-content flex flex-col gap-4">
        <div class="name content-input">
          <label for="name-convi">Nombre</label>
          <input
            type="text"
            name="name-convi"
            id="name-convi"
            placeholder="Convivencia de transimicion - 2025"
            autocomplete="off"
          />
        </div>

        <div class="description content-input">
          <label for="description-convi">Description (Optional)</label>
          <input
            type="text"
            name="description-convi"
            id="description-convi"
            placeholder="Convivencia en la ..."
            autocomplete="off"
          />
        </div>
        <div class="flex items-center gap-2">
          <div class="date-start flex-1 content-input">
            <label for="date-start">Fecha de inicio</label>
            <input type="date" name="date-start" id="date-start" />
          </div>
          <div class="date-end flex-1 content-input">
            <label for="date-end">Fecha final</label>
            <input type="date" name="date-end" id="date-end" />
          </div>
        </div>
      </div>
    </fieldset>

    <!-- informacion de comunidades -->
    <fieldset class="container-fieldset">
      <legend class="title-container">Selección de comunidades</legend>
      <div class="p-2 rounded-2xl space-y-4">
        <div class="parishes-content">
          <div class="content-input">
            <label for="parishes-select">Seleccione una parroquia</label>
            <select
              class="select-input space-y-1"
              name="parishes-select"
              id="parishes-select"
            >
              <option class="options-select" value="" disabled selected
                >Todas las parroquias</option
              >
              {
                parishes?.map((parish) => (
                  <option class="options-select" value={parish.id}>
                    {parish.aka} ({parish.tag})
                  </option>
                ))
              }
            </select>
          </div>
        </div>

        <div class="communities-available">
          <h4 class="similar-label">Comunidades disponibles</h4>
          <div
            id="communities-container"
            class="comunidades grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-3 p-3 border relative border-border-medium rounded-3xl bg-gray-100 min-h-30"
          >
            <p
              id="communities-placeholder"
              class="col-span-full text-sm text-text-muted flex justify-center items-center"
            >
              Seleccione primero una parroquia
            </p>
          </div>
        </div>
      </div>
      <div class="w-full flex justify-center items-center gap-2">
        <button
          id="btn-invitar-communities"
          class="btn btn-primary flex items-center gap-2 min-w-40 justify-center"
        >
          <CheckIcon class="size-5 block" />
          <span>Invitar</span>
        </button>
      </div>
    </fieldset>

    <div id="invited-list-section" class="list-invi hidden">
      <h4>
        Lista de Comunidades convocadas (Oculta hasta que hayan selecciones)
      </h4>
      <div
        id="invited-list"
        class="p-3 border border-border-medium rounded-3xl bg-gray-100 min-h-20 flex flex-col gap-2"
      >
      </div>
    </div>
  </article>
  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-create-convi"
    slot="footer"
  >
    Cancelar
  </button>
  <button
    type="submit"
    class="btn btn-primary flex-1"
    id="modal-parish-submit"
    slot="footer"
  >
    Crear Convivencia
  </button>
</ModalDesign>
<script>
  import { setupModalCloseHandlers } from "@/scripts/modalClose";

  document.addEventListener("astro:page-load", () => {
    const $id = (selector: string) => document.getElementById(selector);
    const $ = (selector: string) => document.querySelector(selector);
    const $$ = (selector: string) => document.querySelectorAll(selector);

    const modal = $id("modal-create-convi");
    const form = $id("modal-convi-form") as HTMLFormElement;
    const parishSelect = $id("parishes-select") as HTMLSelectElement | null;
    const communitiesContainer = $id(
      "communities-container",
    ) as HTMLDivElement | null;
    const communitiesPlaceholder = $id(
      "communities-placeholder",
    ) as HTMLParagraphElement | null;
    const invitedListSection = $id(
      "invited-list-section",
    ) as HTMLDivElement | null;
    const invitedList = $id("invited-list") as HTMLDivElement | null;
    const btnInvitar = $id(
      "btn-invitar-communities",
    ) as HTMLButtonElement | null;

    const modalTitle = modal?.querySelector(
      ".modal-title",
    ) as HTMLHeadingElement | null;
    const submitButton = $id("modal-parish-submit") as HTMLButtonElement | null;

    let mode: "create" | "edit" = "create";
    let editingConvivenciaId: string | null = null;

    type CommunityItem = {
      id: number;
      number_community: number;
      level_paso?: string | null;
      total_brothers: number;
      parish_id: number;
      parish_name: string;
      parish_aka: string;
      responsible_name?: string | null;
    };

    // Estado interno: comunidades seleccionadas por ID
    const selectedCommunities = new Map<number, CommunityItem>();

    function createCommunityCardHTML(item: CommunityItem) {
      const isChecked = selectedCommunities.has(item.id) ? "checked" : "";

      return `
        <article class="p-2 rounded-2xl bg-white shadow-sm border border-border-medium">
          <header class="flex justify-between items-center gap-2 pb-2 border-b border-border-medium">
            <h3 class="text-sm font-semibold">Comunidad</h3>
            <p class="size-10 flex items-center justify-center rounded-full bg-gray-400 text-white">
              <span class="block leading-1 font-semibold">${item.number_community}</span>
            </p>
          </header>
          <div class="details flex items-center justify-between gap-1 p-2">
            <div class="w-full overflow-hidden">
              <p class="font-semibold text-lg truncate">${
                item.responsible_name || "Sin responsable asignado"
              }</p>
              <p class="text-sm text-text-muted">${
                item.level_paso || "Nivel de paso no especificado"
              }</p>
            </div>
            <div class="relative">
              <label class="relative flex size-12 items-center justify-center overflow-hidden rounded-full bg-linear-to-tr from-gray-300 to-gray-400 p-1.5 cursor-pointer hover:p-2 duration-300">
                <input type="checkbox" class="group peer hidden community-checkbox" data-community-id="${
                  item.id
                }" ${isChecked} />
                <span class="size-full rounded-full bg-white peer-checked:scale-0 transition-all duration-300"></span>
                <span class="w-8 aspect-square block text-white absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 transition-all duration-300 peer-checked:opacity-100 text-[20px] text-center">✔</span>
              </label>
            </div>
          </div>
        </article>
      `;
    }

    function createInvitedRowHTML(item: CommunityItem) {
      return `
        <div class="p-2 bg-white flex justify-between items-center gap-2 rounded-full border border-border-medium">
          <div class="flex items-center gap-2">
            <p class="size-10 flex items-center justify-center rounded-full bg-gray-500 text-white">
              <span class="block leading-1 font-semibold">${
                item.number_community
              }</span>
            </p>
            <p class="font-semibold truncate">${item.responsible_name || "Sin responsable asignado"}</p>
          </div>
          <div class="pr-2">
            <p class="text-sm text-text-muted">${item.parish_aka || item.parish_name}</p>
          </div>
        </div>
      `;
    }

    function resetCommunitiesUI() {
      if (communitiesContainer) {
        communitiesContainer.innerHTML = "";
        if (communitiesPlaceholder) {
          communitiesContainer.appendChild(communitiesPlaceholder);
          communitiesPlaceholder.textContent =
            "Seleccione primero una parroquia";
        }
      }
    }

    function renderCommunities(parishId: number) {
      if (!communitiesContainer) return;

      communitiesContainer.innerHTML =
        '<p class="col-span-full text-sm text-text-muted flex justify-center items-center">Cargando comunidades...</p>';

      fetch(`/api/communities-by-parish/${parishId}`)
        .then((res) => res.json())
        .then((result) => {
          if (!result.success || !result.data || result.data.length === 0) {
            communitiesContainer.innerHTML =
              '<p class="col-span-full text-sm text-text-muted flex justify-center items-center">No hay comunidades registradas para esta parroquia</p>';
            return;
          }

          const items: CommunityItem[] = result.data.map((comm: any) => ({
            id: comm.id,
            number_community: comm.number_community,
            level_paso: comm.level_paso,
            total_brothers: comm.total_brothers,
            parish_id: parishId,
            parish_name: comm.parish_name,
            parish_aka: comm.parish_aka,
            responsible_name: comm.responsible_name,
          }));

          communitiesContainer.innerHTML = items
            .map((item) => createCommunityCardHTML(item))
            .join("");

          // Re-asignar listeners a los checkboxes
          const checkboxes = communitiesContainer.querySelectorAll(
            ".community-checkbox",
          );
          checkboxes.forEach((checkbox) => {
            const input = checkbox as HTMLInputElement;
            const id = Number(input.dataset.communityId);
            const item = items.find((it) => it.id === id);
            if (!item) return;

            input.addEventListener("change", () => {
              if (input.checked) {
                selectedCommunities.set(item.id, item);
              } else {
                selectedCommunities.delete(item.id);
              }
            });
          });
        })
        .catch(() => {
          communitiesContainer.innerHTML =
            '<p class="col-span-full text-center text-sm text-red-500 font-medium">Error al cargar las comunidades</p>';
        });
    }

    function updateInvitedList() {
      if (!invitedListSection || !invitedList) return;

      if (selectedCommunities.size === 0) {
        invitedList.innerHTML = "";
        invitedListSection.classList.add("hidden");
        return;
      }

      const rowsHTML = Array.from(selectedCommunities.values())
        .map((item) => createInvitedRowHTML(item))
        .join("");

      invitedList.innerHTML = rowsHTML;
      invitedListSection.classList.remove("hidden");
    }

    // let isEditMode = false;

    function openCreateConvivenciaModal() {
      // isEditMode = false;
      mode = "create";
      editingConvivenciaId = null;

      if (modalTitle) modalTitle.textContent = "Crear nueva convivencia";
      if (submitButton) submitButton.textContent = "Crear Convivencia";

      form?.reset();
      selectedCommunities.clear();
      resetCommunitiesUI();
      updateInvitedList();
      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    async function openEditConvivenciaModal(convId: string) {
      mode = "edit";
      editingConvivenciaId = convId;

      if (modalTitle) modalTitle.textContent = "Editar convivencia";
      if (submitButton) submitButton.textContent = "Guardar cambios";

      form?.reset();
      selectedCommunities.clear();
      resetCommunitiesUI();
      updateInvitedList();

      try {
        const res = await fetch(`/api/convivencias/${convId}`);
        const result = await res.json();

        if (!res.ok || !result.success || !result.data) {
          console.error("Error al cargar convivencia", result);
          alert(result?.error || "No se pudo cargar la convivencia");
          return;
        }

        const data = result.data;

        const nameInput = form?.querySelector(
          "#name-convi",
        ) as HTMLInputElement | null;
        const descInput = form?.querySelector(
          "#description-convi",
        ) as HTMLInputElement | null;
        const startInput = form?.querySelector(
          "#date-start",
        ) as HTMLInputElement | null;
        const endInput = form?.querySelector(
          "#date-end",
        ) as HTMLInputElement | null;

        if (nameInput) nameInput.value = data.name || "";
        if (descInput) descInput.value = data.description || "";

        // Asegurar formato YYYY-MM-DD
        if (startInput) startInput.value = String(data.start_date).slice(0, 10);
        if (endInput) endInput.value = String(data.end_date).slice(0, 10);

        if (Array.isArray(data.communities)) {
          data.communities.forEach((c: any) => {
            if (!c?.id) return;
            selectedCommunities.set(Number(c.id), {
              id: Number(c.id),
              number_community: Number(c.number_community),
              level_paso: c.level_paso ?? null,
              total_brothers: Number(c.total_brothers || 0),
              parish_id: Number(c.parish_id),
              parish_name: c.parish_name,
              parish_aka: c.parish_aka,
              responsible_name: c.responsible_name,
            });
          });
        }

        updateInvitedList();

        modal?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      } catch (err) {
        console.error("Error cargando convivencia", err);
        alert("Error de conexión al cargar la convivencia");
      }
    }

    // Función para cerrar el modal
    function closeParishModal() {
      modal?.classList.add("hidden");
      document.body.style.overflow = "";
      form?.reset();
      selectedCommunities.clear();
      resetCommunitiesUI();
      updateInvitedList();

      mode = "create";
      editingConvivenciaId = null;
      if (modalTitle) modalTitle.textContent = "Crear nueva convivencia";
      if (submitButton) submitButton.textContent = "Crear Convivencia";
    }

    setupModalCloseHandlers("modal-create-convi", () => {
      closeParishModal();
    });

    if (parishSelect) {
      // Exponer datos de parroquias en window para uso en el script
      (window as any).parishesData =
        (window as any).parishesData ||
        Array.from(parishSelect.options)
          .filter((opt) => opt.value)
          .map((opt) => ({
            id: Number(opt.value),
            aka: opt.text,
          }));

      parishSelect.addEventListener("change", () => {
        const value = parishSelect.value;
        if (!value) {
          resetCommunitiesUI();
          return;
        }
        const parishId = Number(value);
        if (!Number.isNaN(parishId)) {
          renderCommunities(parishId);
        }
      });
    }

    if (btnInvitar) {
      btnInvitar.addEventListener("click", (e) => {
        e.preventDefault();
        updateInvitedList();
      });
    }

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const name = (
          form.querySelector("#name-convi") as HTMLInputElement | null
        )?.value;
        const description = (
          form.querySelector("#description-convi") as HTMLInputElement | null
        )?.value;
        const startDate = (
          form.querySelector("#date-start") as HTMLInputElement | null
        )?.value;
        const endDate = (
          form.querySelector("#date-end") as HTMLInputElement | null
        )?.value;

        const communityIds = Array.from(selectedCommunities.values()).map(
          (c) => c.id,
        );

        const payload = {
          name,
          description,
          start_date: startDate,
          end_date: endDate,
          community_ids: communityIds,
        };

        try {
          const url =
            mode === "edit" && editingConvivenciaId
              ? `/api/convivencias/${editingConvivenciaId}`
              : "/api/convivencias";
          const method = mode === "edit" ? "PUT" : "POST";

          const res = await fetch(url, {
            method,
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const result = await res.json();

          if (result.success) {
            closeParishModal();
            setTimeout(() => {
              window.location.reload();
            }, 500);
          } else {
            alert(
              result.error ||
                (mode === "edit"
                  ? "Error al actualizar la convivencia"
                  : "Error al crear la convivencia"),
            );
          }
        } catch (error) {
          console.error("Error enviando convivencia:", error);
          alert(
            mode === "edit"
              ? "Error de conexión al actualizar la convivencia"
              : "Error de conexión al crear la convivencia",
          );
        }
      });
    }

    (window as any).openCreateConvivenciaModal = openCreateConvivenciaModal;
    (window as any).openEditConvivenciaModal = openEditConvivenciaModal;
  });
</script>
