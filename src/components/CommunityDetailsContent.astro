---
import ParishCardWithHeader from "./ParishCardWithHeader.astro";
import PairsIcon from "@/assets/PairsIcon.astro";
import ChurchIcon from "@/assets/ChurchIcon.astro";
import HomeIcon from "@/assets/HomeIcon.astro";
import LevelIcon from "@/assets/LevelIcon.astro";
import LibraryIcon from "@/assets/LibraryIcon.astro";

interface Props {
  community: any;
}

const { community } = Astro.props;

function formatRole(role: string): string {
  const roles: Record<string, string> = {
    responsable: "Responsable",
    corresponsable: "Corresponsable",
    didascala: "Didascala",
    ostiario: "Ostiario",
  };
  return roles[role] || role;
}
const generalInfo = [
  { label: "Parroquia", value: community.parish_name, icon: ChurchIcon },
  { label: "Paso", value: community.level_paso, icon: LevelIcon },
  {
    label: "Número de Comunidad",
    value: community.number_community,
    icon: HomeIcon,
  },
  {
    label: "Total de Hermanos",
    value: community.brothers_count,
    icon: PairsIcon,
  },
];
function getGroupLeadersInfo(community: any) {
  const groupLeaders = [];

  if (community.responsables && community.responsables.length > 0) {
    groupLeaders.push({
      type: "Responsables",
      members: community.responsables,
    });
  }

  if (community.corresponsables && community.corresponsables.length > 0) {
    groupLeaders.push({
      type: "Corresponsables",
      members: community.corresponsables,
    });
  }

  return groupLeaders;
}
const groupLeadersInfo = getGroupLeadersInfo(community);
const classIcons = "w-5 aspect-square text-text-muted";
---

<div class="flex flex-col gap-4 p-4">
  <!-- Información básica -->
  <ParishCardWithHeader title="Informacion general" icon={LibraryIcon}>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        generalInfo.map(({ label, value, icon: Icon }) => (
          <div class="flex items-start gap-4">
            <span>
              <Icon class={classIcons} />
            </span>
            <div class="flex flex-col">
              <span class="uppercase font-medium text-sm text-text-muted">
                {label}
              </span>
              <span class="text-text-primary">
                {value || "No especificado"}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </ParishCardWithHeader>

  <!-- Catequistas -->
  {
    community.catequistas && community.catequistas.length > 0 && (
      <ParishCardWithHeader title="Catequistas" icon={PairsIcon}>
        <div class="flex flex-col gap-2">
          <div class="space-y-2">
            {community.catequistas.map((r: any) => (
              <div class="flex items-center gap-4 p-4 bg-linear-to-r from-gray-300 to-gray-400 rounded-lg border-l-4 border-gray-600">
                <div class="w-10 aspect-square bg-gray-500 rounded-full flex items-center justify-center text-white font-semibold">
                  {r.names.charAt(0)}
                </div>
                <div>
                  <p class="font-semibold text-gray-800">{r.names}</p>
                  <p class="text-sm text-gray-600">
                    {r.phone || "Sin teléfono"}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </ParishCardWithHeader>
    )
  }

  <!-- Responsables -->
  {
    community.responsables && community.responsables.length > 0 && (
      <ParishCardWithHeader title="Grupo de responsables" icon={PairsIcon}>
        <div class="flex flex-col gap-2 mb-8">
          <h3 class="uppercase font-semibold text-sm text-text-primary ">
            Responsables
          </h3>
          <div class="space-y-2">
            {community.responsables.map((r: any) => (
              <div class="flex items-center gap-4 p-4 bg-linear-to-r from-gray-200 to-gray-300 rounded-lg border-l-4 border-gray-500">
                <div class="w-10 aspect-square bg-gray-400 rounded-full flex items-center justify-center text-white font-semibold">
                  {r.names.charAt(0)}
                </div>
                <div>
                  <p class="font-semibold text-gray-800">{r.names}</p>
                  <p class="text-sm text-gray-600">
                    {r.phone || "Sin teléfono"}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        {community.corresponsables && community.corresponsables.length > 0 && (
          <div class="flex flex-col gap-2">
            <h3 class="uppercase font-semibold text-sm text-text-primary ">
              Corresponsables
            </h3>
            <div class="space-y-2">
              {community.corresponsables.map((r: any) => (
                <div class="flex items-center gap-4 p-4 bg-linear-to-r from-gray-100 to-gray-200 rounded-lg border-l-4 border-gray-400">
                  <div class="w-10 aspect-square bg-gray-300 rounded-full flex items-center justify-center text-gray-700 font-semibold">
                    {r.names.charAt(0)}
                  </div>
                  <div>
                    <p class="font-semibold text-gray-800">{r.names}</p>
                    <p class="text-sm text-gray-600">
                      {r.phone || "Sin teléfono"}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </ParishCardWithHeader>
    )
  }

  <!-- Otros hermanos con roles -->
  {
    community.other_brothers && community.other_brothers.length > 0 && (
      <ParishCardWithHeader title="Otros servicios" icon={PairsIcon}>
        <div class="flex flex-col gap-2">
          <div class="space-y-2">
            {community.other_brothers.map((r: any) => (
              <div class="flex items-center gap-4 p-4 bg-linear-to-r from-gray-50 to-gray-100 rounded-lg border-l-4 border-gray-300 relative">
                <div class="w-10 aspect-square bg-gray-200 rounded-full flex items-center justify-center text-gray-600 font-semibold">
                  {r.names.charAt(0)}
                </div>
                <div>
                  <p class="font-semibold text-gray-800">{r.names}</p>
                  <p class="text-sm text-gray-600">
                    {r.phone || "Sin teléfono"}
                  </p>
                </div>
                <div class="absolute top-2 right-2 z-10">
                  <span class="role-tag" data-rol={r.role}>
                    {r.roles}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </ParishCardWithHeader>
    )
  }

  {
    (!community.responsables || community.responsables.length === 0) &&
      (!community.corresponsables || community.corresponsables.length === 0) &&
      (!community.catequistas || community.catequistas.length === 0) &&
      (!community.other_brothers || community.other_brothers.length === 0) && (
        <p class="text-gray-500 text-sm text-center py-4">
          No hay hermanos con roles registrados en esta comunidad
        </p>
      )
  }
</div>
