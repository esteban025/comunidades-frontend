---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<nav
  {...Astro.props}
  class="navbar no-print border-b-2 border-b-border-light w-full max-w-6xl mx-auto"
>
  <div
    class="navbar-container max-w-7xl mx-auto p-4 pb-6 flex justify-between items-center gap-8 flex-wrap bg-gray-50/10 backdrop-blur-xs"
  >
    <div class="navbar-brand flex flex-col gap-1">
      <h1
        class="navbar-title text-2xl font-bold text-text-primary m-0 leading-none"
      >
        {title}
      </h1>
      <span class="navbar-subtitle text-sm text-text-muted font-medium"
        >{description}</span
      >
    </div>

    <div class="actions" slot="actions">
      <slot name="actions" />
    </div>
  </div>
</nav>
