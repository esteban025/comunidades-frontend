---
// src/components/ModalManageCommunities.astro
import ModalDesign from "./ModalDesign.astro";
---

<ModalDesign
  id="modal-manage-communities"
  title="Gestionar Comunidades"
  isForm={false}
>
  <div class="flex flex-col w-full" slot="body">
    <!-- <div class="message-i">fgbg</div> -->

    <div id="manage-communities-content" class="w-full flex flex-col gap-3">
      <div class="flex items-center justify-center">
        <div class="text-sm text-neutral-500">Cargando...</div>
      </div>
    </div>
  </div>
  <button
    slot="footer"
    class="btn btn-secondary w-full"
    id="modal-close-btn"
    data-close="modal-manage-communities"
  >
    Cerrar
  </button>
  <button slot="footer" class="btn btn-primary w-full" id="modal-action-btn"
    >Fusionar Comunidades</button
  >
</ModalDesign>

<script>
  // conectamos el button para abrir la modal

  import { $id } from "@/utils/selectElementsDom";
  import { setupModalCloseHandlers } from "@/scripts/modalClose";
  import { showNotification } from "@/scripts/notification";

  document.addEventListener("astro:page-load", () => {
    const $modal = $id("modal-manage-communities") as HTMLDivElement | null;
    const $content = $id("manage-communities-content") as HTMLDivElement | null;
    const $action = $id("modal-action-btn") as HTMLButtonElement | null;

    let parishId: number | null = null;
    const selected = new Set<number>();

    const setBusy = (busy: boolean) => {
      if (!$action) return;
      $action.disabled = busy;
      $action.textContent = busy ? "Fusionando..." : "Fusionar Comunidades";
    };

    const wireContentInteractions = () => {
      if (!$content) return;

      selected.clear();

      const summary = $content.querySelector(
        "#manage-communities-summary",
      ) as HTMLDivElement | null;

      const updateSummary = () => {
        if (!summary) return;
        const checks = Array.from(
          $content.querySelectorAll(
            "input[type=checkbox][data-community-id][data-community-number]",
          ),
        ) as HTMLInputElement[];

        const chosen = checks
          .filter((c) => c.checked)
          .map((c) => ({
            id: Number(c.dataset.communityId),
            number_community: Number(c.dataset.communityNumber),
          }))
          .sort((a, b) => a.number_community - b.number_community);

        if (chosen.length < 2) {
          summary.textContent = "Selecciona al menos 2 comunidades.";
          return;
        }

        const target = chosen[0];
        const sources = chosen.slice(1);
        summary.textContent = `Principal: #${target.number_community}. Se fusionarán: ${sources
          .map((s) => `#${s.number_community}`)
          .join(", ")}.`;
      };

      const checks = $content.querySelectorAll(
        "input[type=checkbox][data-community-id]",
      );
      checks.forEach((el) => {
        el.addEventListener("change", () => {
          const input = el as HTMLInputElement;
          const id = Number(input.dataset.communityId);
          if (input.checked) selected.add(id);
          else selected.delete(id);
          updateSummary();
        });
      });

      updateSummary();
    };

    const closeModal = () => {
      $modal?.classList.add("hidden");
      document.body.style.overflow = "";
      parishId = null;
      selected.clear();
      if ($content) {
        $content.innerHTML = `
          <div class="flex items-center justify-center">
            <div class="text-sm text-neutral-500">Cargando...</div>
          </div>
        `;
      }
      setBusy(false);
    };

    setupModalCloseHandlers("modal-manage-communities", () => {
      closeModal();
    });

    const runMerge = async () => {
      if (!parishId) {
        showNotification("Parroquia no válida", "error", 4500);
        return;
      }

      const checks = Array.from(
        ($content?.querySelectorAll(
          "input[type=checkbox][data-community-id][data-community-number]",
        ) ?? []) as any,
      ) as HTMLInputElement[];

      const chosen = checks
        .filter((c) => c.checked)
        .map((c) => ({
          id: Number(c.dataset.communityId),
          number_community: Number(c.dataset.communityNumber),
        }))
        .sort((a, b) => a.number_community - b.number_community);

      if (chosen.length < 2) {
        showNotification("Selecciona al menos 2 comunidades", "error", 4500);
        return;
      }

      const target = chosen[0];
      const sources = chosen.slice(1);

      const ok = window.confirm(
        `Se fusionarán ${sources.length} comunidad(es) en la comunidad #${target.number_community}.\n\n` +
          `Acciones: mover hermanos a la principal, eliminar roles y eliminar comunidades fusionadas.\n` +
          `Luego se reorganizarán los números para evitar saltos.\n\n¿Continuar?`,
      );
      if (!ok) return;

      setBusy(true);
      try {
        const mergeRes = await fetch("/api/communities/merge", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            targetCommunityId: target.id,
            sourceCommunityIds: sources.map((s) => s.id),
          }),
        });
        const mergeResult = await mergeRes.json();
        if (!mergeResult?.success) {
          throw new Error(
            mergeResult?.error || "Error al fusionar comunidades",
          );
        }

        closeModal();
        showNotification(
          "Comunidades fusionadas exitosamente",
          "success",
          3000,
        );
        setTimeout(() => window.location.reload(), 500);
      } catch (e: any) {
        showNotification(
          e?.message || "Error al fusionar comunidades",
          "error",
          5000,
        );
      } finally {
        setBusy(false);
      }
    };

    $action?.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      await runMerge();
    });

    async function openManageCommunitiesModalWithParishId(
      pid?: number | string,
    ) {
      const parsed = pid !== undefined && pid !== null ? Number(pid) : NaN;
      if (!pid || Number.isNaN(parsed)) {
        showNotification("Parroquia no válida", "error", 4500);
        return;
      }

      parishId = parsed;
      $modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setBusy(false);

      try {
        if ($content) {
          $content.innerHTML = `
            <div class="flex items-center justify-center">
              <div class="text-sm text-neutral-500">Cargando comunidades...</div>
            </div>
          `;
        }

        const response = await fetch(`/gestionar-comunidades/${parishId}`);
        if (!response.ok) {
          throw new Error("Error al cargar los datos");
        }

        const html = await response.text();
        if ($content) {
          $content.innerHTML = html;
        }

        wireContentInteractions();
      } catch (e: any) {
        showNotification(
          e?.message || "Error al obtener comunidades",
          "error",
          5000,
        );

        if ($content) {
          $content.innerHTML = `
            <div class="text-center py-8 text-red-600">
              <p class="font-semibold">Error al cargar los datos</p>
              <p class="text-sm mt-2">Por favor, intenta nuevamente</p>
            </div>
          `;
        }
      }
    }

    (window as any).openManageCommunitiesModalWithParishId =
      openManageCommunitiesModalWithParishId;
  });
</script>
