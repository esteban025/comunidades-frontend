---
import ModalDesign from "./ModalDesign.astro";
---

<ModalDesign id="modal-view-brother" title="Detalles de la comunidad" idForm="">
  <div class="flex flex-col gap-6" slot="body" id="brother-details-content">
    <div class="flex items-center justify-center">
      <div class="loading-spinner">Cargando...</div>
    </div>
  </div>
  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-view-brother"
    slot="footer"
  >
    Cerrar
  </button>
</ModalDesign>

<style>
  .loading-spinner {
    color: #6b7280;
    font-size: 0.875rem;
  }

  .error-message {
    text-align: center;
    color: #dc2626;
    padding: 2rem;
  }
</style>

<script>
  import { showNotification } from "@/scripts/notification";

  // Función global para abrir el modal de comunidad
  (window as any).openViewCommunityModal = async (
    communityId: string,
    // parishName: string,
    // communityNumber: string,
  ) => {
    const modal = document.getElementById("modal-view-brother");
    const contentDiv = document.getElementById("brother-details-content");

    if (!modal || !contentDiv) return;

    // Abrir modal
    modal.classList.remove("hidden");

    // Mostrar loading
    contentDiv.innerHTML = `
      <div class="flex items-center justify-center">
        <div class="loading-spinner">Cargando detalles de la comunidad...</div>
      </div>
    `;

    try {
      // Obtener HTML renderizado del servidor
      const response = await fetch(`/view-community/${communityId}`);

      if (!response.ok) {
        throw new Error("Error al cargar los datos");
      }

      const html = await response.text();

      // Renderizar contenido
      contentDiv.innerHTML = html;
    } catch (error) {
      console.error("Error cargando detalles de comunidad:", error);
      showNotification(
        "Error al cargar los detalles de la comunidad",
        "error",
        3000,
      );
      contentDiv.innerHTML = `
        <div class="error-message">
          <p class="font-semibold">Error al cargar los datos</p>
          <p class="text-sm mt-2">Por favor, intenta nuevamente</p>
        </div>
      `;
    }
  };
</script>
