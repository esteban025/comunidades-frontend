---
// COMPONENTS
import ModalDesign from "./ModalDesign.astro";
---

<ModalDesign id="modal-view-community" title="Detalles de la comunidad">
  <div
    class="flex flex-col gap-6 w-full"
    slot="body"
    id="community-details-content"
  >
    <div class="flex items-center justify-center">
      <div class="loading-spinner">Cargando...</div>
    </div>
  </div>
  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-view-community"
    slot="footer"
  >
    Cerrar
  </button>
</ModalDesign>

<style>
  .loading-spinner {
    color: #6b7280;
    font-size: 0.875rem;
  }

  .error-message {
    text-align: center;
    color: #dc2626;
    padding: 2rem;
  }
</style>

<script>
  import { showNotification } from "@/scripts/notification";
  import { setupModalCloseHandlers } from "@/scripts/modalClose";
  import { $id } from "@/utils/selectElementsDom";

  document.addEventListener("astro:page-load", () => {
    const modal = $id("modal-view-community") as HTMLDivElement;
    const contentDiv = $id("community-details-content") as HTMLDivElement;

    if (!modal || !contentDiv) return;

    function resetContent() {
      contentDiv.innerHTML = `
        <div class="flex items-center justify-center">
          <div class="loading-spinner">Cargando...</div>
        </div>
      `;
    }

    function closeViewCommunityModal() {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
      resetContent();
    }

    async function openViewCommunityModal(communityId: string) {
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";

      contentDiv.innerHTML = `
        <div class="flex items-center justify-center">
          <div class="loading-spinner">Cargando detalles de la comunidad...</div>
        </div>
      `;

      try {
        const response = await fetch(`/view-community/${communityId}`);

        if (!response.ok) {
          throw new Error("Error al cargar los datos");
        }

        const html = await response.text();
        contentDiv.innerHTML = html;
      } catch (error) {
        console.error("Error cargando detalles de comunidad:", error);
        showNotification(
          "Error al cargar los detalles de la comunidad",
          "error",
          3000,
        );
        contentDiv.innerHTML = `
          <div class="error-message">
            <p class="font-semibold">Error al cargar los datos</p>
            <p class="text-sm mt-2">Por favor, intenta nuevamente</p>
          </div>
        `;
      }
    }

    setupModalCloseHandlers("modal-view-community", () => {
      closeViewCommunityModal();
    });

    (window as any).openViewCommunityModal = openViewCommunityModal;
  });
</script>
