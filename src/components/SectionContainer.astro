---
interface Props {
  title: string;
  description?: string;
  id?: string;
}

const { title, description, id } = Astro.props;
---

<section
  id={id}
  class="w-full max-w-6xl mx-auto bg-gray-50 rounded-xl shadow- overflow-hidden relative border border-border-light shadow-md hover:shadow-lg transition-all duration-300"
>
  <header class="p-6 pb-0">
    <h3 class="text-2xl font-bold mb-1 text-text-primary">{title}</h3>
    {description && <p class="text-sm text-text-secondary">{description}</p>}
  </header>

  <div class="my-8 px-6">
    <slot name="body" />
  </div>

  <footer class="p-6 border-t-2 border-border-light">
    <div class="flex justify-between items-center text-sm text-text-secondary">
      <span class="text-text-muted">
        Última actualización: {new Date().toLocaleDateString()}
      </span>
      <slot name="footer-link" />
    </div>
  </footer>
</section>
