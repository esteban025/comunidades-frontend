---
interface Props {
  title?: string;
  description?: string;
  id?: string;
}

const { title, description, id } = Astro.props;
---

<section
  {...Astro.props}
  id={id}
  class="w-full max-w-6xl mx-auto bg-gray-50/10 backdrop-blur-xs rounded-xl shadow- overflow-hidden relative border border-border-light shadow-md hover:shadow-lg transition-all duration-300"
>
  <div class="flex items-center justify-between p-6 pb-0">
    <!-- si hay titulo o description renderixo el header -->
    {
      (title || description) && (
        <header class="">
          <h3 class="text-2xl font-bold text-text-primary flex items-center gap-2 mb-2">
            <slot name="icon-title" />
            <span>{title}</span>
          </h3>
          {description && (
            <p class="text-sm text-text-secondary">{description}</p>
          )}
        </header>
      )
    }
    <nav>
      <slot name="nav-links" />
    </nav>
  </div>

  <div class="my-8 px-6">
    <slot name="body" />
  </div>

  <footer class="p-6 border-t-2 border-border-light">
    <div class="flex justify-between items-center text-sm text-text-secondary">
      <span class="text-text-muted">
        Última actualización: {new Date().toLocaleDateString()}
      </span>
      <slot name="footer-link" />
    </div>
  </footer>
</section>
