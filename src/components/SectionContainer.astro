---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section
  class="w-full max-w-6xl mx-auto bg-gray-50 rounded-xl shadow-md overflow-hidden relative"
>
  <header class="p-6 pb-0">
    <h3 class="text-2xl font-bold mb-1">{title}</h3>
    {description && <p class="text-sm text-gray-500">{description}</p>}
  </header>

  <div class="my-8 px-6">
    <slot name="body" />
  </div>

  <footer class="p-6 border-t-2 border-gray-200 bg-white/70">
    <div class="flex justify-between items-center text-gray-500 text-sm">
      <span>
        Última actualización: {new Date().toLocaleDateString()}
      </span>
      <slot name="footer-link" />
    </div>
  </footer>
</section>
