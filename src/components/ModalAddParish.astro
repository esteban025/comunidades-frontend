---
// Modal para agregar parroquia
---

<div id="modal-parish" class="modal-overlay hidden">
  <div class="modal-container">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">Registrar Parroquia</h2>
        <button class="modal-close" data-close="modal-parish">
          <span class="modal-close-icon">✕</span>
        </button>
      </div>

      <div class="modal-body">
        <form id="modal-parish-form">
          <div class="content-input">
            <label for="modal-parish-name">Nombre Parroquia</label>
            <input
              type="text"
              name="parish-name"
              id="modal-parish-name"
              placeholder="San Luis de Gonzaga"
              required
            />
          </div>

          <div class="content-input">
            <label for="modal-parish-tag">Etiqueta Parroquia</label>
            <input
              type="text"
              name="parish-tag"
              id="modal-parish-tag"
              placeholder="SLG"
              required
            />
          </div>

          <div class="content-input">
            <label for="modal-parish-aka">Alias Parroquia</label>
            <input
              type="text"
              name="parish-aka"
              id="modal-parish-aka"
              placeholder="Quinta Chica"
              required
            />
          </div>

          <div class="modal-actions">
            <button
              type="button"
              class="btn btn-secondary"
              data-close="modal-parish"
            >
              Cancelar
            </button>
            <button type="submit" class="btn btn-primary"> Registrar </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    padding: 1rem;
    backdrop-filter: blur(10px);
  }

  .modal-overlay.hidden {
    display: none;
  }

  .modal-container {
    width: 100%;
    max-width: 500px;
    animation: modalSlideIn 0.3s ease-out;
  }

  .modal-content {
    background-color: #ffffff;
    border-radius: 1.5rem;
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
    overflow: hidden;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 2px solid #e5e7eb;
  }

  .modal-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0;
  }

  .modal-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  .modal-close:hover {
    background-color: #f3f4f6;
  }

  .modal-close-icon {
    font-size: 1.5rem;
    color: #6b7280;
    line-height: 1;
  }

  .modal-body {
    padding: 1.5rem;
  }

  .modal-body form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .modal-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .modal-actions button {
    flex: 1;
  }

  @keyframes modalSlideIn {
    from {
      transform: translateY(-20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .modal-container {
      max-width: 100%;
    }

    .modal-content {
      border-radius: 1rem;
    }
  }
</style>

<script>
  import { registerParish } from "@/scripts/registerParish";
  import { showNotification } from "@/scripts/notification";

  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("modal-parish");
    const form = document.getElementById(
      "modal-parish-form",
    ) as HTMLFormElement;
    const closeButtons = document.querySelectorAll(
      '[data-close="modal-parish"]',
    );

    // Función para abrir el modal
    function openParishModal() {
      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    // Función para cerrar el modal
    function closeParishModal() {
      modal?.classList.add("hidden");
      document.body.style.overflow = "";
      form?.reset();
    }

    // Cerrar con los botones de cerrar
    closeButtons.forEach((button) => {
      button.addEventListener("click", closeParishModal);
    });

    // Cerrar al hacer clic fuera del modal
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeParishModal();
      }
    });

    // Cerrar con la tecla Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
        closeParishModal();
      }
    });

    // Manejar el envío del formulario
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const formData = new FormData(form);
        const submitButton = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;

        // Deshabilitar botón mientras se procesa
        submitButton.disabled = true;
        submitButton.textContent = "Registrando...";

        const result = await registerParish(formData);

        // Cerrar el modal siempre (éxito o error)
        closeParishModal();

        if (result.success) {
          showNotification(
            "¡Parroquia registrada exitosamente!",
            "success",
            3000,
          );

          // Actualizar la lista sin recargar la página
          if (typeof (window as any).refreshParishes === "function") {
            await (window as any).refreshParishes();
          }
        } else {
          showNotification(
            result.error || "Error al registrar la parroquia",
            "error",
            5000,
          );
        }

        // Rehabilitar botón
        submitButton.disabled = false;
        submitButton.textContent = "Registrar";
      });
    }

    // Hacer la función disponible globalmente
    (window as any).openParishModal = openParishModal;
  });
</script>
