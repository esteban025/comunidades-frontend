---
import ModalDesign from "./ModalDesign.astro";
import { actions } from "astro:actions";

const parishAct = actions.parishesAction;
const formData = {
  idForm: "modal-parish-form",
  method: "POST" as const,
  action: parishAct,
};
---

<ModalDesign
  id="modal-parish"
  title="Registrar Parroquia"
  isForm={true}
  formData={formData}
>
  <div class="" slot="body">
    <fieldset class="container-fieldset">
      <legend class="title-container">Información</legend>

      <!-- name -->
      <div class="content-input">
        <label for="parish-name">Nombre Parroquia</label>
        <input
          type="text"
          name="parish-name"
          id="parish-name"
          placeholder="San Luis de Gonzaga"
          required
          autocomplete="off"
        />
      </div>

      <!-- tag -->
      <div class="content-input">
        <label for="parish-tag">Etiqueta Parroquia</label>
        <input
          type="text"
          name="parish-tag"
          id="parish-tag"
          placeholder="SLG"
          required
          autocomplete="off"
        />
      </div>

      <!-- aka -->
      <div class="content-input">
        <label for="parish-aka">Alias Parroquia</label>
        <input
          type="text"
          name="parish-aka"
          id="parish-aka"
          placeholder="Quinta Chica"
          required
          autocomplete="off"
        />
      </div>

      <!-- id para edit -->
      <input type="hidden" name="parish-id" id="parish-id" />
    </fieldset>
    <p
      id="message-error-parish"
      class="mt-4 hidden text-center w-full text-red-400"
    >
      Ya existe una parroquia con ese...
    </p>
  </div>
  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-parish"
    slot="footer"
  >
    Cancelar
  </button>
  <button
    type="submit"
    class="btn btn-primary flex-1"
    id="parish-submit"
    slot="footer"
  >
    Registrar
  </button>
</ModalDesign>

<script>
  import { actions } from "astro:actions";
  import { showNotification } from "@/scripts/notification";
  import { setupModalCloseHandlers } from "@/scripts/modalClose";
  import { $id } from "@/utils/selectElementsDom";
  import type { Parish } from "@/types/parishes";

  document.addEventListener("astro:page-load", () => {
    const mdl = $id("modal-parish");
    const mdlTitle = mdl?.querySelector("h2");
    const form = $id("modal-parish-form") as HTMLFormElement;
    const sbtBtn = $id("parish-submit") as HTMLButtonElement;

    const inpParishName = $id("parish-name") as HTMLInputElement;
    const inpParishTag = $id("parish-tag") as HTMLInputElement;
    const inpParishAka = $id("parish-aka") as HTMLInputElement;
    const inpParishId = $id("parish-id") as HTMLInputElement;

    const msgErrr = $id("message-error-parish") as HTMLParagraphElement;

    function textModal(title: string, submitBtnText: string) {
      if (mdlTitle) mdlTitle.textContent = title;
      if (sbtBtn) sbtBtn.textContent = submitBtnText;
      form.reset();
    }

    function openParishModal() {
      textModal("Registrar Parroquia", "Registrar");
      mdl?.classList.remove("hidden");
    }

    function closeParishModal() {
      mdl?.classList.add("hidden");
      form.reset();
      if (inpParishId) inpParishId.value = "";
    }

    function openEditParishModal(parish: Parish) {
      textModal("Editar Parroquia", "Actualizar");
      if (!inpParishName || !inpParishTag || !inpParishAka || !inpParishId)
        return;

      inpParishName.value = parish.name;
      inpParishTag.value = parish.tag;
      inpParishAka.value = parish.aka;
      inpParishId.value = String(parish.id);

      mdl?.classList.remove("hidden");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const id = formData.get("parish-id");
      const name = formData.get("parish-name") as string;
      const tag = formData.get("parish-tag") as string;
      const aka = formData.get("parish-aka") as string;
      const info = id ? { id: Number(id), name, tag, aka } : { name, tag, aka };
      const { data, error } = await actions.parishesAction(info);
      const isEdit = Boolean(id);
      if (error) {
        msgErrr.textContent = error.message;
        msgErrr.classList.remove("hidden");
      } else {
        closeParishModal();
        showNotification(
          isEdit
            ? "Parroquia actualizada con éxito."
            : "Parroquia registrada con éxito.",
          "success",
        );
        form.reset();
        window.dispatchEvent(new CustomEvent("parish:created"));
      }
    });

    setupModalCloseHandlers("modal-parish", closeParishModal);

    (window as any).openParishModal = openParishModal;
    (window as any).openEditParishModal = openEditParishModal;
  });
</script>
