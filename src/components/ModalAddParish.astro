---
// Modal para agregar parroquia
import ModalDesign from "./ModalDesign.astro";
---

<ModalDesign
  id="modal-parish"
  title="Registrar Parroquia"
  idForm="modal-parish-form"
  isForm={true}
>
  <div class="" slot="body">
    <input type="hidden" name="parish-id" id="modal-parish-id" />
    <fieldset class="container-fieldset">
      <legend class="title-container">Información</legend>
      <div class="content-input">
        <label for="modal-parish-name">Nombre Parroquia</label>
        <input
          type="text"
          name="parish-name"
          id="modal-parish-name"
          placeholder="San Luis de Gonzaga"
          required
          autocomplete="off"
        />
      </div>

      <div class="content-input">
        <label for="modal-parish-tag">Etiqueta Parroquia</label>
        <input
          type="text"
          name="parish-tag"
          id="modal-parish-tag"
          placeholder="SLG"
          required
          autocomplete="off"
        />
      </div>

      <div class="content-input">
        <label for="modal-parish-aka">Alias Parroquia</label>
        <input
          type="text"
          name="parish-aka"
          id="modal-parish-aka"
          placeholder="Quinta Chica"
          required
          autocomplete="off"
        />
      </div>
    </fieldset>
  </div>
  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-parish"
    slot="footer"
  >
    Cancelar
  </button>
  <button
    type="submit"
    class="btn btn-primary flex-1"
    id="modal-parish-submit"
    slot="footer"
  >
    Registrar
  </button>
</ModalDesign>

<script>
  import { registerParish } from "@/scripts/registerParish";
  import { showNotification } from "@/scripts/notification";
  import { setupModalCloseHandlers } from "@/scripts/modalClose";

  document.addEventListener("astro:page-load", () => {
    const $id = (selector: string) => document.getElementById(selector);
    const $ = (selector: string) => document.querySelector(selector);
    const $$ = (selector: string) => document.querySelectorAll(selector);

    const modal = $id("modal-parish");
    const form = $id("modal-parish-form") as HTMLFormElement;
    const modalTitle = modal?.querySelector("h2");
    const submitButton = $id("modal-parish-submit") as HTMLButtonElement;
    const parishIdInput = $id("modal-parish-id") as HTMLInputElement;
    const parishNameInput = $id("modal-parish-name") as HTMLInputElement;
    const parishTagInput = $id("modal-parish-tag") as HTMLInputElement;
    const parishAkaInput = $id("modal-parish-aka") as HTMLInputElement;

    let isEditMode = false;

    // Función para abrir el modal (crear)
    function openParishModal() {
      isEditMode = false;
      if (modalTitle) modalTitle.textContent = "Registrar Parroquia";
      if (submitButton) submitButton.textContent = "Registrar";
      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    // Función para abrir el modal en modo edición
    function openEditParishModal(parishData: any) {
      isEditMode = true;
      if (modalTitle) modalTitle.textContent = "Editar Parroquia";
      if (submitButton) submitButton.textContent = "Actualizar";

      // Pre-llenar los campos
      if (parishIdInput) parishIdInput.value = parishData.id;
      if (parishNameInput) parishNameInput.value = parishData.name;
      if (parishTagInput) parishTagInput.value = parishData.tag;
      if (parishAkaInput) parishAkaInput.value = parishData.aka;

      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    // Función para cerrar el modal
    function closeParishModal() {
      modal?.classList.add("hidden");
      document.body.style.overflow = "";
      form?.reset();
    }

    setupModalCloseHandlers("modal-parish", () => {
      closeParishModal();
    });

    // Manejar el envío del formulario
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const formData = new FormData(form);
        const submitBtn = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;

        // Deshabilitar botón mientras se procesa
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = isEditMode
          ? "Actualizando..."
          : "Registrando...";

        const result = await registerParish(formData, isEditMode);

        // Cerrar el modal siempre (éxito o error)
        closeParishModal();

        if (result.success) {
          showNotification(
            isEditMode
              ? "¡Parroquia actualizada exitosamente!"
              : "¡Parroquia registrada exitosamente!",
            "success",
            3000,
          );

          // Actualizar la lista sin recargar la página
          if (typeof (window as any).refreshParishes === "function") {
            await (window as any).refreshParishes();
          }
        } else {
          showNotification(
            result.error ||
              (isEditMode
                ? "Error al actualizar la parroquia"
                : "Error al registrar la parroquia"),
            "error",
            5000,
          );
        }

        // Rehabilitar botón
        submitBtn.disabled = false;
        submitBtn.textContent = originalText || "Registrar";
      });
    }

    // Hacer las funciones disponibles globalmente
    (window as any).openParishModal = openParishModal;
    (window as any).openEditParishModal = openEditParishModal;
  });
</script>
