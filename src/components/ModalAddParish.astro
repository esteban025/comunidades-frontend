---
// Modal para agregar parroquia
import ModalDesign from "./ModalDesign.astro";
---

<ModalDesign
  id="modal-parish"
  title="Registrar Parroquia"
  idForm="modal-parish-form"
>
  <div class="flex flex-col gap-5 p-6" slot="body">
    <div class="content-input">
      <label for="modal-parish-name">Nombre Parroquia</label>
      <input
        type="text"
        name="parish-name"
        id="modal-parish-name"
        placeholder="San Luis de Gonzaga"
        required
      />
    </div>

    <div class="content-input">
      <label for="modal-parish-tag">Etiqueta Parroquia</label>
      <input
        type="text"
        name="parish-tag"
        id="modal-parish-tag"
        placeholder="SLG"
        required
      />
    </div>

    <div class="content-input">
      <label for="modal-parish-aka">Alias Parroquia</label>
      <input
        type="text"
        name="parish-aka"
        id="modal-parish-aka"
        placeholder="Quinta Chica"
        required
      />
    </div>
  </div>
  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-parish"
    slot="footer"
  >
    Cancelar
  </button>
  <button type="submit" class="btn btn-primary flex-1" slot="footer">
    Registrar
  </button>
</ModalDesign>

<script>
  import { registerParish } from "@/scripts/registerParish";
  import { showNotification } from "@/scripts/notification";

  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("modal-parish");
    const form = document.getElementById(
      "modal-parish-form",
    ) as HTMLFormElement;
    const closeButtons = document.querySelectorAll(
      '[data-close="modal-parish"]',
    );

    // Función para abrir el modal
    function openParishModal() {
      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    // Función para cerrar el modal
    function closeParishModal() {
      modal?.classList.add("hidden");
      document.body.style.overflow = "";
      form?.reset();
    }

    // Cerrar con los botones de cerrar
    closeButtons.forEach((button) => {
      button.addEventListener("click", closeParishModal);
    });

    // Cerrar al hacer clic fuera del modal
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeParishModal();
      }
    });

    // Cerrar con la tecla Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
        closeParishModal();
      }
    });

    // Manejar el envío del formulario
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const formData = new FormData(form);
        const submitButton = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;

        // Deshabilitar botón mientras se procesa
        submitButton.disabled = true;
        submitButton.textContent = "Registrando...";

        const result = await registerParish(formData);

        // Cerrar el modal siempre (éxito o error)
        closeParishModal();

        if (result.success) {
          showNotification(
            "¡Parroquia registrada exitosamente!",
            "success",
            3000,
          );

          // Actualizar la lista sin recargar la página
          if (typeof (window as any).refreshParishes === "function") {
            await (window as any).refreshParishes();
          }
        } else {
          showNotification(
            result.error || "Error al registrar la parroquia",
            "error",
            5000,
          );
        }

        // Rehabilitar botón
        submitButton.disabled = false;
        submitButton.textContent = "Registrar";
      });
    }

    // Hacer la función disponible globalmente
    (window as any).openParishModal = openParishModal;
  });
</script>
