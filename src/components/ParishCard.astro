---
interface Props {
  aka: string;
  tag: string;
  name: string;
}
const { aka, tag, name } = Astro.props;
---

<article
  class="rounded-xl bg-white border border-border-light shadow-sm group cursor-pointer transition-all duration-300 hover:shadow-md block no-underline p-6 group relative overflow-hidden parish-card"
>
  <div
    class="absolute top-3 right-3 translate-x-12 -translate-y-8 transition-all duration-300 group-hover:translate-x-0 group-hover:translate-y-0"
  >
    <slot name="btn-edit" />
  </div>
  <div
    class="absolute bottom-3 right-3 translate-x-10 translate-y-10 transition-all duration-300 group-hover:translate-x-0 group-hover:translate-y-0"
  >
    <slot name="btn-href" />
  </div>
  <div class="flex flex-col gap-1">
    <h3 class="text-2xl font-semibold text-text-primary">
      {aka}
    </h3>
    <span class="text-sm mb-4 text-text-muted">{name}</span>
    <span
      class="px-4 py-2 border border-gray-500 text-gray-500 text-sm font-semibold rounded-full shadow-sm inline-block w-fit"
    >
      {tag}
    </span>
  </div>
</article>
