---
// Modal para agregar hermano
import ModalDesign from "./ModalDesign.astro";
import type { Parish } from "@/types/parishes";
import { getParishes } from "@/services/parishes";
import PLusIcon from "@/assets/PLusIcon.astro";
import CheckIcon from "@/assets/CheckIcon.astro";
const parishes: Parish[] = await getParishes();
// const civilStatus = ["matrimonio", "soltero", "soltera"];
---

<ModalDesign
  id="modal-add-brotherc"
  title="Registrar Hermano"
  idForm="modal-brotherc-form"
  isForm={true}
>
  <div class="flex flex-col gap-6" slot="body">
    <input type="hidden" id="brother-id" name="brother_id" />
    <input type="hidden" id="parish-id-hidden" name="parish_id" />
    <input type="hidden" id="community-number-hidden" name="community_number" />
    <input type="hidden" id="level-paso-hidden" name="level_paso" />

    <!-- Sección 1: Datos Personales -->
    <fieldset class="container-fieldset">
      <legend class="title-container">Datos Personales</legend>

      <div class="container-contents-inputs">
        <div class="space-y-2">
          <h3>Estado civil</h3>
          <div class="wrapper space-y-4">
            <div class="ratios-row">
              <div class="ss">
                <input
                  type="radio"
                  name="civil_status"
                  id="ratio-matrimonio"
                  value="matrimonio"
                  class="checks-btns"
                  data-index="0"
                />
                <label for="ratio-matrimonio" class="radio-label"
                  >Matrimonio</label
                >
              </div>
              <div class="ss">
                <input
                  type="radio"
                  name="civil_status"
                  id="ratio-soltero"
                  value="soltero"
                  class="checks-btns"
                  checked
                  data-index="1"
                />
                <label for="ratio-soltero" class="radio-label">Soltero</label>
              </div>
              <div class="ss">
                <input
                  type="radio"
                  name="civil_status"
                  id="ratio-soltera"
                  class="checks-btns"
                  value="soltera"
                  data-index="2"
                />
                <label for="ratio-soltera" class="radio-label">Soltera</label>
              </div>
              <div
                id="civil-indicator"
                class="absolute bg-bg-primary rounded-full border border-border-light inset-0 w-1/3 h-full shadow-md transition-all duration-300 pointer-events-none civil-indicator"
              >
              </div>
            </div>

            <div class="fields-row">
              <div id="matrimonio-fields" class="space-y-4">
                <!-- Inputs esposo y esposa -->
                <div
                  id="husband-container"
                  class="husband grid grid-cols-2 items-center gap-4"
                >
                  <div id="husband-block" class="husband-c content-input">
                    <label for="husband_name">Nombre del Esposo</label>
                    <input
                      type="text"
                      name="husband_name"
                      id="husband_name"
                      placeholder="Ej: Juan Pérez"
                      autocomplete="off"
                    />
                  </div>
                  <div id="husband-phone-block" class="content-input">
                    <label for="husband_phone"
                      >Teléfono del Esposo (Opcional)</label
                    >
                    <input
                      type="tel"
                      name="husband_phone"
                      id="husband_phone"
                      placeholder="Ej: 0999123456"
                      autocomplete="off"
                    />
                  </div>
                </div>

                <div
                  id="wife-container"
                  class="wife grid grid-cols-2 items-center gap-4"
                >
                  <div id="wife-block" class="content-input">
                    <label for="wife_name">Nombre de la Esposa</label>
                    <input
                      type="text"
                      name="wife_name"
                      id="wife_name"
                      placeholder="Ej: María López"
                      autocomplete="off"
                    />
                  </div>

                  <div id="wife-phone-block" class="content-input">
                    <label for="wife_phone"
                      >Teléfono de la Esposa (Opcional)</label
                    >
                    <input
                      type="tel"
                      name="wife_phone"
                      id="wife_phone"
                      placeholder="Ej: 0999123456"
                      autocomplete="off"
                    />
                  </div>
                </div>
              </div>

              <div id="single-field" class="content-input">
                <!-- Input soltero/soltera -->
                <label for="full_name">Nombre Completo</label>
                <input
                  type="text"
                  name="full_name"
                  id="full_name"
                  placeholder="Ej: Pedro García"
                  autocomplete="off"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- telefono en soltero/a -->
      <div class="content-input content-single-phone">
        <label for="phone_soltero">Teléfono (Opcional)</label>
        <input
          type="tel"
          name="phone"
          id="phone_soltero"
          placeholder="Ej: 0999123456"
          autocomplete="off"
        />
      </div>
    </fieldset>

    <!-- Sección 3: Roles -->
    <fieldset class="container-fieldset" id="roles-brothers">
      <legend class="title-container">Roles (Opcional)</legend>

      <div class="checkbox-group">
        <div class="content-input-checkbox">
          <label class="checkbox-wrapper" for="is-leader">
            <input
              type="checkbox"
              name="roles_in_own_community"
              value="responsable"
              id="is-leader"
            />
            <div class="checkmark">
              <CheckIcon class="icon-check" />
            </div>
            <span class="label-span">Soy responsable de mi comunidad</span>
          </label>
        </div>

        <div class="content-input-checkbox">
          <label class="checkbox-wrapper" for="is-coleader">
            <input
              type="checkbox"
              name="roles_in_own_community"
              value="corresponsable"
              id="is-coleader"
            />
            <div class="checkmark">
              <CheckIcon class="icon-check" />
            </div>
            <span class="label-span">Soy corresponsable de mi comunidad</span>
          </label>
        </div>

        <div class="content-input-checkbox">
          <label class="checkbox-wrapper" for="is-didascala">
            <input
              type="checkbox"
              name="roles_in_own_community"
              value="didascala"
              id="is-didascala"
            />
            <div class="checkmark">
              <CheckIcon class="icon-check" />
            </div>
            <span class="label-span">Soy didascala de mi comunidad</span>
          </label>
        </div>

        <div class="content-input-checkbox">
          <label class="checkbox-wrapper" for="is-ostiario">
            <input
              type="checkbox"
              name="roles_in_own_community"
              value="ostiario"
              id="is-ostiario"
            />
            <div class="checkmark">
              <CheckIcon class="icon-check" />
            </div>
            <span class="label-span">Soy ostiario de mi comunidad</span>
          </label>
        </div>

        <div class="content-input-checkbox">
          <label class="checkbox-wrapper" for="is_catechist">
            <input
              type="checkbox"
              name="roles_in_own_community"
              value="catequista"
              id="is_catechist"
            />
            <div class="checkmark">
              <CheckIcon class="icon-check" />
            </div>
            <span class="label-span">Soy catequista de mi comunidad</span>
          </label>
        </div>
      </div>
    </fieldset>

    <!-- === ESTO YA APARECE CUANDO SE HACE CHECK EN SI CATEQUISTA SIN JS === -->
    <!-- en el caso de ser catequistas -->
    <fieldset id="if-catechists-container" class="container-fieldset hidden">
      <legend class="title-container">Comunidades de servicio</legend>
      <div class="flex justify-end" id="add-new-service-catechist">
        <button
          id="add-catechist-community"
          class="btn btn-secondary flex justify-center items-center gap-2"
          type="button"
        >
          <PLusIcon class="size-5 block" />
          <span>Agregar</span>
        </button>
      </div>
      <template id="tmpl-catechist">
        <div
          class="grid grid-cols-[1fr_auto] bg-gray-100 p-4 rounded-xl border border-dashed border-border-dark"
          data-catechist-item
        >
          <div class="space-y-4">
            <div class="content-input">
              <label for="parish_id_catechist">Parroquia</label>
              <select
                name="parish_id_catechist"
                id="parish_id_catechist"
                required
                class="select-input space-y-1"
              >
                <option class="options-select" value="" disabled selected>
                  Selecciona una parroquia
                </option>
                {
                  parishes?.map((parish) => (
                    <option class="options-select" value={parish.id}>
                      {parish.aka} ({parish.tag})
                    </option>
                  ))
                }
              </select>
              <span class="text-xs text-red-400 messsage">
                Si tu parroquia no aparece, registrala primero antes de
                registrarte*
              </span>
            </div>
            <div class="content-input">
              <label for="community_number_in_catechist"
                >Número de Comunidad</label
              >
              <input
                type="number"
                name="community_number_in_catechist"
                id="community_number_in_catechist"
                placeholder="Ej: 3"
                min="1"
                required
                autocomplete="off"
              />
            </div>

            <div class="info-message hidden" data-catechist-community-status>
            </div>
          </div>

          <div class="">
            <button
              type="button"
              class="p-2 border border-red-400 bg-red-200 text-red-500 rounded-full cursor-pointer"
              data-remove-catechist
            >
              <PLusIcon class="block size-5 transform rotate-45" />
            </button>
          </div>
        </div>
      </template>
    </fieldset>
  </div>

  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-add-brotherc"
    slot="footer"
  >
    Cancelar
  </button>

  <button type="submit" class="btn btn-primary flex-1" slot="footer">
    Registrar Hermano
  </button>
</ModalDesign>

<style>
  .is-readonly {
    padding: 0.5rem;
    background-color: var(--color-gray-50);
    border: 1px dashed var(--color-gray-200);
    border-radius: 0.5rem;
    opacity: 0.5;
    cursor: not-allowed;

    & label {
      pointer-events: none;
      cursor: not-allowed;
    }

    & input {
      pointer-events: none;
      cursor: not-allowed;
    }
  }
  .container-fieldset.hidden {
    display: none;
  }
  #roles-brothers:has(#is_catechist:checked) ~ #if-catechists-container {
    display: block;
    animation: aparence 300ms ease;
  }
  .content-single-phone {
    animation: aparence 300ms ease;
  }
  .container-contents-inputs:has(#ratio-matrimonio:checked)
    ~ .content-single-phone {
    display: none;
  }
</style>

<script>
  import { setupModalCloseHandlers } from "@/scripts/modalClose";
  import { showNotification } from "@/scripts/notification";
  import { $id, $$ } from "@/utils/selectElementsDom";
  document.addEventListener("astro:page-load", () => {
    const $modal = $id("modal-add-brotherc") as HTMLElement;
    const $form = $id("modal-brotherc-form") as HTMLFormElement | null;
    const $submitButton = $form?.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement | null;
    const $modalTitle = $modal?.querySelector(
      ".modal-title",
    ) as HTMLElement | null;
    const $civilIndicator = $id("civil-indicator") as HTMLElement | null;
    const civilStatusRadios = $$(
      'input[name="civil_status"]',
    ) as NodeListOf<HTMLInputElement>;

    const $rolesFieldset = $id("roles-brothers") as HTMLFieldSetElement | null;
    const $catechistsFieldset = $id(
      "if-catechists-container",
    ) as HTMLFieldSetElement | null;
    const $addCatechistBtn = $id(
      "add-catechist-community",
    ) as HTMLElement | null;
    const $catechistTemplate = $id(
      "tmpl-catechist",
    ) as HTMLTemplateElement | null;

    const $brotherIdHidden = $id("brother-id") as HTMLInputElement | null;
    const $parishIdHidden = $id("parish-id-hidden") as HTMLInputElement | null;
    const $communityNumberHidden = $id(
      "community-number-hidden",
    ) as HTMLInputElement | null;
    const $levelPasoHidden = $id(
      "level-paso-hidden",
    ) as HTMLInputElement | null;

    const $husbandContainer = $id("husband-container") as HTMLElement | null;
    const $wifeContainer = $id("wife-container") as HTMLElement | null;
    const $husbandBlock = $id("husband-block") as HTMLElement | null;
    const $husbandPhoneBlock = $id("husband-phone-block") as HTMLElement | null;
    const $wifeBlock = $id("wife-block") as HTMLElement | null;
    const $wifePhoneBlock = $id("wife-phone-block") as HTMLElement | null;

    const $ratioMatrimonio = $id("ratio-matrimonio") as HTMLInputElement | null;
    const $ratioSoltero = $id("ratio-soltero") as HTMLInputElement | null;
    const $ratioSoltera = $id("ratio-soltera") as HTMLInputElement | null;

    const $husbandNameInput = $id("husband_name") as HTMLInputElement | null;
    const $husbandPhoneInput = $id("husband_phone") as HTMLInputElement | null;
    const $wifeNameInput = $id("wife_name") as HTMLInputElement | null;
    const $wifePhoneInput = $id("wife_phone") as HTMLInputElement | null;
    const $fullNameInput = $id("full_name") as HTMLInputElement | null;
    const $singlePhoneInput = $id("phone_soltero") as HTMLInputElement | null;
    const $catechistRoleCheckbox = $id(
      "is_catechist",
    ) as HTMLInputElement | null;

    let currentCommunityId: string | null = null;

    let isEditMode = false;
    let editingBrotherId: string | null = null;
    let editingSpouseRole: "esposo" | "esposa" | null = null;

    // Función para abrir el modal (crear)
    function openBrotherchModal(communityId?: string | null) {
      currentCommunityId = communityId ?? null;
      isEditMode = false;
      editingBrotherId = null;
      editingSpouseRole = null;

      if ($modalTitle) $modalTitle.textContent = "Registrar Hermano";
      if ($submitButton) $submitButton.textContent = "Registrar Hermano";
      if ($brotherIdHidden) $brotherIdHidden.value = "";
      if ($parishIdHidden) $parishIdHidden.value = "";
      if ($communityNumberHidden) $communityNumberHidden.value = "";
      if ($levelPasoHidden) $levelPasoHidden.value = "";

      if ($husbandContainer) $husbandContainer.classList.remove("is-readonly");
      if ($wifeContainer) $wifeContainer.classList.remove("is-readonly");
      if ($husbandBlock) $husbandBlock.classList.remove("is-readonly");
      if ($husbandPhoneBlock)
        $husbandPhoneBlock.classList.remove("is-readonly");
      if ($wifeBlock) $wifeBlock.classList.remove("is-readonly");
      if ($wifePhoneBlock) $wifePhoneBlock.classList.remove("is-readonly");

      $modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      updateCivilIndicator();
    }

    const applySpouseReadonly = (
      civilStatus: string,
      role: "esposo" | "esposa" | null,
    ) => {
      if ($husbandContainer) $husbandContainer.classList.remove("is-readonly");
      if ($wifeContainer) $wifeContainer.classList.remove("is-readonly");

      if ($husbandBlock) $husbandBlock.classList.remove("is-readonly");
      if ($husbandPhoneBlock)
        $husbandPhoneBlock.classList.remove("is-readonly");
      if ($wifeBlock) $wifeBlock.classList.remove("is-readonly");
      if ($wifePhoneBlock) $wifePhoneBlock.classList.remove("is-readonly");

      if (civilStatus !== "matrimonio") return;
      if (!role) return;

      if (role === "esposo") {
        if ($wifeContainer) $wifeContainer.classList.add("is-readonly");
      }

      if (role === "esposa") {
        if ($husbandContainer) $husbandContainer.classList.add("is-readonly");
      }
    };

    const syncCatechistFieldsetVisibility = () => {
      if (!$catechistsFieldset) return;
      if ($catechistRoleCheckbox?.checked) {
        $catechistsFieldset.classList.remove("hidden");
      } else {
        $catechistsFieldset.classList.add("hidden");
        clearCatechistItems();
      }
    };

    const clearCatechistItems = () => {
      if (!$catechistsFieldset) return;
      $catechistsFieldset
        .querySelectorAll("[data-catechist-item]")
        .forEach((item) => item.remove());
    };

    const appendCatechistItemsToFormData = (fd: FormData) => {
      if (!$catechistsFieldset) {
        fd.set("catechist_count", "0");
        return;
      }

      const items = Array.from(
        $catechistsFieldset.querySelectorAll<HTMLElement>(
          "[data-catechist-item]",
        ),
      );

      fd.set("catechist_count", String(items.length));

      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        const parishSel = item.querySelector(
          "#parish_id_catechist",
        ) as HTMLSelectElement | null;
        const commInput = item.querySelector(
          "#community_number_in_catechist",
        ) as HTMLInputElement | null;

        fd.set(`catechist_parish_${i}`, parishSel?.value || "");
        fd.set(`catechist_community_${i}`, commInput?.value || "");
      }
    };

    async function openEditBrotherModal(
      brotherId: string,
      role?: "esposo" | "esposa",
    ) {
      isEditMode = true;
      editingBrotherId = brotherId;
      editingSpouseRole = role ?? null;
      currentCommunityId = null;

      if ($modalTitle) $modalTitle.textContent = "Editar Hermano";
      if ($submitButton) $submitButton.textContent = "Guardar cambios";
      if ($brotherIdHidden) $brotherIdHidden.value = brotherId;

      $modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";

      try {
        const res = await fetch(`/api/brothers/${brotherId}`);
        const json = await res.json();

        if (!res.ok || !json?.success || !json?.data) {
          showNotification(
            json?.error || "No se pudo cargar el hermano",
            "error",
            5000,
          );
          return;
        }

        const data = json.data as any;
        const spouse = data.spouse as any | null;

        if ($parishIdHidden)
          $parishIdHidden.value = String(data?.parish?.id ?? "");
        if ($communityNumberHidden)
          $communityNumberHidden.value = String(data?.community?.number ?? "");
        if ($levelPasoHidden)
          $levelPasoHidden.value = String(data?.community?.level_paso ?? "");

        const civilStatus = String(data?.civil_status ?? "soltero");
        if (civilStatus === "matrimonio") {
          if ($ratioMatrimonio) $ratioMatrimonio.checked = true;
        } else if (civilStatus === "soltera") {
          if ($ratioSoltera) $ratioSoltera.checked = true;
        } else {
          if ($ratioSoltero) $ratioSoltero.checked = true;
        }

        if (civilStatus === "matrimonio" && spouse?.id) {
          const currentIdNum = Number(data.id);
          const spouseIdNum = Number(spouse.id);
          const husbandId = Math.min(currentIdNum, spouseIdNum);
          const husband = currentIdNum === husbandId ? data : spouse;
          const wife = currentIdNum === husbandId ? spouse : data;

          if ($husbandNameInput) $husbandNameInput.value = husband?.names ?? "";
          if ($husbandPhoneInput)
            $husbandPhoneInput.value = husband?.phone ?? "";
          if ($wifeNameInput) $wifeNameInput.value = wife?.names ?? "";
          if ($wifePhoneInput) $wifePhoneInput.value = wife?.phone ?? "";
          if ($fullNameInput) $fullNameInput.value = "";
          if ($singlePhoneInput) $singlePhoneInput.value = "";

          applySpouseReadonly("matrimonio", editingSpouseRole);
        } else {
          if ($fullNameInput) $fullNameInput.value = data?.names ?? "";
          if ($singlePhoneInput) $singlePhoneInput.value = data?.phone ?? "";
          if ($husbandNameInput) $husbandNameInput.value = "";
          if ($husbandPhoneInput) $husbandPhoneInput.value = "";
          if ($wifeNameInput) $wifeNameInput.value = "";
          if ($wifePhoneInput) $wifePhoneInput.value = "";
          applySpouseReadonly(civilStatus, null);
        }

        const roles = (data?.roles_in_own_community ?? []) as string[];
        const roleCheckboxes = Array.from(
          $form?.querySelectorAll<HTMLInputElement>(
            'input[name="roles_in_own_community"][type="checkbox"]',
          ) ?? [],
        );
        roleCheckboxes.forEach((cb) => {
          cb.checked = roles.includes(cb.value);
        });

        clearCatechistItems();
        const catechists = (data?.catechist_of_communities ?? []) as any[];

        if ($catechistRoleCheckbox) {
          $catechistRoleCheckbox.checked = catechists.length > 0;
        }

        syncCatechistFieldsetVisibility();

        if ($catechistsFieldset && $catechistTemplate) {
          for (const item of catechists) {
            const clone = $catechistTemplate.content.cloneNode(
              true,
            ) as DocumentFragment;
            $catechistsFieldset.appendChild(clone);

            const last = Array.from(
              $catechistsFieldset.querySelectorAll<HTMLElement>(
                "[data-catechist-item]",
              ),
            ).at(-1);

            const parishSel = last?.querySelector(
              "#parish_id_catechist",
            ) as HTMLSelectElement | null;
            const commInput = last?.querySelector(
              "#community_number_in_catechist",
            ) as HTMLInputElement | null;

            if (parishSel && item?.parish_id != null) {
              parishSel.value = String(item.parish_id);
            }
            if (commInput && item?.community_number != null) {
              commInput.value = String(item.community_number);
            }
          }
        }

        updateCivilIndicator();
        void onCatechistInputChanged();
      } catch (err) {
        console.error("Error cargando hermano para editar:", err);
        showNotification(
          "Error de conexión al cargar el hermano",
          "error",
          5000,
        );
      }
    }
    function updateCivilIndicator() {
      if (!$civilIndicator) return;
      const radios = Array.from(civilStatusRadios);
      const activeIndex = radios.findIndex((radio) => radio.checked);
      if (activeIndex === -1) return;
      const translateValue = activeIndex * 100;
      $civilIndicator.style.transform = `translateX(${translateValue}%)`;
    }

    function closeModalAddBrotherc() {
      $modal?.classList.add("hidden");
      document.body.style.overflow = "";

      currentCommunityId = null;
      isEditMode = false;
      editingBrotherId = null;
      editingSpouseRole = null;
      $form?.reset();

      clearCatechistItems();

      if ($husbandContainer) $husbandContainer.classList.remove("is-readonly");
      if ($wifeContainer) $wifeContainer.classList.remove("is-readonly");
      if ($husbandBlock) $husbandBlock.classList.remove("is-readonly");
      if ($husbandPhoneBlock)
        $husbandPhoneBlock.classList.remove("is-readonly");
      if ($wifeBlock) $wifeBlock.classList.remove("is-readonly");
      if ($wifePhoneBlock) $wifePhoneBlock.classList.remove("is-readonly");

      if ($modalTitle) $modalTitle.textContent = "Registrar Hermano";
      if ($submitButton) $submitButton.textContent = "Registrar Hermano";
    }

    setupModalCloseHandlers("modal-add-brotherc", () => {
      closeModalAddBrotherc();
    });

    civilStatusRadios.forEach((radio) => {
      radio.addEventListener("change", () => {
        updateCivilIndicator();
      });
    });

    $catechistRoleCheckbox?.addEventListener("change", () => {
      syncCatechistFieldsetVisibility();
      void onCatechistInputChanged();
    });

    const setSubmitEnabled = (enabled: boolean) => {
      if (!$submitButton) return;
      $submitButton.disabled = !enabled;
    };

    const validateCatechistCommunities = async (): Promise<boolean> => {
      if (!$catechistsFieldset) return true;

      const items = Array.from(
        $catechistsFieldset.querySelectorAll<HTMLElement>(
          "[data-catechist-item]",
        ),
      );

      if (items.length === 0) return true;

      let allValid = true;

      for (const item of items) {
        const parishSel = item.querySelector(
          "#parish_id_catechist",
        ) as HTMLSelectElement | null;
        const commInput = item.querySelector(
          "#community_number_in_catechist",
        ) as HTMLInputElement | null;
        const statusEl = item.querySelector(
          "[data-catechist-community-status]",
        ) as HTMLElement | null;

        if (statusEl) {
          statusEl.classList.add("hidden");
          statusEl.textContent = "";
          statusEl.classList.remove("warning", "success");
        }

        const parishId = parishSel?.value;
        const commNumber = commInput?.value;

        if (!parishId || !commNumber) {
          allValid = false;
          if (statusEl) {
            statusEl.textContent = "Selecciona parroquia y número de comunidad";
            statusEl.classList.remove("hidden", "success");
            statusEl.classList.add("warning");
          }
          continue;
        }

        try {
          const res = await fetch(
            `/api/parishes/${parishId}/communities/${commNumber}`,
          );
          const json = await res.json();

          if (!json?.exists) {
            allValid = false;
            if (statusEl) {
              statusEl.textContent =
                "Esta comunidad aún no existe. Debes registrarla primero.";
              statusEl.classList.remove("hidden", "success");
              statusEl.classList.add("warning");
            }
          } else {
            if (statusEl) {
              statusEl.textContent = "✓ Comunidad encontrada";
              statusEl.classList.remove("hidden", "warning");
              statusEl.classList.add("success");
            }
          }
        } catch {
          allValid = false;
          if (statusEl) {
            statusEl.textContent = "Error verificando la comunidad";
            statusEl.classList.remove("hidden", "success");
            statusEl.classList.add("warning");
          }
        }
      }

      return allValid;
    };

    const onCatechistInputChanged = async () => {
      const ok = await validateCatechistCommunities();
      setSubmitEnabled(ok);
    };

    if ($addCatechistBtn && $catechistsFieldset && $catechistTemplate) {
      $addCatechistBtn.addEventListener("click", () => {
        const clone = $catechistTemplate.content.cloneNode(
          true,
        ) as DocumentFragment;
        $catechistsFieldset.appendChild(clone);
        void onCatechistInputChanged();
      });

      $catechistsFieldset.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const removeBtn = target.closest(
          "[data-remove-catechist]",
        ) as HTMLElement | null;
        if (removeBtn) {
          const item = removeBtn.closest("[data-catechist-item]");
          if (item) item.remove();
          void onCatechistInputChanged();
        }
      });

      $catechistsFieldset.addEventListener("change", () => {
        void onCatechistInputChanged();
      });

      $catechistsFieldset.addEventListener("input", () => {
        void onCatechistInputChanged();
      });
    }

    if ($rolesFieldset) {
      $rolesFieldset.addEventListener("change", () => {
        void onCatechistInputChanged();
      });
    }

    if ($form) {
      $form.addEventListener("submit", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        if (isEditMode) {
          if (!editingBrotherId) {
            showNotification(
              "No se pudo determinar el hermano a editar",
              "error",
              4000,
            );
            return;
          }

          const okCatechist = await validateCatechistCommunities();
          if (!okCatechist) {
            showNotification(
              "Hay comunidades de servicio inválidas. Corrige antes de guardar.",
              "error",
              5000,
            );
            setSubmitEnabled(false);
            return;
          }

          const fd = new FormData($form);
          appendCatechistItemsToFormData(fd);

          const originalText = $submitButton?.textContent;
          if ($submitButton) {
            $submitButton.disabled = true;
            $submitButton.textContent = "Guardando...";
          }

          try {
            const response = await fetch(`/api/brothers/${editingBrotherId}`, {
              method: "PUT",
              body: fd,
            });
            const result = await response.json();

            if (response.ok && result.success) {
              closeModalAddBrotherc();
              showNotification(
                result.message || "¡Hermano actualizado exitosamente!",
                "success",
                3000,
              );

              if (typeof (window as any).refreshBrothers === "function") {
                await (window as any).refreshBrothers();
              } else {
                setTimeout(() => window.location.reload(), 800);
              }
            } else {
              showNotification(
                result.error || "Error al actualizar el hermano",
                "error",
                5000,
              );
            }
          } catch (error) {
            console.error("Error actualizando hermano:", error);
            showNotification(
              "Error de conexión al actualizar el hermano",
              "error",
              5000,
            );
          } finally {
            if ($submitButton) {
              $submitButton.disabled = false;
              $submitButton.textContent = originalText || "Guardar cambios";
            }
          }

          return;
        }

        if (!currentCommunityId) {
          showNotification(
            "No se pudo determinar la comunidad actual",
            "error",
            4000,
          );
          return;
        }

        const okCatechist = await validateCatechistCommunities();
        if (!okCatechist) {
          showNotification(
            "Hay comunidades de servicio inválidas. Corrige antes de guardar.",
            "error",
            5000,
          );
          setSubmitEnabled(false);
          return;
        }

        const formData = new FormData($form);
        const civil_status = (formData.get("civil_status") as string) || "";

        const data: any = {
          civil_status,
          phone: (formData.get("phone") as string) || undefined,
          husband_phone: (formData.get("husband_phone") as string) || undefined,
          wife_phone: (formData.get("wife_phone") as string) || undefined,
          roles_in_own_community: formData.getAll("roles_in_own_community"),
          catechist_communities: [],
        };

        if (civil_status === "matrimonio") {
          data.husband_name = formData.get("husband_name") as string;
          data.wife_name = formData.get("wife_name") as string;
        } else {
          data.full_name = formData.get("full_name") as string;
        }

        if ($catechistsFieldset) {
          const items = Array.from(
            $catechistsFieldset.querySelectorAll<HTMLElement>(
              "[data-catechist-item]",
            ),
          );

          for (const item of items) {
            const parishSel = item.querySelector(
              "#parish_id_catechist",
            ) as HTMLSelectElement | null;
            const commInput = item.querySelector(
              "#community_number_in_catechist",
            ) as HTMLInputElement | null;

            if (parishSel?.value && commInput?.value) {
              data.catechist_communities.push({
                parish_id: Number(parishSel.value),
                community_number: Number(commInput.value),
              });
            }
          }
        }

        const originalText = $submitButton?.textContent;
        if ($submitButton) {
          $submitButton.disabled = true;
          $submitButton.textContent = "Registrando...";
        }

        try {
          const response = await fetch(
            `/api/communities/${currentCommunityId}/brothers`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data),
            },
          );
          const result = await response.json();

          if (response.ok && result.success) {
            closeModalAddBrotherc();
            showNotification(
              result.message || "¡Hermano registrado exitosamente!",
              "success",
              3000,
            );

            if (typeof (window as any).refreshBrothers === "function") {
              await (window as any).refreshBrothers();
            } else {
              setTimeout(() => window.location.reload(), 800);
            }
          } else {
            showNotification(
              result.error || "Error al registrar el hermano",
              "error",
              5000,
            );
          }
        } catch (error) {
          console.error("Error registrando hermano:", error);
          showNotification(
            "Error de conexión al registrar el hermano",
            "error",
            5000,
          );
        } finally {
          if ($submitButton) {
            $submitButton.disabled = false;
            $submitButton.textContent = originalText || "Registrar Hermano";
          }
        }
      });
    }

    // updateCivilIndicator();
    (window as any).openBrotherchModal = openBrotherchModal;
    (window as any).openEditBrotherModal = openEditBrotherModal;
    (window as any).closeModalAddBrotherc = closeModalAddBrotherc;
  });
</script>
