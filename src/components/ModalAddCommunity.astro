---
import { actions } from "astro:actions";
import ModalDesign from "./ModalDesign.astro";
import { pasosListaPlana } from "@/datos/pasos-list";

const action = actions.communitiesAction;
const formData = {
  idForm: "form-add-community",
  method: "POST" as const,
  action: action,
};
---

<ModalDesign
  title="Datos de la comunidad"
  id="modal-add-community"
  isForm
  formData={formData}
>
  <div class="ss" slot="body">
    <fieldset class="container-fieldset">
      <legend class="title-container">Datos de comunidad</legend>
      <div class="space-y-6">
        <!-- input con la id de la parroquia -->
        <input type="hidden" name="parish-id-comm" id="parish-id-comm" />

        <!-- input de id de comunidad para editar -->
        <input type="hidden" name="community-id" id="community-id" />

        <div class="content-input">
          <label for="number-comm">Numero de comunidad</label>
          <input
            type="number"
            name="number-comm"
            id="number-comm"
            min="1"
            required
          />
        </div>
        <div class="content-input">
          <label for="level-comm">Paso actual</label>
          <select name="level-comm" id="level-comm" class="select-input">
            <option value="" disabled selected>Selecciona un paso</option>
            {
              pasosListaPlana.map((paso) => (
                <option class="options-select" value={paso}>
                  {paso}
                </option>
              ))
            }
          </select>
        </div>
      </div>
    </fieldset>
    <p
      id="message-error-parish"
      class="mt-4 hidden text-center w-full text-red-400"
    >
      Ya existe una comunidad con ese número...
    </p>
  </div>

  <!-- <div class="flex w-full"> -->
  <button
    slot="footer"
    type="button"
    class="btn btn-secondary w-full"
    data-close="modal-add-community"
  >
    Cancelar
  </button>
  <button
    slot="footer"
    type="submit"
    class="btn btn-primary w-full"
    id="modal-add-community-submit"
  >
    Agregar
  </button>
  <!-- </div> -->
</ModalDesign>

<script>
  import { actions } from "astro:actions";
  import { $id } from "@/utils/selectElementsDom";
  import { setupModalCloseHandlers } from "@/scripts/modalClose";
  import { showNotification } from "@/scripts/notification";
  import type { CommunityByIdParish } from "@/types/community";

  document.addEventListener("astro:page-load", () => {
    const form = $id("form-add-community") as HTMLFormElement;
    const mdl = $id("modal-add-community") as HTMLDivElement;
    const mdlTitle = mdl?.querySelector("h2");
    const sbtBtn = $id("modal-add-community-submit") as HTMLButtonElement;
    const msgErrr = $id("message-error-parish") as HTMLParagraphElement;

    const inpCommId = $id("community-id") as HTMLInputElement;
    const inpNumberComm = $id("number-comm") as HTMLInputElement;
    const inpLevelComm = $id("level-comm") as HTMLSelectElement;
    const inpParishId = $id("parish-id-comm") as HTMLInputElement;

    function textModal(title: string, submitBtnText: string) {
      if (mdlTitle) mdlTitle.textContent = title;
      if (sbtBtn) sbtBtn.textContent = submitBtnText;
      form.reset();
    }

    function closedModalCommunity() {
      mdl?.classList.add("hidden");
      form.reset();
    }

    function openModalAddComm(parishId: string) {
      console.log(parishId);
      textModal("Agregar Comunidad", "Agregar");
      mdl?.classList.remove("hidden");
      if (inpParishId) inpParishId.value = parishId;
    }

    function openEditModalComm(parishId: string, comm: CommunityByIdParish) {
      console.log(comm);
      textModal("Editar Comunidad", "Guardar");
      if (!inpCommId || !inpNumberComm || !inpParishId || !inpLevelComm) return;
      inpCommId.value = String(comm.id);
      inpNumberComm.value = String(comm.number_community);
      inpLevelComm.value = comm.level_paso ?? "";
      inpParishId.value = parishId;
      mdl?.classList.remove("hidden");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const id = formData.get("community-id");
      const number_community = Number(formData.get("number-comm"));
      const level_paso = formData.get("level-comm") as string;
      const parish_id = Number(formData.get("parish-id-comm"));
      const info = id
        ? { id: Number(id), number_community, level_paso, parish_id }
        : { number_community, level_paso, parish_id };

      console.log("Submitting community:", info);

      const { data, error } = await actions.communitiesAction(info);
      if (error) {
        msgErrr.textContent = error.message;
        msgErrr.classList.remove("hidden");
      } else {
        closedModalCommunity();
        showNotification("Comunidad agregada exitosamente", "success");
        form.reset();
        window.dispatchEvent(new CustomEvent("community:created"));
      }
    });

    setupModalCloseHandlers("modal-add-community", closedModalCommunity);
    (window as any).openModalAddComm = openModalAddComm;
    (window as any).openEditModalComm = openEditModalComm;
  });
</script>
