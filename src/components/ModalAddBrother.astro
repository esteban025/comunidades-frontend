---
// Modal para agregar hermano
import ModalDesign from "./ModalDesign.astro";
import { pasosListaPlana } from "@/datos/pasos-list";
import type { Parish } from "@/types/parishes";
import { getParishes } from "@/services/parishes";
import PLusIcon from "@/assets/PLusIcon.astro";
const parishes: Parish[] = await getParishes();
// const civilStatus = ["matrimonio", "soltero", "soltera"];
---

<ModalDesign
  id="modal-brother"
  title="Registrar Hermano"
  idForm="modal-brother-form"
  isForm={true}
>
  <div class="flex flex-col gap-6" slot="body">
    <!-- Campo oculto para el ID (usado en edición) -->
    <input type="hidden" id="brother-id" name="brother_id" />

    <!-- Sección 1: Datos Personales -->
    <fieldset class="container-fieldset">
      <legend class="title-container">Datos Personales</legend>

      <div class="container-contents-inputs">
        <div class="space-y-2">
          <h3>Estado civil</h3>
          <div class="wrapper space-y-4">
            <div class="ratios-row">
              <div class="ss">
                <input
                  type="radio"
                  name="civil_status"
                  id="ratio-matrimonio"
                  value="matrimonio"
                  class="checks-btns"
                  data-index="0"
                />
                <label for="ratio-matrimonio" class="radio-label"
                  >Matrimonio</label
                >
              </div>
              <div class="ss">
                <input
                  type="radio"
                  name="civil_status"
                  id="ratio-soltero"
                  value="soltero"
                  class="checks-btns"
                  checked
                  data-index="1"
                />
                <label for="ratio-soltero" class="radio-label">Soltero</label>
              </div>
              <div class="ss">
                <input
                  type="radio"
                  name="civil_status"
                  id="ratio-soltera"
                  class="checks-btns"
                  value="soltera"
                  data-index="2"
                />
                <label for="ratio-soltera" class="radio-label">Soltera</label>
              </div>
              <div
                class="absolute bg-bg-primary rounded-full border border-border-light inset-0 w-1/3 h-full shadow-md transition-all duration-300 pointer-events-none civil-indicator"
              >
              </div>
            </div>

            <div class="fields-row">
              <div id="matrimonio-fields" class="space-y-4">
                <!-- Inputs esposo y esposa -->
                <div class="husband grid grid-cols-2 items-center gap-4">
                  <div id="husband-block" class="husband-c content-input">
                    <label for="husband_name">Nombre del Esposo</label>
                    <input
                      type="text"
                      name="husband_name"
                      id="husband_name"
                      placeholder="Ej: Juan Pérez"
                      autocomplete="off"
                    />
                  </div>

                  <!-- === NUEVO INPUT PARA EL NUMERO DEL ESPOSO === -->

                  <div id="husband-phone-block" class="content-input">
                    <label for="husband_phone"
                      >Teléfono del Esposo (Opcional)</label
                    >
                    <input
                      type="tel"
                      name="husband_phone"
                      id="husband_phone"
                      placeholder="Ej: 0999123456"
                      autocomplete="off"
                    />
                  </div>
                </div>
                <div class="wife grid grid-cols-2 items-center gap-4">
                  <div id="wife-block" class="content-input">
                    <label for="wife_name">Nombre de la Esposa</label>
                    <input
                      type="text"
                      name="wife_name"
                      id="wife_name"
                      placeholder="Ej: María López"
                      autocomplete="off"
                    />
                  </div>

                  <div id="wife-phone-block" class="content-input">
                    <label for="wife_phone"
                      >Teléfono de la Esposa (Opcional)</label
                    >
                    <input
                      type="tel"
                      name="wife_phone"
                      id="wife_phone"
                      placeholder="Ej: 0999123456"
                      autocomplete="off"
                    />
                  </div>
                </div>
              </div>

              <div id="single-field" class="content-input">
                <!-- Input soltero/soltera -->
                <label for="full_name">Nombre Completo</label>
                <input
                  type="text"
                  name="full_name"
                  id="full_name"
                  placeholder="Ej: Pedro García"
                  autocomplete="off"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- telefono en soltero/a -->
      <div class="content-input content-single-phone">
        <label for="phone_soltero">Teléfono (Opcional)</label>
        <input
          type="tel"
          name="phone"
          id="phone_soltero"
          placeholder="Ej: 0999123456"
          autocomplete="off"
        />
      </div>
    </fieldset>

    <!-- Sección 2: Comunidad -->
    <fieldset class="container-fieldset">
      <legend class="title-container">Comunidad</legend>

      <div class="content-input">
        <label for="parish_id">Parroquia</label>
        <select
          name="parish_id"
          id="parish_id"
          required
          class="select-input space-y-1"
        >
          <option class="options-select" value="" disabled selected>
            Selecciona una parroquia
          </option>
          {
            parishes?.map((parish) => (
              <option class="options-select" value={parish.id}>
                {parish.aka} ({parish.tag})
              </option>
            ))
          }
        </select>
        <span class="text-xs text-red-400 messsage">
          Si tu parroquia no aparece, registrala primero antes de registrarte*
        </span>
      </div>

      <input type="hidden" id="parish_id_locked" name="parish_id" disabled />

      <div class="content-input">
        <label for="community_number">Número de Comunidad</label>
        <input
          type="number"
          name="community_number"
          id="community_number"
          placeholder="Ej: 3"
          min="1"
          required
          autocomplete="off"
        />
      </div>

      <input
        type="hidden"
        id="community_number_locked"
        name="community_number"
        disabled
      />

      <div id="community-status" class="info-message hidden"></div>

      <div id="level-paso-field" class="content-input hidden">
        <label for="level_paso">¿En qué paso está la comunidad?</label>
        <select name="level_paso" id="level_paso" class="select-input">
          <option class="options-select" value="" disabled selected
            >Selecciona un paso</option
          >
          {
            pasosListaPlana.map((paso) => (
              <option class="options-select" value={paso}>
                {paso}
              </option>
            ))
          }
        </select>
        <span class="text-xs text-neutral-600"
          >La comunidad no existe. Ingresa el paso para crearla</span
        >
      </div>
    </fieldset>

    <!-- Sección 3: Roles -->
    <fieldset class="container-fieldset" id="roles-brothers">
      <legend class="title-container">Roles (Opcional)</legend>

      <div class="checkbox-group">
        <label class="checkbox-label">
          <input
            type="checkbox"
            name="roles_in_own_community"
            value="responsable"
          />
          <span>Soy responsable de mi comunidad</span>
        </label>
        <label class="checkbox-label">
          <input
            type="checkbox"
            name="roles_in_own_community"
            value="corresponsable"
          />
          <span>Soy corresponsable de mi comunidad</span>
        </label>
        <label class="checkbox-label">
          <input
            type="checkbox"
            name="roles_in_own_community"
            value="didascala"
          />
          <span>Soy didascala de mi comunidad</span>
        </label>
        <label class="checkbox-label">
          <input
            type="checkbox"
            name="roles_in_own_community"
            value="ostiario"
          />
          <span>Soy ostiario de mi comunidad</span>
        </label>
        <label class="checkbox-label">
          <input
            type="checkbox"
            id="is_catechist"
            name="is_catechist"
            value="1"
          />
          <span>Soy catequista de otras comunidades</span>
        </label>
      </div>
    </fieldset>

    <!-- === ESTO YA APARECE CUANDO SE HACE CHECK EN SI CATEQUISTA SIN JS === -->
    <!-- en el caso de ser catequistas -->
    <fieldset id="if-catechists-container" class="container-fieldset hidden">
      <legend class="title-container">Comunidades de servicio</legend>
      <div class="flex justify-end" id="add-new-service-catechist">
        <button
          id="add-catechist-community"
          class="btn btn-secondary flex justify-center items-center gap-2"
          type="button"
        >
          <PLusIcon class="size-5 block" />
          <span>Agregar</span>
        </button>
      </div>
      <template id="tmpl-catechist">
        <div
          class="grid grid-cols-[1fr_auto] bg-gray-100 p-4 rounded-xl border border-dashed border-border-dark"
          data-catechist-item
        >
          <div class="space-y-4">
            <div class="content-input">
              <label for="parish_id_catechist">Parroquia</label>
              <select
                name="parish_id_catechist"
                id="parish_id_catechist"
                required
                class="select-input space-y-1"
              >
                <option class="options-select" value="" disabled selected>
                  Selecciona una parroquia
                </option>
                {
                  parishes?.map((parish) => (
                    <option class="options-select" value={parish.id}>
                      {parish.aka} ({parish.tag})
                    </option>
                  ))
                }
              </select>
              <span class="text-xs text-red-400 messsage">
                Si tu parroquia no aparece, registrala primero antes de
                registrarte*
              </span>
            </div>
            <div class="content-input">
              <label for="community_number_in_catechist"
                >Número de Comunidad</label
              >
              <input
                type="number"
                name="community_number_in_catechist"
                id="community_number_in_catechist"
                placeholder="Ej: 3"
                min="1"
                required
                autocomplete="off"
              />
            </div>
          </div>

          <div class="">
            <button
              type="button"
              class="p-2 border border-red-400 bg-red-200 text-red-500 rounded-full cursor-pointer"
              data-remove-catechist
            >
              <PLusIcon class="block size-5 transform rotate-45" />
            </button>
          </div>
        </div>
      </template>
    </fieldset>
  </div>

  <button
    type="button"
    class="btn btn-secondary flex-1"
    data-close="modal-brother"
    slot="footer"
  >
    Cancelar
  </button>

  <button type="submit" class="btn btn-primary flex-1" slot="footer">
    Registrar Hermano
  </button>
</ModalDesign>

<style>
  #parish_id:valid + .messsage,
  #parish_id_catechist:valid + .messsage {
    display: none;
  }

  .container-fieldset.hidden {
    display: none;
  }

  #roles-brothers:has(#is_catechist:checked) ~ #if-catechists-container {
    display: block;
    animation: aparence 300ms ease;
  }
  .content-single-phone {
    animation: aparence 300ms ease;
  }
  .container-contents-inputs:has(#ratio-matrimonio:checked)
    ~ .content-single-phone {
    display: none;
  }
</style>

<script>
  import { registerBrother } from "@/scripts/registerBrother";
  import { showNotification } from "@/scripts/notification";

  // Función para actualizar hermano
  async function updateBrother(brotherId: string, formData: FormData) {
    try {
      const response = await fetch(`/api/brothers/${brotherId}`, {
        method: "PUT",
        body: formData,
      });

      return await response.json();
    } catch (error) {
      console.error("Error actualizando hermano:", error);
      return {
        success: false,
        error: "Error de conexión al actualizar el hermano",
      };
    }
  }

  document.addEventListener("astro:page-load", () => {
    const $id = (selector: string) => document.getElementById(selector);
    const $ = (selector: string) => document.querySelector(selector);
    const $$ = (selector: string) => document.querySelectorAll(selector);

    const modal = $id("modal-brother");
    const form = $id("modal-brother-form") as HTMLFormElement;
    const closeButtons = $$('[data-close="modal-brother"]');
    const $civilIndicator = $(".civil-indicator") as HTMLElement;

    // Elementos del formulario
    const civilStatusRadios = $$('input[name="civil_status"]');
    const matrimonioFields = $id("matrimonio-fields");
    const singleField = $id("single-field");
    const parishSelect = $id("parish_id") as HTMLSelectElement;
    const communityNumber = $id("community_number") as HTMLInputElement;
    const communityStatus = $id("community-status");
    const levelPasoField = $id("level-paso-field");
    // const isCatechistCheckbox = $id("is_catechist") as HTMLInputElement;
    const catechistsFieldset = $id(
      "if-catechists-container",
    ) as HTMLFieldSetElement | null;
    const addCatechistBtn = $id("add-catechist-community");
    const catechistTemplate = $id(
      "tmpl-catechist",
    ) as HTMLTemplateElement | null;

    // Función para abrir el modal
    function openBrotherModal() {
      // Resetear el formulario y el título para nuevo registro
      form?.reset();
      const brotherIdInput = $id("brother-id") as HTMLInputElement;
      if (brotherIdInput) brotherIdInput.value = "";

      const modalTitle = $("#modal-brother h2");
      if (modalTitle) modalTitle.textContent = "Registrar Hermano";

      const submitBtn = form?.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      if (submitBtn) submitBtn.textContent = "Registrar Hermano";

      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";

      // Asegurar que el indicador refleje el radio actualmente seleccionado
      updateCivilIndicator();
    }

    // Función para cerrar el modal
    function closeBrotherModal() {
      modal?.classList.add("hidden");
      document.body.style.overflow = "";
      form?.reset();

      // Resetear el ID oculto
      const brotherIdInput = document.getElementById(
        "brother-id",
      ) as HTMLInputElement;
      if (brotherIdInput) brotherIdInput.value = "";

      // Restaurar título y botón
      const modalTitle = document.querySelector("#modal-brother h2");
      if (modalTitle) modalTitle.textContent = "Registrar Hermano";

      const submitBtn = form?.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      if (submitBtn) submitBtn.textContent = "Registrar Hermano";
      if (catechistsFieldset) {
        catechistsFieldset
          .querySelectorAll("[data-catechist-item]")
          .forEach((item) => item.remove());
      }

      // Restaurar edición de parroquia/comunidad (solo se bloquea en modo edición)
      const parishSelectEl = document.getElementById(
        "parish_id",
      ) as HTMLSelectElement | null;
      const communityNumberEl = document.getElementById(
        "community_number",
      ) as HTMLInputElement | null;
      const parishLockedEl = document.getElementById(
        "parish_id_locked",
      ) as HTMLInputElement | null;
      const communityLockedEl = document.getElementById(
        "community_number_locked",
      ) as HTMLInputElement | null;

      if (parishSelectEl) parishSelectEl.disabled = false;
      if (communityNumberEl) communityNumberEl.disabled = false;
      if (parishLockedEl) parishLockedEl.disabled = true;
      if (communityLockedEl) communityLockedEl.disabled = true;
      matrimonioFields?.classList.add("hidden");
      singleField?.classList.add("hidden");
      communityStatus?.classList.add("hidden");
      levelPasoField?.classList.add("hidden");
    }

    function updateCivilIndicator() {
      if (!$civilIndicator) return;

      let activeIndex = 0;
      civilStatusRadios.forEach((radio, i) => {
        const input = radio as HTMLInputElement;
        if (input.checked) {
          const dataIndex = (input as HTMLElement).dataset.index;
          activeIndex = dataIndex ? parseInt(dataIndex) || i : i;
        }
      });

      const translateValue = activeIndex * 100;
      $civilIndicator.style.transform = `translateX(${translateValue}%)`;
    }

    civilStatusRadios.forEach((radio) => {
      radio.addEventListener("change", () => {
        updateCivilIndicator();
      });
    });

    // Inicializar posición del indicador según el radio marcado por defecto
    updateCivilIndicator();

    // Verificar comunidad
    let checkTimeout: any;
    async function checkCommunity() {
      const parishId = parishSelect.value;
      const commNumber = communityNumber.value;

      if (!parishId || !commNumber) {
        communityStatus?.classList.add("hidden");
        levelPasoField?.classList.add("hidden");
        return;
      }

      try {
        const response = await fetch(
          `/api/parishes/${parishId}/communities/${commNumber}`,
        );
        const result = await response.json();

        if (result.exists) {
          const hasLevelPaso =
            result.data.level_paso &&
            result.data.level_paso.trim() !== "" &&
            result.data.level_paso !== "Sin especificar";

          if (hasLevelPaso) {
            // La comunidad existe Y tiene paso definido - ocultar campo level_paso
            communityStatus!.textContent = `✓ Comunidad encontrada: ${result.data.level_paso}`;
            communityStatus?.classList.remove("hidden", "warning");
            communityStatus?.classList.add("success");
            levelPasoField?.classList.add("hidden");

            // Limpiar el campo level_paso si existía algo
            const levelPasoInput = document.getElementById(
              "level_paso",
            ) as HTMLInputElement;
            if (levelPasoInput) {
              levelPasoInput.value = "";
            }
          } else {
            // La comunidad existe PERO NO tiene paso definido - mostrar campo level_paso
            communityStatus!.textContent =
              "⚠ La comunidad existe pero no se ha definido el paso. Ingresa el paso para completar la información.";
            communityStatus?.classList.remove("hidden", "success");
            communityStatus?.classList.add("warning");
            levelPasoField?.classList.remove("hidden");
          }
        } else {
          // La comunidad NO existe - mostrar campo level_paso
          communityStatus!.textContent =
            "⚠ Esta comunidad aun no es registrada. Ingresa el paso para crearla.";
          communityStatus?.classList.remove("hidden", "success");
          communityStatus?.classList.add("warning");
          levelPasoField?.classList.remove("hidden");
        }
      } catch (error) {
        console.error("Error verificando comunidad:", error);
        levelPasoField?.classList.add("hidden");
      }
    }

    parishSelect.addEventListener("change", () => {
      clearTimeout(checkTimeout);
      checkTimeout = setTimeout(checkCommunity, 500);
    });

    communityNumber.addEventListener("input", () => {
      clearTimeout(checkTimeout);
      checkTimeout = setTimeout(checkCommunity, 500);
    });

    // Agregar / eliminar comunidades donde es catequista usando template
    if (addCatechistBtn && catechistsFieldset && catechistTemplate) {
      addCatechistBtn.addEventListener("click", () => {
        const clone = catechistTemplate.content.cloneNode(
          true,
        ) as DocumentFragment;
        catechistsFieldset.appendChild(clone);
      });

      catechistsFieldset.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const removeBtn = target.closest(
          "[data-remove-catechist]",
        ) as HTMLElement | null;
        if (removeBtn) {
          const item = removeBtn.closest("[data-catechist-item]");
          if (item) item.remove();
        }
      });
    }

    // Cerrar modal
    closeButtons.forEach((button) => {
      button.addEventListener("click", closeBrotherModal);
    });

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeBrotherModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
        closeBrotherModal();
      }
    });

    // Submit del formulario
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const formData = new FormData(form);

        // Comunidades donde es catequista
        const catechistItems = catechistsFieldset
          ? Array.from(
              catechistsFieldset.querySelectorAll("[data-catechist-item]"),
            )
          : [];

        // Asegurar que siempre enviamos la misma convención que espera el backend:
        // catechist_count + catechist_parish_i + catechist_community_i
        formData.set("catechist_count", catechistItems.length.toString());

        catechistItems.forEach((item, index) => {
          const parishSel = item.querySelector(
            "#parish_id_catechist",
          ) as HTMLSelectElement | null;
          const commInput = item.querySelector(
            "#community_number_in_catechist",
          ) as HTMLInputElement | null;

          if (parishSel?.value) {
            formData.set(`catechist_parish_${index}`, parishSel.value);
          }
          if (commInput?.value) {
            formData.set(`catechist_community_${index}`, commInput.value);
          }
        });

        const brotherId = (
          document.getElementById("brother-id") as HTMLInputElement
        )?.value;
        const isEditing = !!brotherId;

        const submitButton = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;
        submitButton.disabled = true;
        submitButton.textContent = isEditing
          ? "Actualizando..."
          : "Registrando...";

        let result;
        if (isEditing) {
          // Actualizar hermano existente
          result = await updateBrother(brotherId, formData);
        } else {
          // Registrar nuevo hermano
          result = await registerBrother(formData);
        }

        closeBrotherModal();

        if (result.success) {
          showNotification(
            result.message ||
              (isEditing
                ? "¡Hermano actualizado exitosamente!"
                : "¡Hermano registrado exitosamente!"),
            "success",
            3000,
          );

          // Actualizar la lista de hermanos
          if (typeof (window as any).refreshBrothers === "function") {
            await (window as any).refreshBrothers();
          }
        } else {
          showNotification(
            result.error ||
              (isEditing
                ? "Error al actualizar el hermano"
                : "Error al registrar el hermano"),
            "error",
            5000,
          );
        }

        submitButton.disabled = false;
        submitButton.textContent = isEditing
          ? "Actualizar Hermano"
          : "Registrar Hermano";
      });
    }

    // Hacer disponible globalmente
    (window as any).openBrotherModal = openBrotherModal;

    // Función global para editar hermano
    (window as any).openEditBrotherModal = async (
      brotherId: string,
      role?: string,
    ) => {
      try {
        // Obtener datos del hermano
        const response = await fetch(`/api/brothers/${brotherId}`);
        const result = await response.json();

        if (!result.success || !result.data) {
          showNotification(
            "Error al cargar los datos del hermano",
            "error",
            3000,
          );
          return;
        }

        const brother = result.data;

        // Cambiar título del modal
        const modalTitle = document.querySelector("#modal-brother h2");
        if (modalTitle) modalTitle.textContent = "Editar Hermano";

        // Cambiar texto del botón
        const submitBtn = form?.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;
        if (submitBtn) submitBtn.textContent = "Actualizar Hermano";

        // Llenar campo oculto del ID
        const brotherIdInput = document.getElementById(
          "brother-id",
        ) as HTMLInputElement;
        if (brotherIdInput) brotherIdInput.value = brotherId;

        // Llenar estado civil
        const civilStatusRadio = document.querySelector(
          `input[name="civil_status"][value="${brother.civil_status}"]`,
        ) as HTMLInputElement;
        if (civilStatusRadio) {
          civilStatusRadio.checked = true;
          civilStatusRadio.dispatchEvent(
            new Event("change", { bubbles: true }),
          );
        }

        // Esperar un momento para que se muestren los campos correctos
        setTimeout(() => {
          // Llenar nombres según estado civil
          if (brother.civil_status === "matrimonio") {
            // Resetear nombres de matrimonio a modo editable
            const husbandInput = document.getElementById(
              "husband_name",
            ) as HTMLInputElement | null;
            const wifeInput = document.getElementById(
              "wife_name",
            ) as HTMLInputElement | null;

            const husbandPhoneInput = document.getElementById(
              "husband_phone",
            ) as HTMLInputElement | null;
            const wifePhoneInput = document.getElementById(
              "wife_phone",
            ) as HTMLInputElement | null;

            const husbandBlock = document.getElementById("husband-block");
            const husbandPhoneBlock = document.getElementById(
              "husband-phone-block",
            );
            const wifeBlock = document.getElementById("wife-block");
            const wifePhoneBlock = document.getElementById("wife-phone-block");

            if (husbandInput) {
              husbandInput.readOnly = false;
            }
            if (wifeInput) {
              wifeInput.readOnly = false;
            }
            if (husbandPhoneInput) {
              husbandPhoneInput.readOnly = false;
            }
            if (wifePhoneInput) {
              wifePhoneInput.readOnly = false;
            }

            // Restaurar visibilidad de todos los bloques de matrimonio
            husbandBlock?.classList.remove("hidden");
            husbandPhoneBlock?.classList.remove("hidden");
            wifeBlock?.classList.remove("hidden");
            wifePhoneBlock?.classList.remove("hidden");

            // Rellenar SIEMPRE ambos cónyuges (nombres + teléfonos) para que el backend
            // no rechace el update de matrimonios. Luego ocultamos el bloque no editable.
            const spouse = (brother as any).spouse as {
              id: number;
              names: string;
              phone?: string | null;
            } | null;
            if (!spouse) {
              showNotification(
                "No se pudo cargar la información del cónyuge",
                "error",
                3000,
              );
              return;
            }

            const a = {
              id: Number(brother.id),
              names: String(brother.names || ""),
              phone: (brother.phone as string | null) || "",
            };
            const b = {
              id: Number(spouse.id),
              names: String(spouse.names || ""),
              phone: (spouse.phone as string | null) || "",
            };

            const husband = a.id <= b.id ? a : b;
            const wife = a.id <= b.id ? b : a;

            if (husbandInput) husbandInput.value = husband.names;
            if (wifeInput) wifeInput.value = wife.names;
            if (husbandPhoneInput)
              husbandPhoneInput.value = husband.phone || "";
            if (wifePhoneInput) wifePhoneInput.value = wife.phone || "";

            // Por rol: ocultar el bloque del cónyuge no editado (sin disabled)
            if (role === "esposo") {
              wifeBlock?.classList.add("hidden");
              wifePhoneBlock?.classList.add("hidden");
            } else if (role === "esposa") {
              husbandBlock?.classList.add("hidden");
              husbandPhoneBlock?.classList.add("hidden");
            }
          } else {
            const fullNameInput = document.getElementById(
              "full_name",
            ) as HTMLInputElement;
            if (fullNameInput) fullNameInput.value = brother.names;
          }

          // Llenar teléfono
          const phoneInput = document.getElementById(
            "phone",
          ) as HTMLInputElement;
          if (phoneInput) phoneInput.value = brother.phone || "";

          // Llenar parroquia
          const parishSelect = document.getElementById(
            "parish_id",
          ) as HTMLSelectElement;
          if (parishSelect && brother.parish?.id) {
            parishSelect.value = brother.parish.id.toString();
            parishSelect.dispatchEvent(new Event("change", { bubbles: true }));
          }

          // En modo edición: bloquear cambio de parroquia/número de comunidad.
          // Usamos inputs hidden (mismo name) para que igual se envíen al backend.
          const parishLockedEl = document.getElementById(
            "parish_id_locked",
          ) as HTMLInputElement | null;
          const communityLockedEl = document.getElementById(
            "community_number_locked",
          ) as HTMLInputElement | null;

          if (parishSelect) {
            parishSelect.disabled = true;
          }
          if (parishLockedEl && brother.parish?.id) {
            parishLockedEl.disabled = false;
            parishLockedEl.value = String(brother.parish.id);
          }

          // Esperar a que se carguen las comunidades
          setTimeout(() => {
            // Llenar número de comunidad
            const communityInput = document.getElementById(
              "community_number",
            ) as HTMLInputElement;
            if (communityInput && brother.community?.number) {
              communityInput.value = brother.community.number.toString();
              communityInput.dispatchEvent(
                new Event("input", { bubbles: true }),
              );
            }

            if (communityInput) {
              communityInput.disabled = true;
            }
            if (communityLockedEl && brother.community?.number) {
              communityLockedEl.disabled = false;
              communityLockedEl.value = String(brother.community.number);
            }

            // Llenar roles en su propia comunidad
            if (brother.roles_in_own_community) {
              brother.roles_in_own_community.forEach((role: string) => {
                const checkbox = document.querySelector(
                  `input[name="roles_in_own_community"][value="${role}"]`,
                ) as HTMLInputElement;
                if (checkbox) checkbox.checked = true;
              });
            }

            // Llenar servicios de catequista
            const isCatechistCheckbox = document.getElementById(
              "is_catechist",
            ) as HTMLInputElement | null;

            if (isCatechistCheckbox) {
              isCatechistCheckbox.checked =
                !!brother.catechist_of_communities &&
                brother.catechist_of_communities.length > 0;
            }

            if (
              catechistsFieldset &&
              catechistTemplate &&
              brother.catechist_of_communities &&
              brother.catechist_of_communities.length > 0
            ) {
              // Limpiar items previos
              catechistsFieldset
                .querySelectorAll("[data-catechist-item]")
                .forEach((item) => item.remove());

              brother.catechist_of_communities.forEach((cat: any) => {
                const clone = catechistTemplate.content.cloneNode(
                  true,
                ) as DocumentFragment;
                catechistsFieldset.appendChild(clone);

                const lastItem = catechistsFieldset.querySelector(
                  "[data-catechist-item]:last-of-type",
                ) as HTMLElement | null;

                if (!lastItem) return;

                const parishSel = lastItem.querySelector(
                  "#parish_id_catechist",
                ) as HTMLSelectElement | null;
                const commInput = lastItem.querySelector(
                  "#community_number_in_catechist",
                ) as HTMLInputElement | null;

                if (parishSel && cat.parish_id) {
                  parishSel.value = String(cat.parish_id);
                }
                if (commInput && cat.community_number) {
                  commInput.value = String(cat.community_number);
                }
              });
            }
          }, 300);
        }, 100);

        // Abrir modal
        modal?.classList.remove("hidden");
      } catch (error) {
        console.error("Error cargando datos del hermano:", error);
        showNotification(
          "Error al cargar los datos del hermano",
          "error",
          3000,
        );
      }
    };
  });
</script>
