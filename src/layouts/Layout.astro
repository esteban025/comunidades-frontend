---
import "../styles/global.css";

import Notification from "@/components/Notification.astro";
import HeaderPage from "@/sections/HeaderPage.astro";
import ButtonScrollUp from "@/components/ButtonScrollUp.astro";
import ClientRouter from "astro/components/ClientRouter.astro";
import WaterMark from "@/assets/WaterMark.astro";

import ModalAddParish from "@/components/ModalAddParish.astro";
import ModalViewBrother from "@/components/ModalViewBrother.astro";
import ModalViewCommunity from "@/components/ModalViewCommunity.astro";
import ModalManageCommunities from "@/components/ModalManageCommunities.astro";
import ModalEditCommunity from "@/components/ModalEditCommunity.astro";
import ModalAddConvivencia from "@/components/ModalAddConvivencia.astro";
import ModalMoreInvited from "@/components/ModalMoreInvited.astro";
import ModalConfirmAttendance from "@/components/ModalConfirmAttendance.astro";
import ModalAddCasaConvivencia from "@/components/ModalAddCasaConvivencia.astro";
import ModalAddCommunity from "@/components/ModalAddCommunity.astro";
import ModalAddBrotherc from "@/components/ModalAddBrotherc.astro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Registro de Hermanos | Camino Neocatecumenal</title>
		<ClientRouter />
		<meta
			name="description"
			content="Plataforma para el registro y gestión de hermanos para organizacion en convivencias."
		/>
	</head>
	<body class="relative text-neutral-950 bg-white px-2 mb-24">
		<WaterMark />
		<HeaderPage />
		<ButtonScrollUp />
		<Notification />

		<!-- Modales -->
		<ModalAddParish />
		<ModalViewBrother />
		<ModalViewCommunity />
		<ModalEditCommunity />
		<ModalManageCommunities />
		<ModalAddConvivencia />
		<ModalMoreInvited />
		<ModalConfirmAttendance />
		<ModalAddCasaConvivencia />
		<ModalAddCommunity />
		<ModalAddBrotherc />
		<slot />
	</body>
</html>
