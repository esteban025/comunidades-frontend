---
import "../styles/global.css";
import Notification from "@/components/Notification.astro";
import ModalAddParish from "@/components/ModalAddParish.astro";
import ModalAddBrother from "@/components/ModalAddBrother.astro";
import ModalViewBrother from "@/components/ModalViewBrother.astro";
import ButtonScrollUp from "@/components/ButtonScrollUp.astro";
import ModalViewCommunity from "@/components/ModalViewCommunity.astro";
import ModalManageCommunities from "@/components/ModalManageCommunities.astro";
import HeaderPage from "@/sections/HeaderPage.astro";
import ClientRouter from "astro/components/ClientRouter.astro";
import ModalAddConvivencia from "@/components/ModalAddConvivencia.astro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Registro de Hermanos | Camino Neocatecumenal</title>
		<ClientRouter />
		<meta
			name="description"
			content="Plataforma para el registro y gestión de hermanos para organizacion en convivencias."
		/>
	</head>
	<body class="relative text-neutral-950 bg-white px-2 mb-8">
		<HeaderPage />
		<ButtonScrollUp />
		<Notification />

		<ModalAddParish />
		<ModalAddBrother />
		<ModalViewBrother />
		<ModalViewCommunity />
		<ModalManageCommunities />
		<ModalAddConvivencia />
		<slot />
	</body>
</html>
