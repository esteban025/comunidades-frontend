---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";

import EyeIcon from "@/assets/EyesIcon.astro";
import PencilIcon from "@/assets/PencilIcon.astro";
import DotsVerticalIcon from "@/assets/DotsVerticalIcon.astro";
import ConfigIcon from "@/assets/ConfigIcon.astro";

import { getParishByTag } from "@/services/parishes";
import {
  getCommunityByIdParis,
  getResponsablesByCommunity,
} from "@/services/communities";

import type { Parish } from "@/types/parishes";
import type { CommunityByIdParish } from "@/types/community";
import PLusIcon from "@/assets/PLusIcon.astro";

const { tag } = Astro.params;

// Obtener información de la parroquia por tag
interface Communities extends CommunityByIdParish {
  responsable: string | null;
}
let parishData: Parish | null = null;
let communities: Communities[] = [];
let error = false;

if (!tag) {
  error = true;
} else {
  try {
    // 1. Obtenemos la informaicon de la parroquia por tag
    const parishRows = await getParishByTag(tag);

    if (parishRows && parishRows.length > 0) {
      parishData = parishRows[0];

      // 2. Obtener comunidades con conteo de hermanos
      const commRows = await getCommunityByIdParis(parishData.id);

      // 3. Obtener responsables de cada comunidad
      if (commRows && commRows.length > 0) {
        const communityIds = commRows.map((c: CommunityByIdParish) => c.id);

        const responsablesRows = await getResponsablesByCommunity(communityIds);

        const responsablesMap = new Map<number, Set<string>>();

        responsablesRows?.forEach((r) => {
          if (!responsablesMap.has(r.community_id)) {
            responsablesMap.set(r.community_id, new Set());
          }
          responsablesMap.get(r.community_id)!.add(r.responsable_name);
        });

        communities = commRows.map((comm) => ({
          ...comm,
          responsable: responsablesMap.has(comm.id)
            ? Array.from(responsablesMap.get(comm.id)!).join(", ")
            : null,
        }));
      } else {
        communities = [];
      }
    } else {
      error = true;
    }
  } catch (e) {
    console.error("Error obteniendo datos de parroquia:", e);
    error = true;
  }
}
---

<Layout>
  {
    error ? (
      <SectionContainer
        transition:name="parishes-section"
        title={parishData?.name ?? "Parroquia No Encontrada"}
        description="Detalles de la parroquia y sus comunidades."
      >
        {parishData ? (
          <div
            class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600"
            slot="body"
          >
            Error al cargar las comunidades de la parroquia
          </div>
        ) : (
          <div
            class="bg-white border border-border-light rounded-lg p-6 text-center text-gray-600"
            slot="body"
          >
            <h3 class="text-2xl font-semibold text-text-primary">
              La parroquia con tag "{tag}" no fue encontrada.
            </h3>
            <p class="mt-2 text-sm text-text-muted">
              Verifica que el enlace sea correcto o regresa a la lista de
              parroquias.
            </p>
            <a href="/#section-parishes" class="mt-6 block hover:underline">
              ← Volver a comunidades
            </a>
          </div>
        )}
      </SectionContainer>
    ) : (
      // San Juan Pablo II • Tag: SJPII • 2 comunidades
      <SectionContainer
        transition:name="parishes-section"
        title={parishData?.name ?? ""}
        description={`${parishData?.name ?? ""} • Tag: ${parishData?.tag ?? ""} • ${communities.length} comunidades`}
      >
        <div class="flex gap-2 items-center" slot="nav-links">
          <button
            id="btn-add-comm"
            data-parish-id={parishData?.id}
            class="btn btn-primary flex items-center justify-center gap-2"
          >
            <PLusIcon class="size-4 block" />
            <span>Agregar Comunidad</span>
          </button>
          <button
            onclick="openManageCommunitiesModal()"
            slot="nav-links"
            class="btn btn-secondary flex items-center gap-2"
          >
            <ConfigIcon class="w-6 aspect-square block" />
            <span>Fusion/Reorganizar</span>
          </button>
        </div>
        <div slot="body">
          <div class="container-table">
            {communities.length > 0 ? (
              <table>
                <thead>
                  <tr>
                    <th class="min">N°Com</th>
                    <th>Responsable</th>
                    <th>Paso</th>
                    <th>Total</th>
                    <th class="min">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  {communities.map((community) => (
                    <tr>
                      <td class="text-center">{community.number_community}</td>
                      <td>
                        {community.responsable || "Responsable no registrado"}
                      </td>
                      <td>{community.level_paso || "Sin especificar"}</td>
                      <td class="cell-value">{community.brothers_count}</td>
                      <td>
                        <div class="action-buttons flex justify-center gap-2">
                          <button
                            class="action-btn"
                            title="Ver detalles"
                            data-action="view"
                            data-community-id={community.id}
                            data-community-number={community.number_community}
                          >
                            <EyeIcon class="w-4 h-4" />
                          </button>
                          <button
                            class="action-btn"
                            title="Editar"
                            data-action="edit"
                            data-community-id={community.id}
                            data-community-number={community.number_community}
                            data-level-paso={community.level_paso || ""}
                          >
                            <PencilIcon class="w-4 h-4" />
                          </button>
                          <a
                            class="action-btn"
                            title="Más Detalles"
                            href={`/details-community/${community.id}`}
                          >
                            <DotsVerticalIcon class="w-4 h-4" />
                          </a>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div class="text-center text-gray-500 py-8">
                No hay comunidades registradas en esta parroquia
              </div>
            )}
          </div>
        </div>
        <a href="/" class="hover:underline" slot="footer-link">
          ← Volver a comunidades
        </a>
      </SectionContainer>
    )
  }
</Layout>

<script>
  import { $, $$, $id } from "@/utils/selectElementsDom";
  document.addEventListener("astro:page-load", () => {
    const actionButtons = $$(".action-btn[data-action]");
    const $modal = $id("modal-add-community");
    const $openModal = $id("btn-add-comm");

    // Obtener nombre de la parroquia del header
    const parishNameEl = $("header h1");
    const parishName = parishNameEl?.textContent || "Parroquia";

    $openModal?.addEventListener("click", () => {
      if ($modal) {
        if (typeof (window as any).openModalAddComm === "function") {
          const parishId = ($openModal as HTMLElement | null)?.dataset.parishId;
          (window as any).openModalAddComm(parishId);
        } else {
          console.log("openModalAddComm no está disponible");
        }
      }
    });

    actionButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        e.stopPropagation();
        const action = (button as HTMLElement).dataset.action;
        const communityId = (button as HTMLElement).dataset.communityId;
        const communityNumber = (button as HTMLElement).dataset.communityNumber;
        const levelPaso = (button as HTMLElement).dataset.levelPaso || "";

        switch (action) {
          case "view":
            // Abrir modal de detalles
            if (typeof (window as any).openViewCommunityModal === "function") {
              (window as any).openViewCommunityModal(
                communityId,
                parishName,
                communityNumber,
              );
            }
            break;

          case "edit":
            if (typeof (window as any).openEditCommunityModal === "function") {
              (window as any).openEditCommunityModal(
                communityId as string,
                communityNumber as string,
                levelPaso,
              );
            } else {
              console.error("openEditCommunityModal no está disponible");
            }
            break;

          case "more":
            console.log(
              `Más opciones para comunidad ${communityNumber}, ID: ${communityId}`,
            );
            alert(
              `Más opciones\nComunidad: ${communityNumber}\nID: ${communityId}`,
            );
            // TODO: Mostrar menú con opción de eliminar, etc.
            break;
        }
      });
    });
  });
</script>
