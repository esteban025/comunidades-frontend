---
// COMPONENTS
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import BaseCard from "@/components/BaseCard.astro";

// ICONS
import EyeIcon from "@/assets/EyesIcon.astro";
import PencilIcon from "@/assets/PencilIcon.astro";
import ConfigIcon from "@/assets/ConfigIcon.astro";
import PLusIcon from "@/assets/PLusIcon.astro";
import CursorIcon from "@/assets/CursorIcon.astro";

// SERVICES
import { getParishByTag } from "@/services/parishes";
import { getCommunitiesWithPrimaryResponsableByParishId } from "@/services/communities";

// TYPES
import type { Parish } from "@/types/parishes";
import type { CommunityWithResponsable } from "@/services/communities";

const { tag } = Astro.params;

let parishData: Parish | null = null;
let communities: CommunityWithResponsable[] = [];
let error = false;

if (!tag) {
  error = true;
} else {
  try {
    // 1. Obtenemos la informaicon de la parroquia por tag
    const parishRows = await getParishByTag(tag);

    if (parishRows && parishRows.length > 0) {
      parishData = parishRows[0];

      // 2. Obtener comunidades + responsable principal (helper compartido)
      communities = await getCommunitiesWithPrimaryResponsableByParishId(
        parishData.id,
      );
    } else {
      error = true;
    }
  } catch (e) {
    console.error("Error obteniendo datos de parroquia:", e);
    error = true;
  }
}

const titleSection = parishData?.name ?? "Parroquia no encontrada";
const descriptionSection = error
  ? "No hay detalles, algo salio mal!"
  : `${parishData?.name ?? ""} • Tag: ${parishData?.tag ?? ""} • ${communities.length} comunidades`;
---

<Layout>
  {
    error ? (
      <SectionContainer
        transition:name="parishes-section"
        title={titleSection}
        description={descriptionSection}
      >
        {parishData ? (
          <div
            class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600"
            slot="body"
          >
            Error al cargar las comunidades de la parroquia
          </div>
        ) : (
          <BaseCard slot="body">
            <div class="p-4 flex items-center justify-center flex-col">
              <h3 class="text-2xl font-semibold text-text-primary">
                La parroquia con tag "{tag}" no fue encontrada.
              </h3>
              <p class="mt-2 text-sm text-text-muted">
                Verifica que el enlace sea correcto o regresa a la lista de
                parroquias.
              </p>
              <a href="/" class="mt-6 block hover:underline">
                ← Volver a parroquias
              </a>
            </div>
          </BaseCard>
        )}
      </SectionContainer>
    ) : (
      <SectionContainer
        transition:name="parishes-section"
        title={titleSection}
        description={descriptionSection}
      >
        <div class="flex gap-2 items-center" slot="nav-links">
          <button
            id="btn-add-comm"
            data-parish-id={parishData?.id}
            class="btn btn-primary flex items-center justify-center gap-2"
          >
            <PLusIcon class="size-4 block" />
            <span class="truncate">Agregar Comunidad</span>
          </button>
          <button
            onclick="openManageCommunitiesModal()"
            slot="nav-links"
            class="btn btn-secondary flex items-center gap-2"
          >
            <ConfigIcon class="size-4 block" />
            <span class="truncate">Fusion/Reorganizar</span>
          </button>
        </div>
        <div slot="body">
          <div class="container-table">
            {communities.length > 0 ? (
              <table transition:name={`table-parish-${parishData?.id}`}>
                <thead>
                  <tr>
                    <th class="min">N°Com</th>
                    <th>Responsable</th>
                    <th>Paso</th>
                    <th class="min">Total</th>
                    <th class="min">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  {communities.map((community) => (
                    <tr>
                      <td class="text-center">{community.number_community}</td>
                      <td>
                        {community.responsable || "Responsable no registrado"}
                      </td>
                      <td>{community.level_paso || "Sin especificar"}</td>
                      <td class="text-center">{community.brothers_count}</td>
                      <td>
                        <div class="content-action-btns">
                          <button
                            class="atn-btn"
                            title="Ver detalles"
                            data-action="view"
                            data-community-id={community.id}
                            data-community-number={community.number_community}
                          >
                            <EyeIcon class="size-4 block" />
                          </button>
                          <button
                            class="atn-btn"
                            title="Editar"
                            data-action="edit"
                            data-community-id={community.id}
                            data-community-number={community.number_community}
                            data-level-paso={community.level_paso || ""}
                          >
                            <PencilIcon class="size-4 block" />
                          </button>
                          <a
                            class="atn-btn"
                            title="Más Detalles"
                            href={`/details-community/${community.id}`}
                          >
                            <CursorIcon class="size-4 block transform rotate-90" />
                          </a>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <BaseCard>
                <div class="flex flex-col gap-2 justify-center items-center p-4 min-h-30">
                  <p class="text-center text-text-muted text-sm font-semibold">
                    No hay comunidades rregistradas en esta parroquia
                  </p>
                  <p class="text-center text-xs text-text-muted">
                    Empieza por agregar una comunidad
                  </p>
                </div>
              </BaseCard>
            )}
          </div>
        </div>
        <a
          href={parishData ? `/print/${parishData.id}` : `/print/${tag}`}
          class="hover:underline"
          slot="footer-link"
        >
          Imprimir
        </a>
        <a href="/" class="hover:underline" slot="footer-link">
          ← Volver a parroquias
        </a>
      </SectionContainer>
    )
  }
</Layout>

<script>
  import { $$, $id } from "@/utils/selectElementsDom";
  document.addEventListener("astro:page-load", () => {
    const $atnBtns = $$(
      ".atn-btn[data-action]",
    ) as NodeListOf<HTMLButtonElement>;
    const $modal = $id("modal-add-community") as HTMLElement;
    const $openModal = $id("btn-add-comm") as HTMLButtonElement;

    if (!$atnBtns || !$modal || !$openModal) return;

    $openModal.addEventListener("click", () => {
      if (typeof (window as any).openModalAddComm === "function") {
        const parishId = $openModal.dataset.parishId;
        (window as any).openModalAddComm(parishId);
      } else {
        console.log("openModalAddComm no está disponible");
      }
    });

    (window as any).openManageCommunitiesModal = () => {
      const pid = $openModal.dataset.parishId;
      if (
        typeof (window as any).openManageCommunitiesModalWithParishId ===
        "function"
      ) {
        (window as any).openManageCommunitiesModalWithParishId(pid);
      } else {
        console.error(
          "openManageCommunitiesModalWithParishId no está disponible",
        );
      }
    };

    // boton de acciones view - edit
    $atnBtns.forEach((button: HTMLElement) => {
      button.addEventListener("click", (e) => {
        e.stopPropagation();
        const action = button.dataset.action;
        const communityId = button.dataset.communityId;
        const communityNumber = button.dataset.communityNumber;
        const levelPaso = button.dataset.levelPaso || "";

        switch (action) {
          case "view":
            if (typeof (window as any).openViewCommunityModal === "function") {
              (window as any).openViewCommunityModal(communityId);
            }
            break;

          case "edit":
            if (typeof (window as any).openEditCommunityModal === "function") {
              (window as any).openEditCommunityModal(
                communityId,
                communityNumber,
                levelPaso,
              );
            } else {
              console.error("openEditCommunityModal no está disponible");
            }
            break;

          case "more":
            alert(
              `Más opciones\nComunidad: ${communityNumber}\nID: ${communityId}`,
            );
            break;
        }
      });
    });
  });
</script>
