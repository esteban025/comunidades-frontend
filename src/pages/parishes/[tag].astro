---
import Layout from "@/layouts/Layout.astro";
import HeaderPage from "@/sections/HeaderPage.astro";
import SectionContainer from "@/components/SectionContainer.astro";

import EyeIcon from "@/assets/EyesIcon.astro";
import PencilIcon from "@/assets/PencilIcon.astro";
import DotsVerticalIcon from "@/assets/DotsVerticalIcon.astro";

import { db } from "@/lib/db";

const { tag } = Astro.params;

// Obtener información de la parroquia por tag
let parishData: any = null;
let communities: any[] = [];
let error = false;

if (!tag) {
  error = true;
} else {
  try {
    // 1. Obtener datos de la parroquia
    const parishQuery = `
      SELECT id, name, tag, aka 
      FROM parishes 
      WHERE tag = ?
    `;

    const [parishRows]: any = await db.query(parishQuery, [tag]);

    if (parishRows && parishRows.length > 0) {
      parishData = parishRows[0];

      // 2. Obtener comunidades con conteo de hermanos
      const communitiesQuery = `
        SELECT 
          c.id,
          c.number_community,
          c.level_paso,
          COUNT(DISTINCT b.id) as brothers_count
        FROM communities c
        LEFT JOIN brothers b ON c.id = b.community_id
        WHERE c.parish_id = ?
        GROUP BY c.id, c.number_community, c.level_paso
        ORDER BY c.number_community ASC
      `;

      const [commRows]: any = await db.query(communitiesQuery, [parishData.id]);

      // 3. Obtener responsables de cada comunidad
      if (commRows && commRows.length > 0) {
        const communityIds = commRows.map((c: any) => c.id);
        const responsablesQuery = `
          SELECT 
            br.community_id,
            b.names as responsable_name
          FROM brother_roles br
          INNER JOIN brothers b ON br.brother_id = b.id
          WHERE br.role = 'Responsable'
            AND br.community_id IN (${communityIds.map(() => "?").join(",")})
        `;

        const [responsablesRows]: any = await db.query(
          responsablesQuery,
          communityIds,
        );

        const responsablesMap = new Map();
        responsablesRows?.forEach((r: any) => {
          if (!responsablesMap.has(r.community_id)) {
            responsablesMap.set(r.community_id, []);
          }
          responsablesMap.get(r.community_id).push(r.responsable_name);
        });

        communities = commRows.map((comm: any) => ({
          ...comm,
          responsable: responsablesMap.has(comm.id)
            ? responsablesMap.get(comm.id).join(", ")
            : null,
        }));
      } else {
        communities = [];
      }
    } else {
      error = true;
    }
  } catch (e) {
    console.error("Error obteniendo datos de parroquia:", e);
    error = true;
  }
}
---

<Layout>
  <div class="flex flex-col gap-10">
    <HeaderPage />

    {
      error ? (
        <SectionContainer
          title={parishData ? parishData.name : "Parroquia No Encontrada"}
          description="Detalles de la parroquia y sus comunidades."
        >
          {parishData ? (
            <div
              class="bg-gray-100 border border-gray-300 rounded-full px-6 py-4 text-center text-gray-600"
              slot="body"
            >
              Error al cargar las comunidades de la parroquia
            </div>
          ) : (
            <div
              class="bg-white border border-border-light rounded-lg p-6 text-center text-gray-600"
              slot="body"
            >
              <h3 class="text-2xl font-semibold text-text-primary">
                La parroquia con tag "{tag}" no fue encontrada.
              </h3>
              <p class="mt-2 text-sm text-text-muted">
                Verifica que el enlace sea correcto o regresa a la lista de
                parroquias.
              </p>
              <a href="/#section-parishes" class="mt-6 block hover:underline">
                ← Volver a comunidades
              </a>
            </div>
          )}
        </SectionContainer>
      ) : (
        // San Juan Pablo II • Tag: SJPII • 2 comunidades
        <SectionContainer
          title={parishData.name}
          description={`${parishData.name} • Tag: ${parishData.tag} • ${communities.length} comunidades`}
        >
          <div slot="body">
            <div class="container-table">
              {communities.length > 0 ? (
                <table>
                  <thead>
                    <tr>
                      <th>Número</th>
                      <th>Responsable</th>
                      <th>Paso</th>
                      <th>Total</th>
                      <th>Acciones</th>
                    </tr>
                  </thead>
                  <tbody>
                    {communities.map((community) => (
                      <tr>
                        <td class="cell-main">{community.number_community}</td>
                        <td>
                          {community.responsable || "Responsable no registrado"}
                        </td>
                        <td>{community.level_paso || "Sin especificar"}</td>
                        <td class="cell-value">{community.brothers_count}</td>
                        <td>
                          <div class="action-buttons flex justify-center gap-2">
                            <button
                              class="action-btn"
                              title="Ver detalles"
                              data-action="view"
                              data-community-id={community.id}
                              data-community-number={community.number_community}
                            >
                              <EyeIcon class="w-4 h-4" />
                            </button>
                            <button
                              class="action-btn"
                              title="Editar"
                              data-action="edit"
                              data-community-id={community.id}
                              data-community-number={community.number_community}
                            >
                              <PencilIcon class="w-4 h-4" />
                            </button>
                            <button
                              class="action-btn"
                              title="Más opciones"
                              data-action="more"
                              data-community-id={community.id}
                              data-community-number={community.number_community}
                            >
                              <DotsVerticalIcon class="w-4 h-4" />
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <div class="text-center text-gray-500 py-8">
                  No hay comunidades registradas en esta parroquia
                </div>
              )}
            </div>
          </div>
          <a href="/" class="hover:underline" slot="footer-link">
            ← Volver a comunidades
          </a>
        </SectionContainer>
      )
    }
  </div>

  <!-- Modal para ver detalles de comunidad -->
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const actionButtons = document.querySelectorAll(".action-btn[data-action]");

    // Obtener nombre de la parroquia del header
    const parishNameEl = document.querySelector("header h1");
    const parishName = parishNameEl?.textContent || "Parroquia";

    actionButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        e.stopPropagation();
        const action = (button as HTMLElement).dataset.action;
        const communityId = (button as HTMLElement).dataset.communityId;
        const communityNumber = (button as HTMLElement).dataset.communityNumber;

        switch (action) {
          case "view":
            // Abrir modal de detalles
            if (typeof (window as any).openViewCommunityModal === "function") {
              (window as any).openViewCommunityModal(
                communityId,
                parishName,
                communityNumber,
              );
            }
            break;

          case "edit":
            console.log(
              `Editar comunidad ${communityNumber}, ID: ${communityId}`,
            );
            alert(`Editar\nComunidad: ${communityNumber}\nID: ${communityId}`);
            // TODO: Abrir modal de edición
            break;

          case "more":
            console.log(
              `Más opciones para comunidad ${communityNumber}, ID: ${communityId}`,
            );
            alert(
              `Más opciones\nComunidad: ${communityNumber}\nID: ${communityId}`,
            );
            // TODO: Mostrar menú con opción de eliminar, etc.
            break;
        }
      });
    });
  });
</script>
