---
import Layout from "@/layouts/Layout.astro";
import HeaderPage from "@/sections/HeaderPage.astro";
import HomeIcon from "@/assets/HomeIcon.astro";

// Datos de ejemplo (sin lógica de DB todavía)
const parishes = [
  {
    id: 1,
    name: "San Luis de Gonzaga",
    aka: "Quinta Chica",
    tag: "SLG",
    communities: [
      { number: 1, level_paso: "Paso 2", brothers_count: 15 },
      { number: 2, level_paso: "Shema", brothers_count: 12 },
      { number: 3, level_paso: "Segundo Escrutinio", brothers_count: 18 },
      { number: 4, level_paso: "Paso 1", brothers_count: 20 },
    ],
  },
  {
    id: 2,
    name: "Santa María de la Esperanza",
    aka: "El Vergel",
    tag: "SME",
    communities: [
      { number: 1, level_paso: "Catequesis Inicial", brothers_count: 10 },
      { number: 2, level_paso: "Paso 3", brothers_count: 14 },
    ],
  },
  {
    id: 3,
    name: "Cristo Rey",
    aka: "Centro",
    tag: "CR",
    communities: [
      { number: 1, level_paso: "Primer Escrutinio", brothers_count: 16 },
      { number: 2, level_paso: "Paso 2", brothers_count: 11 },
      { number: 3, level_paso: "Redditio", brothers_count: 13 },
    ],
  },
];
---

<Layout>
  <div class="flex flex-col gap-10">
    <HeaderPage />

    <!-- Sección Principal de Comunidades -->
    <section
      class="w-full max-w-6xl mx-auto bg-gray-50 rounded-xl shadow-md overflow-hidden"
    >
      <header class="p-6 pb-0">
        <div class="flex items-center gap-3 mb-3">
          <HomeIcon class="w-8 h-8 text-gray-600" />
          <h1 class="text-3xl font-bold">Comunidades por Parroquia</h1>
        </div>
        <p class="text-sm text-gray-500">
          Explora todas las comunidades organizadas por parroquia
        </p>
      </header>

      <div class="p-6">
        <!-- Lista de Parroquias con sus Comunidades -->
        {
          parishes.map((parish) => (
            <div class="parish-section mb-8 last:mb-0">
              <!-- Título de Parroquia -->
              <div class="parish-header bg-white rounded-lg p-4 shadow-sm mb-4">
                <h2 class="text-xl font-semibold text-gray-800">
                  {parish.name}
                  <span class="text-gray-500 font-normal text-base ml-2">
                    ({parish.aka})
                  </span>
                </h2>
                <p class="text-sm text-gray-500 mt-1">
                  Tag: <span class="font-medium">{parish.tag}</span> •{" "}
                  {parish.communities.length} comunidad
                  {parish.communities.length !== 1 ? "es" : ""}
                </p>
              </div>

              <!-- Tabla de Comunidades -->
              <div class="communities-table bg-white rounded-lg shadow-sm overflow-hidden">
                <table class="w-full">
                  <thead class="bg-gray-100 border-b-2 border-gray-200">
                    <tr>
                      <th class="text-left py-3 px-4 font-semibold text-sm text-gray-700">
                        Número
                      </th>
                      <th class="text-left py-3 px-4 font-semibold text-sm text-gray-700">
                        Nivel / Paso
                      </th>
                      <th class="text-left py-3 px-4 font-semibold text-sm text-gray-700">
                        Hermanos
                      </th>
                      <th class="text-center py-3 px-4 font-semibold text-sm text-gray-700">
                        Acciones
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {parish.communities.map((community, index) => (
                      <tr
                        class={`border-b border-gray-100 hover:bg-gray-50 transition-colors ${
                          index % 2 === 0 ? "bg-white" : "bg-gray-50/30"
                        }`}
                      >
                        <td class="py-3 px-4">
                          <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-semibold text-sm">
                            {community.number}
                          </span>
                        </td>
                        <td class="py-3 px-4">
                          <span class="text-sm text-gray-700">
                            {community.level_paso}
                          </span>
                        </td>
                        <td class="py-3 px-4">
                          <span class="text-sm text-gray-600">
                            {community.brothers_count} hermano
                            {community.brothers_count !== 1 ? "s" : ""}
                          </span>
                        </td>
                        <td class="py-3 px-4 text-center">
                          <button
                            class="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors"
                            data-parish-id={parish.id}
                            data-community-number={community.number}
                          >
                            Ver detalles →
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))
        }

        <!-- Mensaje si no hay datos -->
        {
          parishes.length === 0 && (
            <div class="text-center py-12">
              <HomeIcon class="w-16 h-16 text-gray-300 mx-auto mb-4" />
              <h3 class="text-xl font-semibold text-gray-600 mb-2">
                No hay comunidades registradas
              </h3>
              <p class="text-gray-500">
                Las comunidades aparecerán aquí cuando se registren hermanos
              </p>
            </div>
          )
        }
      </div>

      <!-- Footer -->
      <footer class="p-6 border-t-2 border-gray-200 bg-white/70">
        <div class="flex justify-between items-center text-gray-500 text-sm">
          <span>
            Total: {
              parishes.reduce(
                (sum, p) => sum + p.communities.length,
                0,
              )
            } comunidades en {parishes.length} parroquia{parishes.length !==
            1
              ? "s"
              : ""}
          </span>
          <a
            href="/"
            class="text-blue-600 hover:text-blue-800 hover:underline font-medium"
          >
            ← Volver al inicio
          </a>
        </div>
      </footer>
    </section>
  </div>
</Layout>

<style>
  .parish-section {
    scroll-margin-top: 2rem;
  }

  table {
    border-collapse: collapse;
  }

  tbody tr:last-child {
    border-bottom: none;
  }

  button[data-parish-id]:hover {
    transform: translateX(2px);
  }

  button[data-parish-id] {
    transition: all 0.2s ease;
  }
</style>

<script>
  // Manejo de clicks en "Ver detalles" (para cuando implementemos la funcionalidad)
  document.addEventListener("DOMContentLoaded", () => {
    const detailButtons = document.querySelectorAll("[data-parish-id]");

    detailButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        const parishId = (button as HTMLElement).dataset.parishId;
        const communityNumber = (button as HTMLElement).dataset
          .communityNumber;

        console.log(
          `Ver detalles de comunidad ${communityNumber} en parroquia ${parishId}`,
        );

        // TODO: Aquí irá la lógica para mostrar detalles de la comunidad
        // Puede ser un modal o redirigir a otra página
        alert(
          `Funcionalidad en desarrollo\nParroquia ID: ${parishId}\nComunidad: ${communityNumber}`,
        );
      });
    });
  });
</script>
