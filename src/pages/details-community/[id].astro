---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import NavbarPage from "@/components/NavbarPage.astro";
import PlusIcon from "@/assets/PlusIcon.astro";
import { BrothersWithRolesCard } from "@/components/BrothersWithRolesCard";

const { id } = Astro.params;
if (!id) {
  throw new Error("ID de comunidad no proporcionado");
}
---

<Layout>
  <div class="flex flex-col gap-6">
    <NavbarPage
      title="Gestion de Hermanos"
      description="Agrega y designa roles a hermanos dentro de esta comunidad"
    >
      <button
        id="btn-add-bro"
        data-comm-id={id}
        class="btn btn-primary flex items-center gap-2"
        slot="actions"
      >
        <PlusIcon class="size-5 block" />
        <span>Agregar Hermano</span>
      </button>
    </NavbarPage>
    <SectionContainer
      title="Grupo de responsables"
      description="Aquí puedes ver los hermanos que tienen roles asignados en esta comunidad."
    >
      <div class="ss" slot="body">
        <BrothersWithRolesCard commId={Number(id)} client:load />
      </div>
    </SectionContainer>

    <SectionContainer>
      <div class="ss" slot="body">
        <p>Todos</p>
      </div>
    </SectionContainer>
  </div>
</Layout>

<script>
  import { $id } from "@/utils/selectElementsDom";

  document.addEventListener("astro:page-load", () => {
    const btnAddBro = $id("btn-add-bro");

    if (!btnAddBro) return;
    btnAddBro.addEventListener("click", () => {
      const commId = btnAddBro.dataset.commId;
      if (!commId) return;
      (window as any).openBrotherchModal(commId);
    });
  });
</script>
