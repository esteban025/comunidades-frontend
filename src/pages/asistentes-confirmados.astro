---
import Layout from "@/layouts/Layout.astro";
import NavbarPage from "@/components/NavbarPage.astro";
import {
  getConvivenciasForDashboard,
  getConfirmedBrothersByConvivencia,
} from "@/services/convivencias";
import { groupMarriagesForAttendance } from "@/utils/marriageGrouping";
import { calculateAttendanceTotals } from "@/utils/attendanceTotals";

const { convivencias } = await getConvivenciasForDashboard();

const url = new URL(Astro.request.url);
const convivenciaIdParam = url.searchParams.get("convivenciaId");

let currentConv = convivencias[0] ?? null;

if (convivenciaIdParam) {
  const idNum = Number(convivenciaIdParam);
  const found = convivencias.find((c: any) => c.id === idNum);
  if (found) {
    currentConv = found;
  }
}

const confirmedBrothers = currentConv
  ? await getConfirmedBrothersByConvivencia(currentConv.id)
  : [];

// Separar hermanos en comunidades propias de la convivencia vs invitados externos
const ownCommunityBrothers = confirmedBrothers.filter((b: any) =>
  Boolean(b.conv_community_id),
);
const invitedBrothers = confirmedBrothers.filter(
  (b: any) => !b.conv_community_id,
);

// Primero agrupamos los de comunidades propias por parroquia
// (usamos combinación de aka + name como clave)
const groupedByParishRaw = ownCommunityBrothers.reduce(
  (acc: any, brother: any) => {
    const parishKey =
      (brother.parish_aka || brother.parish_name || "").trim() ||
      brother.parish_name ||
      "Parroquia";

    if (!acc[parishKey]) {
      acc[parishKey] = [];
    }

    acc[parishKey].push(brother);
    return acc;
  },
  {} as Record<string, any[]>,
);

// Luego, dentro de cada parroquia, agrupamos matrimonios para que
// siempre aparezcan en una sola fila (Esposo y Esposa juntos).
const groupedEntries = Object.entries(groupedByParishRaw).map(
  ([parishName, brothers]) => {
    const groupedBrothers = groupMarriagesForAttendance(brothers as any[]);
    return [parishName, groupedBrothers] as [string, any[]];
  },
);

// Agrupar también matrimonios entre los invitados para mostrarlos
// en una lista separada bajo el subtítulo "Invitados".
const invitedGrouped = groupMarriagesForAttendance(invitedBrothers as any[]);

function getTipoFromCivilStatus(status?: string | null): string {
  if (!status) return "";
  if (status === "matrimonio") return "casado";
  // if (status === "soltero" || status === "soltera") return "Soltero";
  return status;
}
---

<Layout>
  <NavbarPage
    title="Sistema de Hermanos confirmados"
    description="Enlistado de hermanos que van a asitir a la convivencia"
    transition:name="navbar-page"
  >
    <a class="btn btn-primary" href="/convivencias" slot="actions"
      >Volver atras</a
    >
  </NavbarPage>
  <main
    class="max-w-5xl mx-auto mt-6 flex flex-col gap-4"
    data-convivencia-id={currentConv ? String(currentConv.id) : ""}
  >
    <header class="space-y-1">
      {
        currentConv && (
          <div class="flex flex-col items-center justify-between">
            <h1 class="text-3xl font-bold text-gray-800 text-balance">
              {currentConv.name}
            </h1>
            <span class="date text-sm text-text-muted">
              Del 12 al 14 de diciembre, 2025
            </span>
          </div>
        )
      }
      {
        !currentConv && (
          <p class="text-sm text-red-600">
            No hay ninguna convivencia activa para mostrar asistentes.
          </p>
        )
      }
    </header>

    {
      currentConv && confirmedBrothers.length === 0 && (
        <p class="text-sm text-gray-600">
          Aún no hay asistentes confirmados para esta convivencia.
        </p>
      )
    }

    {
      currentConv && confirmedBrothers.length > 0 && (
        <section class="space-y-6">
          {groupedEntries.map(([parishName, brothers]) => (
            <div class="space-y-5 print-keep-with-table">
              <header class="flex w-full pb-2 border-b-3 border-border-dark">
                <h2 class="text-xl font-semibold text-gray-800">
                  Parroquia - {parishName}
                </h2>
              </header>
              <div class="container-table">
                <table>
                  <thead>
                    <tr>
                      <th class="min">Comunidad</th>
                      <th>Nombre</th>
                      <th>Tipo</th>
                      <th>Observación</th>
                      {/* <th>Hospedaje</th> */}
                      <th class="min">N° Habit</th>
                      <th class="no-print min">Asistió</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(brothers as any[]).map((brother: any) => (
                      <tr class="border-t last:border-b-0">
                        <td class="min">{brother.community_number}</td>
                        <td>{brother.names}</td>
                        <td class="capitalize">
                          {getTipoFromCivilStatus(brother.civil_status)}
                        </td>
                        <td>{brother.observations || "-"}</td>
                        {/* <td>Seminario</td> */}
                        <td />
                        <td class="no-print min">
                          {brother.is_marriage ? (
                            <div class="relative inline-block text-left">
                              <button
                                type="button"
                                class="px-2 py-1 text-xs border border-gray-300 rounded-md text-gray-700 bg-white hover:bg-gray-50"
                                data-config-menu
                              >
                                Configurar
                              </button>
                              <div
                                class="hidden absolute right-0 mt-1 w-52 bg-white border border-gray-200 rounded-md shadow-lg z-10 p-2 space-y-1"
                                data-config-panel
                              >
                                <p class="text-xs font-medium text-gray-700 mb-1">
                                  Asistencia por cónyuge
                                </p>
                                <label class="flex items-center gap-2 text-xs text-gray-700">
                                  <input
                                    type="checkbox"
                                    class="w-4 h-4 cursor-pointer attended-checkbox"
                                    data-brother-id={brother.husband_id}
                                    checked={Boolean(brother.attended_husband)}
                                  />
                                  <span>{brother.husband_name}</span>
                                </label>
                                <label class="flex items-center gap-2 text-xs text-gray-700">
                                  <input
                                    type="checkbox"
                                    class="w-4 h-4 cursor-pointer attended-checkbox"
                                    data-brother-id={brother.wife_id}
                                    checked={Boolean(brother.attended_wife)}
                                  />
                                  <span>{brother.wife_name}</span>
                                </label>
                              </div>
                            </div>
                          ) : (
                            <input
                              type="checkbox"
                              class="w-4 h-4 cursor-pointer attended-checkbox"
                              data-brother-id={brother.brother_id}
                              checked={Boolean(brother.attended)}
                            />
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot>
                    {(() => {
                      const totals = calculateAttendanceTotals(
                        brothers as any[],
                      );
                      return (
                        <tr class="w-full">
                          <th colspan="6">
                            <div class="grid grid-cols-[1fr_2fr]">
                              <div class="flex items-center">
                                <span>TOTALES: {totals.totalPeople}</span>
                              </div>
                              <div class="flex items-center gap-6">
                                <span>
                                  Total de matrimonios: {totals.totalMarriages}
                                </span>
                                <span>
                                  Total de solteros: {totals.totalSinglesMale}
                                </span>
                                <span>
                                  Total de solteras: {totals.totalSinglesFemale}
                                </span>
                              </div>
                            </div>
                          </th>
                        </tr>
                      );
                    })()}
                  </tfoot>
                </table>
              </div>
              <div class="marcar-todos flex justify-end items-center no-print">
                <button class="btn btn-secondary">Marcar Todos</button>
              </div>
            </div>
          ))}

          {invitedGrouped.length > 0 && (
            <div class="space-y-5 print-keep-with-table">
              <header class="flex w-full pb-2 border-b-3 border-border-dark">
                <h2 class="text-xl font-semibold text-gray-800">Invitados</h2>
              </header>
              <div class="container-table">
                <table>
                  <thead>
                    <tr>
                      <th class="min">Comunidad</th>
                      <th class="truncate">Parroquia</th>
                      <th>Nombre</th>
                      <th>Tipo</th>
                      <th>Observación</th>
                      {/* <th>Hospedaje</th> */}
                      <th class="min">N° Habit</th>
                      <th class="no-print min">Asistió</th>
                    </tr>
                  </thead>
                  <tbody>
                    {invitedGrouped.map((brother: any) => (
                      <tr class="border-t last:border-b-0">
                        <td class="min">{brother.community_number}</td>
                        <td>
                          {brother.parish_aka || brother.parish_name || "-"}
                        </td>
                        <td>{brother.names}</td>
                        <td>{getTipoFromCivilStatus(brother.civil_status)}</td>
                        <td>{brother.observations || "-"}</td>
                        {/* <td>Seminario</td> */}
                        <td class="min" />
                        <td class="no-print min">
                          {brother.is_marriage ? (
                            <div class="relative inline-block text-left">
                              <button
                                type="button"
                                class="px-2 py-1 text-xs border border-gray-300 rounded-md text-gray-700 bg-white hover:bg-gray-50"
                                data-config-menu
                              >
                                Configurar
                              </button>
                              <div
                                class="hidden absolute right-0 mt-1 w-52 bg-white border border-gray-200 rounded-md shadow-lg z-10 p-2 space-y-1"
                                data-config-panel
                              >
                                <p class="text-xs font-medium text-gray-700 mb-1">
                                  Asistencia por cónyuge
                                </p>
                                <label class="flex items-center gap-2 text-xs text-gray-700">
                                  <input
                                    type="checkbox"
                                    class="w-4 h-4 cursor-pointer attended-checkbox"
                                    data-brother-id={brother.husband_id}
                                    checked={Boolean(brother.attended_husband)}
                                  />
                                  <span>{brother.husband_name}</span>
                                </label>
                                <label class="flex items-center gap-2 text-xs text-gray-700">
                                  <input
                                    type="checkbox"
                                    class="w-4 h-4 cursor-pointer attended-checkbox"
                                    data-brother-id={brother.wife_id}
                                    checked={Boolean(brother.attended_wife)}
                                  />
                                  <span>{brother.wife_name}</span>
                                </label>
                              </div>
                            </div>
                          ) : (
                            <input
                              type="checkbox"
                              class="w-4 h-4 cursor-pointer attended-checkbox"
                              data-brother-id={brother.brother_id}
                              checked={Boolean(brother.attended)}
                            />
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot>
                    {(() => {
                      const totals = calculateAttendanceTotals(
                        invitedGrouped as any[],
                      );
                      return (
                        <tr class="w-full">
                          <th colspan="2">TOTALES: {totals.totalPeople}</th>
                          <th colspan="5">
                            <div class="flex items-center gap-6">
                              <span>
                                Total de matrimonios: {totals.totalMarriages}
                              </span>
                              <span>
                                Total de solteros: {totals.totalSinglesMale}
                              </span>
                              <span>
                                Total de solteras: {totals.totalSinglesFemale}
                              </span>
                            </div>
                          </th>
                        </tr>
                      );
                    })()}
                  </tfoot>
                </table>
              </div>
            </div>
          )}

          <footer>
            <div class="flex flex-wrap gap-3 justify-end mt-4 no-print">
              <button
                type="button"
                class="px-4 py-2 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
                id="btn-print-attendees"
              >
                Imprimir
              </button>
              <button
                type="button"
                class="px-4 py-2 text-sm bg-gray-800 text-white rounded-md hover:bg-gray-700"
                id="btn-save-attended"
              >
                Guardar asistieron realmente
              </button>
              <button
                type="button"
                class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-md hover:bg-indigo-500"
                id="btn-go-cobros"
              >
                Ir a cobros
              </button>
            </div>
          </footer>
        </section>
      )
    }
  </main>
</Layout>

<style>
  @media print {
    table {
      page-break-inside: auto;
      break-inside: auto;
    }

    thead {
      display: table-header-group;
    }

    tfoot {
      display: table-footer-group;
    }

    tr {
      page-break-inside: avoid;
      break-inside: avoid;
      page-break-after: auto;
    }

    .container-table {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .print-keep-with-table {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .print-keep-with-table > header {
      break-after: avoid;
      page-break-after: avoid;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("main");
    if (!main) return;

    const saveBtn = document.getElementById(
      "btn-save-attended",
    ) as HTMLButtonElement | null;
    const printBtn = document.getElementById(
      "btn-print-attendees",
    ) as HTMLButtonElement | null;
    const cobrosBtn = document.getElementById(
      "btn-go-cobros",
    ) as HTMLButtonElement | null;

    const convivenciaId = main.getAttribute("data-convivencia-id") ?? "";

    const markAllButtons = document.querySelectorAll(
      ".marcar-todos button",
    ) as NodeListOf<HTMLButtonElement>;

    markAllButtons.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        const container = btn.closest(".space-y-5");
        if (!container) return;

        const checkboxes = container.querySelectorAll(
          ".attended-checkbox",
        ) as NodeListOf<HTMLInputElement>;

        checkboxes.forEach((cb) => {
          cb.checked = true;
        });
      });
    });

    // Lógica para los botones "Configurar" de matrimonios
    const configButtons = document.querySelectorAll(
      "[data-config-menu]",
    ) as NodeListOf<HTMLButtonElement>;
    const configPanels = document.querySelectorAll(
      "[data-config-panel]",
    ) as NodeListOf<HTMLElement>;

    const closeAllConfigPanels = () => {
      configPanels.forEach((panel) => panel.classList.add("hidden"));
    };

    configButtons.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();

        const container = btn.parentElement as HTMLElement | null;
        if (!container) return;

        const panel = container.querySelector(
          "[data-config-panel]",
        ) as HTMLElement | null;
        if (!panel) return;

        const isHidden = panel.classList.contains("hidden");
        closeAllConfigPanels();
        if (isHidden) {
          panel.classList.remove("hidden");
        }
      });
    });

    // Cerrar paneles al hacer clic fuera
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      // Si el clic no está dentro de un menú de configuración, cerramos todos
      const insideConfig = target.closest(
        "[data-config-menu], [data-config-panel]",
      );
      if (!insideConfig) {
        closeAllConfigPanels();
      }
    });

    if (printBtn) {
      printBtn.addEventListener("click", () => {
        window.print();
      });
    }

    if (cobrosBtn) {
      cobrosBtn.addEventListener("click", () => {
        if (!convivenciaId) {
          alert("No se pudo determinar la convivencia actual.");
          return;
        }
        window.location.href = `/cobros?convivenciaId=${convivenciaId}`;
      });
    }

    if (!saveBtn) return;

    saveBtn.addEventListener("click", async () => {
      if (!convivenciaId) {
        alert("No se pudo determinar la convivencia actual.");
        return;
      }

      const checkboxes = document.querySelectorAll(
        ".attended-checkbox",
      ) as NodeListOf<HTMLInputElement>;

      const attendedIds: number[] = [];
      const notAttendedIds: number[] = [];

      checkboxes.forEach((cb) => {
        const idAttr = cb.getAttribute("data-brother-id");
        if (!idAttr) return;
        const id = Number(idAttr);
        if (Number.isNaN(id)) return;

        if (cb.checked) {
          attendedIds.push(id);
        } else {
          notAttendedIds.push(id);
        }
      });

      saveBtn.disabled = true;
      const originalText =
        saveBtn.textContent || "Guardar asistieron realmente";
      saveBtn.textContent = "Guardando...";

      try {
        const res = await fetch(`/api/convivencias/${convivenciaId}/attended`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            attended_ids: attendedIds,
            not_attended_ids: notAttendedIds,
          }),
        });

        if (!res.ok) {
          console.error("Error al guardar asistencia real", await res.text());
          alert("Ocurrió un error al guardar los cambios.");
          saveBtn.disabled = false;
          saveBtn.textContent = originalText;
          return;
        }

        saveBtn.textContent = "Guardado";
        setTimeout(() => {
          saveBtn.disabled = false;
          saveBtn.textContent = originalText;
        }, 1000);
      } catch (error) {
        console.error("Error de red al guardar asistencia real", error);
        alert("Error de red al guardar asistencia.");
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  });
</script>
