---
import Layout from "@/layouts/Layout.astro";
import NavbarPage from "@/components/NavbarPage.astro";
import {
  getConvivenciasForDashboard,
  getConfirmedBrothersByConvivencia,
} from "@/services/convivencias";

const { convivencias } = await getConvivenciasForDashboard();

const url = new URL(Astro.request.url);
const convivenciaIdParam = url.searchParams.get("convivenciaId");

let currentConv = convivencias[0] ?? null;

if (convivenciaIdParam) {
  const idNum = Number(convivenciaIdParam);
  const found = convivencias.find((c: any) => c.id === idNum);
  if (found) {
    currentConv = found;
  }
}

const confirmedBrothers = currentConv
  ? await getConfirmedBrothersByConvivencia(currentConv.id)
  : [];

// Agrupar por parroquia (usamos combinación de aka + name como clave)
const groupedByParish = confirmedBrothers.reduce(
  (acc: any, brother: any) => {
    const parishKey =
      (brother.parish_aka || brother.parish_name || "").trim() ||
      brother.parish_name ||
      "Parroquia";

    if (!acc[parishKey]) {
      acc[parishKey] = [];
    }

    acc[parishKey].push(brother);
    return acc;
  },
  {} as Record<string, any[]>,
);

const groupedEntries = Object.entries(groupedByParish) as [string, any[]][];

function getTipoFromCivilStatus(status?: string | null): string {
  if (!status) return "";
  if (status === "matrimonio") return "Casado";
  if (status === "soltero" || status === "soltera") return "Soltero";
  return status;
}
---

<Layout>
  <NavbarPage
    title="Sistema de Hermanos confirmados"
    description="Enlistado de hermanos que van a asitir a la convivencia"
    transition:name="navbar-page"
  >
    <a class="btn btn-primary" href="/convivencias" slot="actions"
      >Volver atras</a
    >
  </NavbarPage>
  <main
    class="max-w-5xl mx-auto mt-6 flex flex-col gap-4"
    data-convivencia-id={currentConv ? String(currentConv.id) : ""}
  >
    <header class="space-y-1">
      {
        currentConv && (
          <div class="flex flex-col items-center justify-between">
            <h1 class="text-3xl font-bold text-gray-800 text-balance">
              {currentConv.name}
            </h1>
            <span class="date text-sm text-text-muted">
              Del 12 al 14 de diciembre, 2025
            </span>
          </div>
        )
      }
      {
        !currentConv && (
          <p class="text-sm text-red-600">
            No hay ninguna convivencia activa para mostrar asistentes.
          </p>
        )
      }
    </header>

    {
      currentConv && confirmedBrothers.length === 0 && (
        <p class="text-sm text-gray-600">
          Aún no hay asistentes confirmados para esta convivencia.
        </p>
      )
    }

    {
      currentConv && confirmedBrothers.length > 0 && (
        <section class="space-y-6">
          {groupedEntries.map(([parishName, brothers]) => (
            <div class="space-y-5">
              <header class="flex w-full pb-2 border-b-3 border-border-dark">
                <h2 class="text-xl font-semibold text-gray-800">
                  Parroquia - {parishName}
                </h2>
              </header>
              <div class="container-table">
                <table>
                  <thead>
                    <tr>
                      <th>Comunidad</th>
                      <th>Nombre</th>
                      <th>Tipo</th>
                      <th>Observación</th>
                      <th>Hospedaje</th>
                      <th class="no-print">Asistió</th>
                    </tr>
                  </thead>
                  <tbody>
                    {brothers.map((brother: any) => (
                      <tr class="border-t last:border-b-0">
                        <td>{brother.community_number}</td>
                        <td>{brother.names}</td>
                        <td>{getTipoFromCivilStatus(brother.civil_status)}</td>
                        <td>{brother.observations || "-"}</td>
                        <td>Seminario</td>
                        <td class="no-print">
                          <input
                            type="checkbox"
                            class="w-4 h-4 cursor-pointer attended-checkbox"
                            data-brother-id={brother.brother_id}
                            checked={Boolean(brother.attended)}
                          />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="marcar-todos flex justify-end items-center no-print">
                <button class="btn btn-tertiary">Marcar Todos</button>
              </div>
            </div>
          ))}

          <div class="flex flex-wrap gap-3 justify-end mt-4 no-print">
            <button
              type="button"
              class="px-4 py-2 text-sm border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50"
              id="btn-print-attendees"
            >
              Imprimir
            </button>
            <button
              type="button"
              class="px-4 py-2 text-sm bg-gray-800 text-white rounded-md hover:bg-gray-700"
              id="btn-save-attended"
            >
              Guardar asistieron realmente
            </button>
            <button
              type="button"
              class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-md hover:bg-indigo-500"
              id="btn-go-cobros"
            >
              Ir a cobros
            </button>
          </div>
        </section>
      )
    }
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector("main");
    if (!main) return;

    const saveBtn = document.getElementById(
      "btn-save-attended",
    ) as HTMLButtonElement | null;
    const printBtn = document.getElementById(
      "btn-print-attendees",
    ) as HTMLButtonElement | null;
    const cobrosBtn = document.getElementById(
      "btn-go-cobros",
    ) as HTMLButtonElement | null;

    const convivenciaId = main.getAttribute("data-convivencia-id") ?? "";

    const markAllButtons = document.querySelectorAll(
      ".marcar-todos button",
    ) as NodeListOf<HTMLButtonElement>;

    markAllButtons.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        const container = btn.closest(".space-y-5");
        if (!container) return;

        const checkboxes = container.querySelectorAll(
          ".attended-checkbox",
        ) as NodeListOf<HTMLInputElement>;

        checkboxes.forEach((cb) => {
          cb.checked = true;
        });
      });
    });

    if (printBtn) {
      printBtn.addEventListener("click", () => {
        window.print();
      });
    }

    if (cobrosBtn) {
      cobrosBtn.addEventListener("click", () => {
        if (!convivenciaId) {
          alert("No se pudo determinar la convivencia actual.");
          return;
        }
        window.location.href = `/cobros?convivenciaId=${convivenciaId}`;
      });
    }

    if (!saveBtn) return;

    saveBtn.addEventListener("click", async () => {
      if (!convivenciaId) {
        alert("No se pudo determinar la convivencia actual.");
        return;
      }

      const checkboxes = document.querySelectorAll(
        ".attended-checkbox",
      ) as NodeListOf<HTMLInputElement>;

      const attendedIds: number[] = [];
      const notAttendedIds: number[] = [];

      checkboxes.forEach((cb) => {
        const idAttr = cb.getAttribute("data-brother-id");
        if (!idAttr) return;
        const id = Number(idAttr);
        if (cb.checked) {
          attendedIds.push(id);
        } else {
          notAttendedIds.push(id);
        }
      });

      saveBtn.disabled = true;
      const originalText =
        saveBtn.textContent || "Guardar asistieron realmente";
      saveBtn.textContent = "Guardando...";

      try {
        const res = await fetch(`/api/convivencias/${convivenciaId}/attended`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            attended_ids: attendedIds,
            not_attended_ids: notAttendedIds,
          }),
        });

        if (!res.ok) {
          console.error("Error al guardar asistencia real", await res.text());
          alert("Ocurrió un error al guardar los cambios.");
          saveBtn.disabled = false;
          saveBtn.textContent = originalText;
          return;
        }

        saveBtn.textContent = "Guardado";
        setTimeout(() => {
          saveBtn.disabled = false;
          saveBtn.textContent = originalText;
        }, 1000);
      } catch (error) {
        console.error("Error de red al guardar asistencia real", error);
        alert("Error de red al guardar asistencia.");
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  });
</script>
