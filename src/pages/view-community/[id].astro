---
import CommunityDetailsContent from "@/components/CommunityDetailsContent.astro";
import {
  getDataGroupResponsables,
  getCommunityById,
} from "@/services/communities";
// import type { CommunityRolesGroup } from "@/services/communities";

const { id } = Astro.params;

if (!id) {
  return new Response(JSON.stringify({ error: "ID no proporcionado" }), {
    status: 400,
    headers: { "Content-Type": "application/json" },
  });
}
let community;
let error = null;

try {
  // informacion basica de la comunidad
  const dataCommunity = await getCommunityById(id);
  const communityss = await getDataGroupResponsables(id);

  community = { ...dataCommunity[0], ...communityss };
  console.log(community);
} catch (e) {
  console.error("Error en /view-community/[id]:", e);
  error = "Error al cargar los datos";
}
---

<!-- en primera instancia estaba comprobando si hay informacion ? la enviamos : null -->{
  error ? (
    <div class="error-message text-center py-8 text-red-600">
      <p class="font-semibold">{error}</p>
      <p class="text-sm mt-2">Por favor, intenta nuevamente</p>
    </div>
  ) : (
    <CommunityDetailsContent community={community} />
  )
}
