---
// SERVICES
import { getParishById } from "@/services/parishes";
import Layout from "@/layouts/Layout.astro";
import { getCommunitiesWithPrimaryResponsableByParishId } from "@/services/communities";
import type { Parish } from "@/types/parishes";

const { id } = Astro.params;

let parishData: Parish | null = null;
let communities: import("@/services/communities").CommunityWithResponsable[] =
  [];
let error = false;

const parishId = id ? Number(id) : NaN;

if (!id || Number.isNaN(parishId)) {
  error = true;
} else {
  try {
    // 1. Obtener la parroquia por id
    const parishRows = await getParishById(parishId);

    if (parishRows && parishRows.length > 0) {
      parishData = parishRows[0];

      // 2. Obtener comunidades + responsable principal (helper compartido)
      communities = await getCommunitiesWithPrimaryResponsableByParishId(
        parishData.id,
      );
    } else {
      error = true;
    }
  } catch (e) {
    console.error("Error obteniendo datos de parroquia:", e);
    error = true;
  }
}
---

<Layout>
  <main class="max-w-5xl mx-auto px-8 py-10">
    <header class="border-b border-gray-200 pb-6 mb-6">
      <h1 class="text-2xl font-semibold tracking-tight text-center uppercase">
        Comunidades parroquia {parishData?.name ?? "No registrado"}
      </h1>
      <p class="mt-2 text-sm text-gray-600 text-center">
        Actualizado a DIC, 2025
      </p>
    </header>

    {
      error ? (
        <div class="text-center py-10 text-red-700">
          <p class="font-semibold">Error al cargar los datos</p>
          <p class="text-sm mt-2">Por favor, intenta nuevamente</p>
        </div>
      ) : (
        <section class="mt-6">
          <div class="container-table">
            <table transition:name={`table-${parishData?.id}`}>
              <thead>
                <tr>
                  <th class="min">N°Com</th>
                  <th>Responsables</th>
                  <th class="no-print">Paso</th>
                </tr>
              </thead>
              <tbody>
                {communities.map((c) => (
                  <tr>
                    <td>{c.number_community}</td>
                    <td class="uppercase">
                      {c.responsable || "Responsable no registrado"}
                    </td>
                    <td class="no-print">
                      {c.level_paso || "Sin especificar"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {communities.length === 0 && (
            <p class="text-sm text-gray-600 mt-4">
              No hay comunidades registradas en esta parroquia.
            </p>
          )}
        </section>
      )
    }
  </main>
</Layout>
